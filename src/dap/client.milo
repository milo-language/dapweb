// Robust DAP client: one parsed message at a time, routed by `type`.
//
// DAP interleaves three message kinds on the same stream — request responses,
// unsolicited events (stopped, output, terminated), and reverse requests. A
// correct client never assumes how many frames a command produces: it reads
// until the response whose `request_seq` matches, dispatching every event it
// passes on the way. That makes ordering (e.g. the `initialized` event arriving
// before or after the `initialize` response) a non-issue.

from "std/process" import {
    Child
}
from "std/io" import {
    OwnedFd, FdReader
}
from "std/net" import {
    TcpStream, resolve
}
from "std/json" import {
    Json
}
from "json-rpc/frame" import {
    readFrameWith, frameErrorMessage, FrameError
}
from "protocol" import {
    writeFrame
}

// A decoded DAP message. Unused fields for a given kind stay at their defaults.
pub struct DapMsg {
    kind: string, // "response" | "event" | "request"
    seq: i64,
    requestSeq: i64, // responses: the seq of the request this answers
    command: string, // responses: the command echoed back
    event: string, // events: the event name
    success: bool, // responses: did the request succeed
    raw: string, // full JSON text, for callers that forward it verbatim
    // The one parse of `raw`. Every field reader downstream walks this with the
    // cursor API; re-parsing raw per field cost up to 6 parses per stop event.
    doc: Json,
}

// The adapter end of a session: a spawned adapter (a Child we own and reap) or a
// socket to a TCP adapter, with no process of ours behind it. Either way the session
// talks through two owned handles: the child's stdin and stdout pipes, taken from
// the Child, or two dups of the one socket (the TcpStream itself is dropped once
// they exist). Dropping a handle is its close, so no number outlives its owner.
pub struct DapConn {
    child: Option<Child>,
    // None once closed: dropping the write end is what sends the adapter EOF.
    inp: Option<OwnedFd>,
    out: Option<OwnedFd>,
}

impl DapConn {
    fn spawned(c: Child): DapConn {
        var cc = c
        let inp = cc.takeStdin()
        let out = cc.takeStdout()
        return DapConn {
            child: Option.Some(cc), inp: Option.Some(inp), out: Option.Some(out)
        }
    }

    fn connected(s: TcpStream): Result<DapConn, string> {
        let Result.Ok(inp) = OwnedFd.dup(s) else {
            return Result.Err("dup of the adapter socket failed")
        }
        let Result.Ok(out) = OwnedFd.dup(s) else {
            return Result.Err("dup of the adapter socket failed")
        }
        return Result.Ok(DapConn {
            child: Option.None, inp: Option.Some(inp), out: Option.Some(out)
        })
    }

    fn pid(self: &Self): i32 {
        if let Option.Some(c) = self.child {
            return c.pid()
        }
        return -1
    }

    // A second write handle on the adapter's input, for a task that sends requests
    // while this conn's owner reads. The adapter sees EOF only once it is dropped too.
    fn dupIn(self: &Self): Option<OwnedFd> {
        if let Option.Some(w) = self.inp {
            if let Result.Ok(d) = OwnedFd.dup(w) {
                return Option.Some(d)
            }
        }
        return Option.None
    }

    // Frame and send one message; < 0 on failure (see writeFrame).
    fn write(self: &Self, payload: &string): i64 {
        if let Option.Some(w) = self.inp {
            return writeFrame(w, payload)
        }
        return -1
    }

    fn read(self: &Self): Result<string, FrameError> {
        if let Option.Some(r) = self.out {
            return readFrameWith(FdReader.attach(r))
        }
        return Result.Err(FrameError.Eof)
    }

    // None for a TCP adapter, which has no stderr. Child is Copy, so each &mut
    // method works on a copy and stores it back.
    fn takeStderr(self: &mut Self): Option<OwnedFd> {
        if let Option.Some(c) = self.child {
            var cc = c
            let fd = cc.takeStderr()
            self.child = Option.Some(cc)
            return Option.Some(fd)
        }
        return Option.None
    }

    // Idempotent, like Child.close.
    fn close(self: &mut Self): void {
        self.inp = Option.None
        self.out = Option.None
        if let Option.Some(c) = self.child {
            var cc = c
            cc.close()
            self.child = Option.Some(cc)
        }
    }

    fn wait(self: &Self): Result<i32> {
        if let Option.Some(c) = self.child {
            return c.wait()
        }
        return Result.Err("no spawned adapter to wait for")
    }
}

pub struct DapClient {
    child: DapConn,
    seq: i64,
}

// Decode a raw JSON frame into a DapMsg.
fn _decode(raw: string): Result<DapMsg> {
    let doc = Json.parse(raw)?
    let root = doc.curRoot()
    let msg = DapMsg {
        kind: doc.curStr(doc.curField(root, "type")) ?? "",
        seq: doc.curInt(doc.curField(root, "seq")) ?? 0,
        requestSeq: doc.curInt(doc.curField(root, "request_seq")) ?? -1,
        command: doc.curStr(doc.curField(root, "command")) ?? "",
        event: doc.curStr(doc.curField(root, "event")) ?? "",
        success: doc.curBool(doc.curField(root, "success")) ?? false,
        raw: raw,
        doc: doc,
    }
    return Result.Ok(msg)
}

impl DapClient {
    // Spawn an adapter that needs argv (e.g. `python3 -m debugpy.adapter`).
    // mergeStderr=false: keep the adapter's stderr OFF the DAP stdout stream — a
    // crashing adapter (missing module, bad flag) prints a traceback there, and
    // merging it would corrupt Content-Length framing AND bury the diagnostic. The
    // caller must drain stderrFd (server pumps it) or the child deadlocks on a full
    // pipe; the captured text is surfaced if the adapter dies before the handshake.
    fn startArgs(program: &string, args: Vec<string>): Result<DapClient> {
        let child = DapConn.spawned(Child.spawn(program, args, false)?)
        return Result.Ok(DapClient {
            child: child, seq: 0
        }
        )
    }

    // Connect to an already-listening DAP adapter over TCP (e.g. `dlv dap
    // --listen=host:port`, or a js-debug server) — the user runs the server, we
    // just attach. The socket is bidirectional, so its DapConn's in and out are
    // two dups of it; every downstream path (writes, recv, the server's
    // proc.dapIn) then works as for a spawned adapter.
    // pid -1 marks "no spawned process": nothing to reap on teardown.
    fn startTcp(host: &string, port: i64): Result<DapClient> {
        let Result.Ok(ip) = resolve(host) else {
            return Result.Err("cannot resolve DAP host: " + host.clone())
        }
        let Result.Ok(s) = TcpStream.connect(ip, port as u16) else {
            return Result.Err("cannot connect to DAP adapter at " + host.clone() + ":" + port.toString())
        }
        let child = DapConn.connected(s)?
        return Result.Ok(DapClient {
            child: child, seq: 0
        }
        )
    }

    // Even seqs only: the web server's WS-reader task sends requests to the
    // same adapter with odd seqs, so the two writers can never collide on a seq.
    fn _nextSeq(self: &mut Self): i64 {
        self.seq = self.seq + 2
        return self.seq
    }

    // Reply to a reverse request (e.g. runInTerminal) from the adapter.
    fn respond(self: &mut Self, requestSeq: i64, command: &string, bodyJson: &string): void {
        let s = self._nextSeq()
        let payload = Json.obj().int("seq", s).str("type", "response")
            .int("request_seq", requestSeq).bool("success", true)
            .str("command", command).raw("body", bodyJson).build()
        let _w = self.child.write(payload)
    }

    // Frame and send a request. Returns the seq assigned, for response matching.
    fn send(self: &mut Self, command: &string, argsJson: &string): i64 {
        let s = self._nextSeq()
        let payload = Json.obj().int("seq", s).str("type", "request")
            .str("command", command).raw("arguments", argsJson).build()
        let w = self.child.write(payload)
        if w < 0 {
            return -1
        }
        return s
    }

    // Read and decode exactly one message off the adapter (blocking).
    //
    // Every framing failure is terminal for this stream — the peer is gone, or
    // framing desynced and the next read is no longer at a frame boundary — so
    // they all collapse to one Err here. What changed is that the text now says
    // WHICH happened; the old hand-rolled framing reported a clean adapter exit
    // and a corrupt header with the same "eof or bad header".
    fn recv(self: &Self): Result<DapMsg> {
        match self.child.read() {
            Result.Ok(raw) => {
                return _decode(raw)
            }
            Result.Err(e) => {
                return Result.Err(frameErrorMessage(e))
            }
        }
    }

    // Send a request and pump messages until its response arrives, printing any
    // events encountered along the way. Returns the matching response.
    fn request(self: &mut Self, command: &string, argsJson: &string): Result<DapMsg> {
        let want = self.send(command, argsJson)
        if want < 0 {
            return Result.Err("send failed")
        }
        while true {
            let msg = self.recv()?
            if msg.kind == "event" {
                print($"[event] {msg.event}")
            } else if msg.kind == "response" && msg.requestSeq == want {
                return Result.Ok(msg)
            }
            // Other responses / reverse requests are ignored for now.
        }
        return Result.Err("unreachable")
    }

    fn close(self: &mut Self): void {
        let disc: string = "{}"
        let _d = self.send("disconnect", disc)
        self.child.close()
        // TCP adapter (pid -1): nothing to reap — and waitpid(-1) is
        // "wait for ANY child", which blocks the whole scheduler thread when
        // some other child (a spawned js-debug server) is still alive.
        if self.child.pid() > 0 {
            let _s = self.child.wait()
        }
    }
}
