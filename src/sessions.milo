// The live-session registry: one JSON descriptor per running `dapweb web`.
//
// One server process hosts exactly one debug session, so the server IS the
// session's identity. Each drops a descriptor here at startup and removes it at
// exit; anything that wants to know what else is running reads the directory and
// prunes descriptors whose pid is gone, because a signal-killed server never gets
// to clean up after itself.
//
// This module exists because the writer (web/server) and the readers (api list,
// the /sessions dashboard) each had their own copy of the directory path and the
// XDG fallback. Two copies of a path that must agree is a drift waiting to
// happen: the day one of them starts honouring a new env var, the other silently
// reads an empty registry and reports "no live sessions".

from "std/os" import {
    kill, usleep
}
from "std/net" import {
    TcpListener
}
from "std/process" import {
    Command, exePath
}
from "std/fs" import {
    readDir, removeFile, mkdir
}
from "std/io" import {
    readFile, writeFile
}
from "std/json" import {
    Json
}
from "std/env" import {
    Env
}

pub struct SessionRow {
    id: string,
    pid: i64,
    port: i64,
    program: string,
    adapter: string,
    startedAt: i64,
    alive: bool,
}

// XDG_STATE_HOME or ~/.local/state — the same root the command history uses.
pub fn stateDir(): string {
    if let Option.Some(x) = Env.get("XDG_STATE_HOME") {
        if x.len > 0 {
            return x + "/dapweb"
        }
    }
    return Env.getOr("HOME", "") + "/.local/state/dapweb"
}

pub fn sessionsDir(): string {
    return stateDir() + "/sessions"
}

pub fn sessionFilePath(id: &string): string {
    return sessionsDir() + "/" + id + ".json"
}

// mkdir -p: create each ancestor in turn, ignoring already-exists errors (0755).
fn ensureDir(path: &string): void {
    var i: i64 = 1
    while i <= path.len {
        if i == path.len || path[i] == '/' {
            let _r = mkdir(path.substr(0, i), 493)
        }
        i = i + 1
    }
}

pub fn writeSession(id: &string, pid: i64, port: i64, program: &string, adapter: &string, startedAt: i64): void {
    ensureDir(sessionsDir())
    let doc = Json.obj()
        .str("id", id.clone())
        .int("pid", pid)
        .int("port", port)
        .str("program", program.clone())
        .str("adapter", adapter.clone())
        .int("startedAt", startedAt)
        .build()
    match writeFile(sessionFilePath(id), doc) {
        Result.Ok(_n) => {
        }
        Result.Err(_e) => {
        }
    }
}

pub fn removeSession(id: &string): void {
    match removeFile(sessionFilePath(id)) {
        Result.Ok(_x) => {
        }
        Result.Err(_e) => {
        }
    }
}

// Read the registry, probing each pid with kill(pid, 0). `prune` deletes the
// descriptors of servers that are gone, which is the only GC this registry has.
pub fn loadSessions(prune: bool): Vec<SessionRow> {
    // No registry dir yet (nothing has ever run) is not an error — it means no
    // sessions.
    let Result.Ok(entries) = readDir(sessionsDir()) else {
        return []
    }
    var rows: Vec<SessionRow> = []
    for ent in entries {
        if !ent.name.endsWith(".json") {
            continue
        }
        let path = sessionsDir() + "/" + ent.name
        let text = match readFile(path) {
            Result.Ok(t) => {
                t
            }
            Result.Err(_e) => {
                continue
            }
        }
        let doc = match Json.parse(text) {
            Result.Ok(d) => {
                d
            }
            Result.Err(_e) => {
                continue
            }
        }
        let pid = doc.i64("pid") ?? (0 as i64)
        // kill(pid, 0): 0 ⇒ alive, -1/ESRCH ⇒ gone. No signal is delivered.
        let alive = pid > 0 && kill(pid as i32, 0) == 0
        if !alive && prune {
            let _r = removeFile(path)
            continue
        }
        rows.push(SessionRow {
            id: doc.str("id") ?? "",
            pid: pid,
            port: doc.i64("port") ?? (0 as i64),
            program: doc.str("program") ?? "",
            adapter: doc.str("adapter") ?? "",
            startedAt: doc.i64("startedAt") ?? (0 as i64),
            alive: alive,
        }
        )
    }
    return rows
}

// What the /sessions dashboard fetches. `selfId` marks the row the caller is
// already looking at, so the page can say "this one" without the browser having
// to compare its own port against a list.
pub fn sessionsJson(selfId: &string): string {
    var arr = Json.arr()
    var n: i64 = 0
    for r in loadSessions(true) {
        arr = arr.raw(Json.obj()
            .str("id", r.id.clone())
            .int("pid", r.pid)
            .int("port", r.port)
            .str("program", r.program.clone())
            .str("adapter", r.adapter.clone())
            .int("startedAt", r.startedAt)
            .bool("self", r.id == selfId)
            .build())
        n = n + 1
    }
    return Json.obj().arr("sessions", arr).int("count", n).build()
}

// ── Session names ───────────────────────────────────────────────────────────
//
// A session id is a thing people read off a screen, type into `api --session`,
// and paste to each other in a URL. A v4 uuid is none of those: 34a36e83-f9a4-
// 4a9c-b08e-343b0c390cf9 cannot be recognised at a glance, held in your head
// for the two seconds it takes to switch windows, or read aloud at all. Three
// words can do all three.
//
// 64³ = 262144 combinations, which is not a lot — so it is not treated as one.
// newSessionName() checks the live registry and re-rolls on a collision, which
// makes uniqueness exact among the sessions that can actually be confused
// rather than merely probable.
//
// Lists are chosen for being short, common, and unambiguous when spoken: no
// homophones (no "wait"/"weight"), nothing that reads as a status word (no
// "failed", "broken"), nothing that could be read as an insult when three of
// them land next to each other.
let ADJECTIVES: [string; 64] = [
    "amber", "arctic", "bold", "brave", "brisk", "bronze", "calm", "civic",
    "clear", "coral", "cosmic", "crisp", "dapper", "deft", "dry", "eager",
    "early", "easy", "electric", "fair", "fancy", "fast", "fond", "fresh",
    "gentle", "giant", "glad", "golden", "grand", "green", "happy", "hollow",
    "honest", "ivory", "jolly", "keen", "kind", "level", "lively", "loyal",
    "lucid", "lunar", "mellow", "merry", "mighty", "mild", "modest", "neat",
    "noble", "nimble", "polar", "proud", "quick", "quiet", "rapid", "royal",
    "sharp", "silver", "smooth", "solar", "steady", "sunny", "swift", "warm",
]
let NOUNS: [string; 64] = [
    "anchor", "arrow", "atlas", "badger", "beacon", "bison", "canyon", "cedar",
    "cobalt", "comet", "compass", "cotton", "delta", "dolphin", "ember", "falcon",
    "fern", "forest", "garnet", "glacier", "harbor", "hazel", "heron", "island",
    "jasper", "juniper", "kestrel", "lagoon", "lantern", "ledger", "lily", "lynx",
    "maple", "marble", "meadow", "meteor", "mosaic", "nebula", "oak", "ocean",
    "onyx", "orbit", "otter", "pebble", "pine", "prairie", "quartz", "raven",
    "reef", "ridge", "river", "sable", "signal", "spruce", "summit", "thistle",
    "tundra", "vector", "walnut", "willow", "wombat", "yarrow", "zephyr", "zinc",
]
let VERBS: [string; 64] = [
    "adds", "aims", "asks", "bends", "binds", "builds", "calls", "carves",
    "casts", "charts", "chases", "climbs", "counts", "covers", "dives", "draws",
    "drifts", "drives", "echoes", "enters", "fills", "finds", "flies", "flows",
    "folds", "gathers", "gives", "glides", "grows", "guards", "guides", "holds",
    "hums", "joins", "jumps", "keeps", "lands", "leads", "leaps", "learns",
    "lifts", "links", "maps", "marks", "meets", "moves", "opens", "paints",
    "plans", "reads", "rides", "rings", "rises", "runs", "sails", "sends",
    "shifts", "sings", "sorts", "spins", "starts", "steers", "turns", "walks",
]

// Entropy comes from the same v4 uuid the ids used to BE — three of its hex
// digits per word. Rolling our own PRNG here would be a second source of
// randomness to reason about for no gain.
fn wordFromHex(hex: &string, at: i64): i64 {
    var acc: i64 = 0
    var i = at
    while i < at + 3 && i < hex.len {
        let c = hex[i]
        var d: i64 = 0
        if c >= '0' && c <= '9' {
            d = (c - '0') as i64
        } else if c >= 'a' && c <= 'f' {
            d = (c - 'a') as i64 + 10
        }
        acc = acc * 16 + d
        i = i + 1
    }
    return acc % 64
}

fn nameFromUuid(u: &string): string {
    // Strip the dashes so the three slices are three independent hex runs.
    var hex: string = ""
    var i: i64 = 0
    while i < u.len {
        if u[i] != '-' {
            hex = hex + u.substr(i, i + 1)
        }
        i = i + 1
    }
    return ADJECTIVES[wordFromHex(hex, 0)] + "-" + NOUNS[wordFromHex(hex, 8)] + "-" + VERBS[wordFromHex(hex, 16)]
}

// A name no LIVE session already holds. `uuids` supplies the entropy; it is a
// callback so this module does not have to depend on std/uuid's shape.
pub fn newSessionName(uuids: Vec<string>): string {
    for u in uuids {
        let name = nameFromUuid(u)
        var taken = false
        for r in loadSessions(false) {
            if r.id == name {
                taken = true
            }
        }
        if !taken {
            return name
        }
    }
    // Every candidate collided (five live sessions holding those exact names, or
    // a caller that passed nothing). Fall back to the raw uuid: ugly beats
    // ambiguous, since the id keys the registry file and the reload check.
    if uuids.len > 0 {
        return uuids[uuids.len - 1].clone()
    }
    return "session"
}

// ── Bringing a session up ───────────────────────────────────────────────────
//
// A session IS a server process, so starting one means spawning one. Both
// callers that do this — the dashboard's "new session" button and `dapweb
// start` — need the same three steps in the same order (find a port, spawn our
// own executable on it, wait for it to appear in the registry), and the registry
// is already the one thing they agree on. Keeping the steps here is what stops
// the two from drifting the way the directory path once did.

// First free port at or above `base`. Deliberately sequential rather than an
// ephemeral port: 8080 → 8081 → 8082 is a number a human can remember and type,
// which is the whole reason the dashboard exists.
//
// The listener is dropped on the way out, so the port is free by the time the
// child binds it. That is a race, and losing it costs the child its bind with a
// clear error rather than anything silent.
pub fn freePortFrom(base: i64): i64 {
    var p = base
    while p < base + 200 {
        match TcpListener.bind(p as u16) {
            Result.Ok(_l) => {
                return p
            }
            Result.Err(_e) => {
            }
        }
        p = p + 1
    }
    return 0
}

// Spawn a detached `dapweb web` on `port` with `extra` appended verbatim.
//
// It spawns OUR OWN executable and nothing else: the path comes from exePath(),
// never from a caller-supplied string. That matters less than it looks like it
// should, since a dapweb port already forwards `evaluate` to the debugger and
// can therefore run arbitrary code in the debuggee — which is why the README
// says keep these ports on loopback.
pub fn spawnSessionOn(port: i64, extra: &Vec<string>): Result<i64> {
    let Result.Ok(exe) = exePath() else {
        return Result.Err("could not resolve the dapweb executable")
    }
    // --no-browser: whoever asked for this session opens the tab themselves, on
    // their own machine. This host may not even have a browser.
    var cmd = Command.new(exe).arg("web").arg("--port").arg($"{port}").arg("--no-browser")
    for a in extra {
        cmd = cmd.arg(a.clone())
    }
    match cmd.spawn() {
        Result.Ok(child) => {
            // Deliberately not waited on: it outlives whoever started it.
            let c = child
            return Result.Ok(c.pid as i64)
        }
        Result.Err(_e) => {
            return Result.Err("could not start a new dapweb")
        }
    }
}

// Block until the session belonging to `pid` shows up in the registry, or the
// deadline passes. Polling the registry rather than the port is what makes the
// caller's answer complete: a bound socket is only a number, whereas a
// descriptor carries the session id an agent needs for `api --session` and a
// human needs to recognise the tab.
//
// Keyed on the spawned pid and NOT on the port. Asking "is something listening
// there yet" cannot tell our child apart from whoever already held the port, so
// a losing bind would be reported as a success naming a session this caller did
// not create — and then a `--port` collision looks like it worked.
pub fn awaitSessionOn(pid: i64, timeoutMs: i64): Option<SessionRow> {
    var waited: i64 = 0
    while waited < timeoutMs {
        for r in loadSessions(false) {
            if r.pid == pid && r.alive {
                return Option.Some(r.clone())
            }
        }
        unsafe {
            let _u = usleep(50000 as u32) // 50ms: fast enough to feel instant, cheap enough to spin on
        }
        waited = waited + 50
    }
    return Option.None
}
