// The outbound side of the shared session: the per-peer sinks and their
// writer tasks, the broadcaster that fans the session bus out to them, the
// messages every layer pushes, and the lifecycle log.

from "../journal" import {
    journalOut
}
from "./state" import {
    gSession, Bp, Sink, Attribution, helloMsg, sourceMsg, bpSyncMsg, dataBpsMsg
}
from "std/datetime" import {
    DateTime
}
from "std/json" import {
    Json
}
from "std/os" import {
    close
}
from "std/seal" import {
    Shared, seal
}
from "std/sync" import {
    Channel
}
from "std/ws" import {
    WsConn
}

// ── Lifecycle log ──

// One line per session event: `HH:MM:SS <event> <details>`. Event column
// padded so details align.
pub fn logEvent(event: &string, details: &string): void {
    if gSession.server.logLevel < 1 {
        return
    }
    let dt = DateTime.localNow()
    print($"{dt.formatTime()} {event.padEnd(18, " ")}{details}")
    flush()
}

pub fn peerCountStr(): string {
    if gSession.peers.count == 1 {
        return "(1 peer)"
    }
    return $"({gSession.peers.count} peers)"
}

// ── Outbound WS funnel ──

// Enqueue; a receiver parked on the channel wakes on the send. trySend so a
// stuffed channel can never block (and stall) the scheduler; drops are loud.
pub fn wsPush(ch: &Channel<string>, msg: string): void {
    if !ch.trySend(msg) {
        eprint("[srv] ws out channel full, dropping frame\n")
    }
}

// The per-peer twin of wsPush: peers are fed sealed messages, see broadcastLoop.
pub fn peerPush(ch: &Channel<Shared>, msg: Shared): void {
    if !ch.trySend(msg) {
        eprint("[srv] ws out channel full, dropping frame\n")
    }
}

// W: sole socket writer. Parks on its channel until sinkUnregister closes it,
// then drains what is left. It runs as a scoped task of R (handleDebugWs) and
// borrows R's connection: Task.scope cannot return, and so `conn` cannot close,
// until this loop has ended. The compiler holds that, not a join R must remember.
pub fn wsWriterLoop(conn: &WsConn, ch: &Channel<Shared>): void {
    // recv, not `for m in ch`: a for-in needs to own the channel, and this one is borrowed.
    while true {
        match ch.recv() {
            Result.Ok(m) => {
                let _r = conn.sendShared(m)
            }
            Result.Err(_e) => {
                break
            }
        }
    }
}

pub fn sinkRegister(id: i64, ch: &Channel<Shared>): void {
    gSession.peers.sinks.push(Sink {
        id: id, ch: ch.clone(),
    }
    )
}

// Drop the peer and close its channel, which ends its writer task once the
// queued frames are out. Removed from gSinks first, so the broadcaster can no
// longer push to the closed channel.
pub fn sinkUnregister(id: i64): void {
    var keep: Vec<Sink> = []
    for s in gSession.peers.sinks {
        if s.id == id {
            s.ch.close()
        } else {
            keep.push(Sink {
                id: s.id, ch: s.ch.clone(),
            }
            )
        }
    }
    gSession.peers.sinks = keep
}

pub fn broadcastLoop(bus: Channel<string>): void {
    var rx = bus
    for m in rx {
        // The one funnel every broadcast passes through. Per-peer late-join
        // replays go straight to their own channel and are deliberately not
        // recorded twice.
        journalOut(m)
        // Sealed once, then each peer gets a refcount clone: N peers share one
        // buffer instead of holding N copies of every frame.
        let sh = seal(m).share()
        for sink in gSession.peers.sinks {
            peerPush(sink.ch, sh.clone())
        }
    }
}

// ── Simple outbound messages ──

// A hello is a full resync — the browser drops its whole breakpoint map on
// receipt — so every hello has to be followed by the set it replaced. Only the
// connect path did that, which is why changing the target (Run with a config,
// setConfig, newSession) emptied the BREAKPOINTS panel and the gutter until a
// reload, while the server still held the bps.
pub fn pushHelloState(bus: &Channel<string>): void {
    wsPush(bus, helloMsg(gSession))
    if gSession.target.spec.srcPath.len > 0 {
        wsPush(bus, sourceMsg(gSession.target.spec.srcPath))
    }
    for bp in gSession.persisted.bps {
        wsPush(bus, bpSyncMsg(bp))
    }
    wsPush(bus, dataBpsMsg(gSession.dataBps, Option.None, 0))
}

pub fn configErrMsg(err: &string): string {
    return Json.obj().str("type", "configError").str("error", err).build()
}

// A command that was accepted but could not do what it asked (a goto the
// adapter refused). Not a configError: that one opens the target sheet.
pub fn cmdErrorMsg(c: &string, err: &string): string {
    return Json.obj().str("type", "cmdError").str("cmd", c).str("error", err).build()
}

// exitCode rides along only when the adapter reported one (-1 = unknown: killed,
// detached, or the adapter never started), so a client never shows a made-up code.
pub fn terminatedMsg(exitCode: Option<i64>): string {
    var b = Json.obj().str("type", "terminated")
    if let Option.Some(code) = exitCode {
        b = b.int("exitCode", code)
    }
    return b.build()
}

// Carries the canonical path and the full metadata, not just the line: every
// peer applies this, including ones that did not send the command. Without the
// path a receiving browser cannot key it (breakpoints are keyed by path+line),
// so an agent's breakpoint used to be invisible in an already-open tab until it
// was reloaded and picked the set up from the bpSync replay.
pub fn bpAckMsg(b: &Bp, set: bool, by: &Attribution): string {
    return Json.obj().str("type", "breakpoint")
        .str("path", b.path).int("line", b.line)
        .str("by", by.by).str("who", by.who)
        .str("condition", b.condition)
        .str("hitCondition", b.hitCondition)
        .str("logMessage", b.logMessage)
        .bool("enabled", b.enabled)
        .bool("set", set).build()
}
