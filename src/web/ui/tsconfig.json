{
  // Typechecking only — bun does the bundling. This exists because `bun build`
  // will happily emit a bundle that references an identifier nothing defines,
  // and the failure then shows up as a blank page at runtime instead of a build
  // error. `tsc --noEmit` is the gate that says so before anyone loads it.
  //
  // strict is off deliberately: the UI is not written to strict null rules and
  // turning them on now would bury the one class of error this is here to catch
  // under hundreds of pre-existing ones. Raise it when someone is ready to fix them.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
