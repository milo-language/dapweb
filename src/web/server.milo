extern fn usleep(usec: u32): i32

// NOTE: module-scope string initializers are NYI in Milo and silently produce
// "" — every one of these is assigned in main() before any request is served.
var binPath: string = ""
var gStartedAt: i64 = 0     // when this server bound its port, for the dashboard
var srcPath: string = ""
var adapterCmd: string = "" // full command line, first token resolved via PATH
var adapterKind: string = "" // dialect kind (lldb|python|node|go) — selects launch/init dialect, see Dialect registry
var stopAtMain: bool = false // per-run (set from the run cmd): break at main / first user line
var excFiltersJson: string = "" // JSON array of selected exception filter ids ("" = none)
var launchExtra: string = "" // JSON object merged verbatim into the launch/attach request
// config = a VS Code launch-configuration object. Meta keys
// (type/request/name/source/dapPath/stopAtMain/program/port/host) are extracted
// into globals; every other key lowers verbatim into launchExtra (the DAP body).
var gConfigStopAtMain: bool = false // stopAtMain persisted from config (run cmd can override)
var gRequest: string = "" // "launch" (default, incl. "") | "attach" — selects the DAP command
var gConfigName: string = "" // optional launch-config "name" label — shown in history
var gDapPathRaw: string = "" // user's explicit "dapPath" verbatim ("" = probed) — config echo only
var gDapHost: string = "" // TCP transport host (gDapPort>0); "" = stdio spawn
var gDapPort: i64 = 0 // TCP transport port; 0 = spawn adapterCmd over stdio
// js-debug support: its DAP server only listens on TCP, so the node dialect
// spawns it (`node dapDebugServer.js 0`), parses the printed port, and connects.
// gSrvPid/gSrvPort are that spawned server (0 = none this run) — the pid is
// SIGTERMed at session teardown, since closing the sockets leaves it listening.
var gSrvPid: i64 = 0
var gSrvPort: i64 = 0
// pid of a LAUNCHED debuggee, from the adapter's `process` event (0 = none/attach).
// Behind a spawned TCP adapter the debuggee is our grandchild: killing the
// adapter server orphans it instead of ending it, so teardown checks this pid.
var gDebuggeePid: i64 = 0
// Write fd of the PARENT session after a js-debug child handoff (-1 = none).
// The parent is the session that owns the launched process: a disconnect sent
// only to the child ends the debug connection and leaves the program running.
var gParentIn: i32 = -1
// js-debug runs the debuggee under a CHILD session it asks us to start (the
// startDebugging reverse request). The child's launch body arrives in that
// request and replaces our built launch args — set at handoff, "" otherwise.
var gChildLaunch: string = ""
var gChildReq: string = "" // "launch" | "attach" — the child's DAP command
// A force-run's config, applied after the old session's teardown completes
// (D's terminated cleanup consumes it; "" = rerun the current config).
var gPendingConfig: string = ""
var gPendingStopAtMain: bool = false // the force-run's per-run stopAtMain
var gHistory: string = "" // config history JSON array, newest first, cap 10 — persisted to XDG state (init "[]" in main)
var gRestored: bool = false // booted idle and staged history[0] (banner hint)
// Set when a forced run must kill+rerun (a new config can't ride a live
// adapter). D's terminated cleanup honors it by re-spawning once the old
// debuggee is gone.
var gPendingRun: bool = false

// Shared session: ONE debug session per server process, any number of WS
// peers (browser tabs + `dapweb api` callers) all seeing identical broadcast state.
// Green runtime = one OS thread, cooperative scheduling — plain globals are
// race-free at yield-point granularity (same argument as the config globals).
// All assigned in main() before any request is served (module init NYI).
var gStarted: bool = false
var gDapIn: i32 = -1
var gPtyFd: i32 = -1
var gOddSeq: i64 = -1 // +2 per R send → 1, 3, 5, … (D's DapClient uses even)
var gStdinBuf: string = "" // keystrokes typed before the pty exists
// Recent adapter stderr, captured off the DAP stream (see startArgs). Surfaced
// only when the adapter dies before the handshake completes — otherwise silence.
// Bounded to the first chunk that matters (a startup traceback); reset each run.
var gAdapterStderr: string = ""
var gCapsMsg: string = "" // last capabilities push — replayed to late joiners
var gStopMsg: string = "" // last stopped push while still stopped — replayed
var gThreadsMsg: string = "" // last threads push while stopped — replayed
var gRegionsMsg: string = "" // last memory-region push while stopped — replayed (region colors)
// recent terminal output (debugger console + program stdout/stderr),
// replayed to a joining tab so startup chatter and history survive reload /
// late join. Bounded — a non-pty adapter routes ALL program output here.
var gOutputLog: Vec<OutLine> = []
let OUTLOG_MAX: i64 = 400
var gNextClient: i64 = 1
var gBps: Vec<Bp> = [] // shared breakpoint set (was per-connection before the shared session)
// Three words, not a uuid: this id is read off a screen, typed into
// `api --session`, and pasted in a URL. See newSessionName in ../sessions.
var gSessionId: string = "" // in hello — a reloaded tab detects same-vs-new session
var gListenPort: i64 = 0    // the port we bound; the registry descriptor carries it
var gNoBrowser: bool = false
var gPeers: i64 = 0 // attached WS peers (browser tabs; `api` callers are one-shot HTTP)
var gLastActivityMs: i64 = 0 // epochMillis of the last peer event OR api call — idle-ttl clock
var gIdleTtlSecs: i64 = 0 // --idle-ttl; 0 = never reap
var gTickWr: i32 = -1 // reaper pipe write end (ticker OS thread → green task)
var gTickUsecs: i64 = 0
var webroot: string = "" // UI bundle dir served from disk (--webroot)
var Q: string = ""
// lifecycle log. 0 = --quiet (banner only), 1 = normal, 2 = --verbose
// (adds per-stop lines). Runtime events go to stdout — a server should read
// like a server; stderr stays for errors.
var gLogLevel: i64 = 0
var gRunStartMs: i64 = 0 // epochMillis at adapter spawn — run duration
var gLastExit: i64 = -1 // debuggee exitCode from the "exited" event; -1 = unknown

// A browser-set breakpoint. Keyed by (path, line); empty
// condition/hitCondition/logMessage mean a plain breakpoint — the keys are
// omitted from the DAP request.
struct Bp {
    path: string,
    line: i64,
    condition: string,
    hitCondition: string,
    logMessage: string,
    // Disabled bps stay in the list (and in bpSync) but are omitted from the
    // DAP request — DAP has no per-bp enable, absence IS disable.
    enabled: bool,
}

// one buffered terminal line for late-join replay.
struct OutLine {
    text: string,
    category: string,
}

fn cloneBp(b: &Bp): Bp {
    return Bp {
        path: b.path.clone(),
        line: b.line,
        condition: b.condition.clone(),
        hitCondition: b.hitCondition.clone(),
        logMessage: b.logMessage.clone(),
        enabled: b.enabled,
    }
}

// Breakpoints are keyed on (path, line) and lldb binds on the FULL path, so the
// one spelling that works is the absolute one the compiler recorded. A client can
// send either: the UI keys on `--source`/hello before the first stop and on the
// frame's DWARF path after it, which used to make one line two breakpoints, one of
// which never bound. Resolve against cwd rather than realpath(): clang records
// comp_dir + the argument it was given, so joining cwd reproduces it, while
// realpath() would rewrite /tmp to /private/tmp and stop matching.
// Collapse "." and ".." lexically. Two absolute paths can denote one file and
// still differ as strings (".../tests/../examples/x.c"), which would key a second
// breakpoint on a line that already has one. Lexical, not realpath(): realpath
// resolves symlinks too, which would rewrite /tmp to /private/tmp and stop
// matching what the compiler recorded in DWARF.
fn normalizePath(p: &string): string {
    var parts: Vec<string> = []
    for seg in p.split("/") {
        if seg.len == 0 || seg == "." {
            continue
        }
        if seg == ".." {
            if parts.len > 0 {
                let _d = parts.pop()
            }
            continue
        }
        parts.push(seg.clone())
    }
    var out: string = ""
    for seg in parts {
        out = out + "/" + seg
    }
    if out.len == 0 {
        return "/"
    }
    return out
}

fn absSourcePath(p: &string): string {
    if p.len == 0 {
        return p.clone()
    }
    if p[0] == '/' {
        return normalizePath(p)
    }
    var rel = p.clone()
    if rel.len > 2 && rel[0] == '.' && rel[1] == '/' {
        rel = rel.substr(2, rel.len)
    }
    // currentDir() can fail (cwd unlinked); an unresolvable relative path is
    // still better sent as-is than turned into garbage.
    if let Result.Ok(cwd) = currentDir() {
        return normalizePath(Path.join(cwd, rel))
    }
    return rel
}

fn bpPaths(bps: &Vec<Bp>, fallback: &string): Vec<string> {
    var out: Vec<string> = []
    for bp in bps {
        var seen = false
        for p in out {
            if p == bp.path {
                seen = true
            }
        }
        if !seen {
            out.push(bp.path.clone())
        }
    }
    // Always at least one setBreakpoints per session so clearing the last bp
    // live actually clears it adapter-side.
    if out.len == 0 {
        out.push(fallback.clone())
    }
    return out
}

// A request R sent whose response D must route back to the browser.
struct Pending {
    seq: i64,
    kind: string, // initialize | eval | expand | bpLive | (D-internal: launch, sbInit, st, sc, vars)
    id: i64, // browser correlation id for eval/expand
    extra: string, // initialize: the setBreakpoints args JSON built from R's list
}

// ── JSON helpers ──

fn firstThreadId(raw: &string): i64 {
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        if let Option.Some(b) = doc.get("body") {
            if let Option.Some(ts) = b.get("threads") {
                if let Option.Some(t) = ts.at(0) {
                    return t.i64("id") ?? (-1 as i64)
                }
            }
        }
    }
    return -1 as i64
}

// stackTrace body → [{"id":..,"name":..,"line":..,"path":..}] for the UI.
// path may be "" (no debug info / synthetic frame) — the UI skips navigation.
fn framesJson(raw: &string): string {
    var arr = Json.arr()
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        if let Option.Some(body) = doc.get("body") {
            if let Option.Some(framesArr) = body.get("stackFrames") {
                let n = framesArr.len()
                var i: i64 = 0
                while i < n {
                    if let Option.Some(f) = framesArr.at(i) {
                        var path: string = ""
                        if let Option.Some(src) = f.get("source") {
                            path = src.str("path") ?? ""
                        }
                        arr = arr.obj(Json.obj().int("id", f.i64("id") ?? (0 as i64)).str("name", f.str("name") ?? "?").int("line", f.i64("line") ?? (0 as i64)).str("path", path).str("ipRef", f.str("instructionPointerReference") ?? ""))
                    }
                    i = i + 1
                }
            }
        }
    }
    return arr.build()
}

// variables body → [{"name":..,"value":..,"ref":..}] (ref>0 ⇒ expandable).
// Parse `memory region --all` console text → [{s,e,p,n}] (start/end hex kept as
// strings so the client parses them; p = perms "rw-", n = segment name if lldb
// gave one, e.g. "__TEXT"/"__DATA_CONST", else ""). Line shape:
//   [0x0000000100000000-0x0000000100004000) r-x __TEXT
// The client bins each region into a type (stack/heap/code/const/data) — it
// needs sp for the stack case, which only it has.
fn regionsJson(txt: &string): string {
    var arr = Json.arr()
    let lines = txt.clone().split("\n")
    var li: i64 = 0
    while li < lines.len {
        let line = lines[li].clone().trim()
        li = li + 1
        if !line.startsWith("[0x") {
            continue
        }
        // "[0xSTART-0xEND) perms name" — a line without both delimiters is not a
        // region line, exactly as the old -1 sentinel checks treated it.
        let Option.Some(dash) = line.indexOf("-") else {
            continue
        }
        let Option.Some(close) = line.indexOf(")") else {
            continue
        }
        let start = line.substr(1, dash) // drop leading '['
        let end = line.substr(dash + 1, close)
        let rest = line.substr(close + 1, line.len).trim() // "r-x __TEXT" | "rw-" | "---"
        let toks = rest.splitWhitespace()
        if toks.len == 0 {
            continue
        }
        var name: string = ""
        if toks.len > 1 {
            name = toks[1].clone()
        }
        arr = arr.obj(Json.obj().str("s", start).str("e", end).str("p", toks[0].clone()).str("n", name))
    }
    return arr.build()
}

fn localsJson(raw: &string): string {
    var arr = Json.arr()
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        let vars = doc.curField(doc.curField(doc.curRoot(), "body"), "variables")
        let n = doc.curLen(vars)
        var i: i64 = 0
        while i < n {
            let v = doc.curChild(vars, i)
            arr = arr.obj(Json.obj().str("name", doc.curStr(doc.curField(v, "name")) ?? "?").str("value", doc.curStr(doc.curField(v, "value")) ?? "?")
            // DWARF-derived type (e.g. "int", "Node *", "double") when the
            // adapter supplies it; "" for register scopes and untyped values.
                .str("type", doc.curStr(doc.curField(v, "type")) ?? "").int("ref", doc.curInt(doc.curField(v, "variablesReference")) ?? (0 as i64)).str("mref", doc.curStr(doc.curField(v, "memoryReference")) ?? ""))
            i = i + 1
        }
    }
    return arr.build()
}

// disassemble body → [{"addr":..,"text":..,"sym":..}] for the asm pane.
fn disasmJson(raw: &string): string {
    var arr = Json.arr()
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        let insns = doc.curField(doc.curField(doc.curRoot(), "body"), "instructions")
        let n = doc.curLen(insns)
        var i: i64 = 0
        while i < n {
            let ins = doc.curChild(insns, i)
            arr = arr.obj(Json.obj().str("addr", doc.curStr(doc.curField(ins, "address")) ?? "").str("text", doc.curStr(doc.curField(ins, "instruction")) ?? "").str("sym", doc.curStr(doc.curField(ins, "symbol")) ?? "").int("line", doc.curInt(doc.curField(ins, "line")) ?? (0 as i64)))
            i = i + 1
        }
    }
    return arr.build()
}

// completions body → [{"label":..,"text":..}] (text falls back to label).
fn completionsJson(raw: &string): string {
    var arr = Json.arr()
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        let targets = doc.curField(doc.curField(doc.curRoot(), "body"), "targets")
        let n = doc.curLen(targets)
        var i: i64 = 0
        while i < n {
            let t = doc.curChild(targets, i)
            let label = doc.curStr(doc.curField(t, "label")) ?? ""
            var text = doc.curStr(doc.curField(t, "text")) ?? ""
            if text.len == 0 {
                text = label.clone()
            }
            arr = arr.obj(Json.obj().str("label", label).str("text", text))
            i = i + 1
        }
    }
    return arr.build()
}

// threads body → [{"id":..,"name":..}] for the threads panel.
fn threadsJson(raw: &string): string {
    var arr = Json.arr()
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        let threads = doc.curField(doc.curField(doc.curRoot(), "body"), "threads")
        let n = doc.curLen(threads)
        var i: i64 = 0
        while i < n {
            let t = doc.curChild(threads, i)
            arr = arr.obj(Json.obj().int("id", doc.curInt(doc.curField(t, "id")) ?? (0 as i64)).str("name", doc.curStr(doc.curField(t, "name")) ?? "?"))
            i = i + 1
        }
    }
    return arr.build()
}

// The register scope's variablesReference, or 0 if the adapter exposes none.
// lldb-dap tags it presentationHint "registers"; debugpy has no such scope, so
// a 0 here is what gates the UI's Registers panel (no register-cap flag in DAP).
fn registersScopeRef(raw: &string): i64 {
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        let scopes = doc.curField(doc.curField(doc.curRoot(), "body"), "scopes")
        let n = doc.curLen(scopes)
        var i: i64 = 0
        while i < n {
            let sc = doc.curChild(scopes, i)
            let hint = doc.curStr(doc.curField(sc, "presentationHint")) ?? ""
            let name = doc.curStr(doc.curField(sc, "name")) ?? ""
            if hint == "registers" || name == "Registers" {
                return doc.curInt(doc.curField(sc, "variablesReference")) ?? (0 as i64)
            }
            i = i + 1
        }
    }
    return 0 as i64
}

// ── Inbound browser command fields ──

// What an adapter actually said when it refused. The DAP response has two
// places for it and adapters disagree: lldb-dap puts a short line in "message",
// while its 21 series (and js-debug) leave that empty and put the real text in
// body.error.format. Reading only one of them turns a refusal into a blank.
fn respErrText(raw: &string): string {
    let m = jStr(raw, "message")
    if m.len > 0 {
        return m
    }
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        if let Option.Some(body) = doc.get("body") {
            if let Option.Some(err) = body.get("error") {
                let f = err.str("format") ?? ""
                if f.len > 0 {
                    return f
                }
            }
        }
    }
    return "the adapter refused the request and said nothing about why"
}

fn jStr(raw: &string, key: &string): string {
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        return doc.str(key) ?? ""
    }
    return ""
}

fn jBool(raw: &string, key: &string, fallback: bool): bool {
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        return doc.bool(key) ?? fallback
    }
    return fallback
}

fn jI64(raw: &string, key: &string, fallback: i64): i64 {
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        return doc.i64(key) ?? fallback
    }
    return fallback
}

// `key`'s value as raw JSON if it's an object, else "" (run's inline config).
fn jObjRaw(raw: &string, key: &string): string {
    if let Result.Ok(doc) = Json.parse(raw.clone()) {
        if let Option.Some(v) = doc.get(key) {
            if v.isObject() {
                return v.rawStr()
            }
        }
    }
    return ""
}

// ── Lifecycle log ──

// One line per session event: `HH:MM:SS <event> <details>`. Event column
// padded so details align.
fn logEvent(event: &string, details: &string): void {
    if gLogLevel < 1 {
        return
    }
    let dt = DateTime.localNow()
    print($"{dt.formatTime()} {event.padEnd(18, " ")}{details}")
    flush()
}

fn peerCountStr(): string {
    if gPeers == 1 {
        return "(1 peer)"
    }
    return $"({gPeers} peers)"
}

// ── Outbound WS funnel ──

// Enqueue and poke the writer awake via the self-pipe. trySend so a stuffed
// channel can never block (and stall) the scheduler; drops are loud.
fn wsPush(ch: &Channel<string>, wakeWr: i32, msg: string): void {
    if ch.trySend(msg) {
        var one: [u8; 1] = [110; 1]
        unsafe {
            let _n = write(wakeWr, one as *u8, 1)
        }
    } else {
        eprint("[srv] ws out channel full, dropping frame\n")
    }
}

// W: sole socket writer. Parks on the wake pipe, drains the channel.
fn wsWriterLoop(fd: i32, ch: Channel<string>, wakeRd: i32): void {
    // Borrowed copy of the conn: _closed=true so Drop skips teardown (R owns
    // the real one). sendText itself doesn't consult _closed.
    var conn = WsConn {
        fd: fd, ssl: 0, _ctx: 0, _closed: true, _isClient: false
    }
    var buf: [u8; 64] = [0; 64]
    while true {
        var n: i64 = 0
        unsafe {
            schedulerWaitRead(wakeRd)
            n = read(wakeRd, buf as *u8, 64)
        }
        if n <= 0 {
            break
        } // R closed the wake pipe: session over
        while true {
            match ch.tryRecv() {
                Option.Some(m) => {
                    let _r = conn.sendText(m)
                }
                Option.None => {
                    break
                }
            }
        }
    }
    unsafe {
        close(wakeRd)
    }
}

// one broadcaster fans the session bus out to every connected peer.
struct Sink {
    id: i64,
    ch: Channel<string>,
    wakeWr: i32,
}

// The peer registry is a plain global, not a Channel<Sink>: std/sync moves a
// payload with memcpy + memset-to-zero and lets the zeroed original drop, and
// Channel's own Drop dereferences its handle unconditionally — so a Sink (which
// owns a Channel<string>) segfaults the moment it is sent through a channel.
// Every peer task and the broadcaster are green tasks on one scheduler thread
// and none of the register/unregister/fanout sequences below contain a yield
// point, so direct mutation is exactly as atomic as the channel round-trip was.
var gSinks: Vec<Sink> = []

fn sinkRegister(id: i64, ch: &Channel<string>, wakeWr: i32): void {
    gSinks.push(Sink {
        id: id, ch: ch.clone(), wakeWr: wakeWr,
    }
    )
}

// Drop the peer and close its wake fd (EOFs its writer task). Removing it from
// gSinks first means the broadcaster can no longer name the fd, so closing here
// cannot race fd reuse against a wake poke.
fn sinkUnregister(id: i64): void {
    var keep: Vec<Sink> = []
    var wr: i32 = -1
    for s in gSinks {
        if s.id == id {
            wr = s.wakeWr
        } else {
            keep.push(Sink {
                id: s.id, ch: s.ch.clone(), wakeWr: s.wakeWr,
            }
            )
        }
    }
    gSinks = keep
    if wr >= 0 {
        unsafe {
            close(wr)
        }
    }
}

fn broadcastLoop(bus: Channel<string>, busWakeRd: i32): void {
    var buf: [u8; 64] = [0; 64]
    while true {
        var n: i64 = 0
        unsafe {
            schedulerWaitRead(busWakeRd)
            n = read(busWakeRd, buf as *u8, 64)
        }
        if n <= 0 {
            break
        }
        while true {
            match bus.tryRecv() {
                Option.Some(m) => {
                    for sink in gSinks {
                        wsPush(sink.ch, sink.wakeWr, m.clone())
                    }
                }
                Option.None => {
                    break
                }
            }
        }
    }
}

// P: pty master → browser terminal. fdChannel owns the read/EAGAIN pump; we just
// wrap each chunk and forward.
//
// This task OWNS `master` and is the only thing allowed to close it. fdChannel's
// reader parks in schedulerWaitRead(master); closing the fd from anywhere else
// leaves that reader parked on a free descriptor number, and the next pipe() to
// reuse the number gets its bytes stolen by a task from a dead session (which
// showed up as a second debug run hanging with its DAP responses vanishing into
// the previous run's stderr log).
fn ptyPumpLoop(master: i32, ch: Channel<string>, wakeWr: i32): void {
    for chunk in fdChannel(master) {
        wsPush(ch, wakeWr, Json.obj().str("type", "ptyData").str("data", chunk).build())
    }
    unsafe {
        close(master)
    }
}

// Drain the adapter's stderr so the pipe never fills (mergeStderr=false) and
// stash the head of it for the pre-handshake death diagnostic. Cap at 8 KB —
// a Python traceback / lldb-dap gripe fits; a chatty adapter can't grow it
// unbounded. Also echoed to the server log so it's visible there too.
fn adapterStderrPump(errFd: i32): void {
    for chunk in fdChannel(errFd) {
        eprint("[adapter] " + chunk)
        if gAdapterStderr.len < 8192 {
            gAdapterStderr = gAdapterStderr + chunk
        }
    }
    // Owns the fd — see ptyPumpLoop for why nobody else may close it.
    unsafe {
        close(errFd)
    }
}

// ── Simple outbound messages ──

fn helloMsg(): string {
    // `config` is THE canonical launch-config object (what the editor shows and
    // resolveConfig accepts back verbatim); program/adapterCmd ride alongside as
    // display conveniences (toolbar span, ⓘ adapter line).
    var b = Json.obj().str("type", "hello")
        .str("program", binPath.clone())
        .str("sourcePath", srcPath.clone())
        .str("adapterCmd", adapterCmd.clone())
        .str("adapterId", adapterId())
        .str("sessionId", gSessionId.clone())
        .raw("config", specConfigJson(curSpec(), true, 0 as i64))
    // late joiners need to know a session is live (kill-confirm on Run etc.);
    // a replayed stopped snapshot then refines running → stopped.
    if gStarted {
        b = b.str("phase", "running")
    }
    b = b.raw("history", gHistory.clone())
    if gRestored {
        b = b.bool("restored", true)
    }
    return b.build()
}

// full bp state for a late-joining peer (acks are optimistic client-side).
fn bpSyncMsg(b: &Bp): string {
    return Json.obj().str("type", "bpSync")
        .str("path", b.path.clone()).int("line", b.line)
        .str("condition", b.condition.clone())
        .str("hitCondition", b.hitCondition.clone())
        .str("logMessage", b.logMessage.clone())
        .bool("enabled", b.enabled)
        .build()
}

// A hello is a full resync — the browser drops its whole breakpoint map on
// receipt — so every hello has to be followed by the set it replaced. Only the
// connect path did that, which is why changing the target (Run with a config,
// setConfig, newSession) emptied the BREAKPOINTS panel and the gutter until a
// reload, while the server still held the bps.
fn pushHelloState(bus: &Channel<string>, wakeWr: i32): void {
    wsPush(bus, wakeWr, helloMsg())
    if srcPath.len > 0 {
        wsPush(bus, wakeWr, sourceMsg(srcPath))
    }
    for bp in gBps {
        wsPush(bus, wakeWr, bpSyncMsg(bp))
    }
}

fn configErrMsg(err: &string): string {
    return Json.obj().str("type", "configError").str("error", err.clone()).build()
}

fn sourceMsg(path: &string): string {
    var content: string = ""
    match readFile(path) {
        Result.Ok(text) => {
            content = text
        }
        Result.Err(_e) => {
            // Frames without debug info (libc, dyld) report symbol pseudo-paths
            // like "/usr/lib/dyld`dyld4::...". Show a friendly placeholder
            // until the disassembly view exists.
            content = "// no source available for this frame:\n//   " + path.clone()
            + "\n// (no debug info — try `disassemble --frame` in the Debug Console)"
        }
    }
    return Json.obj().str("type", "source")
        .str("path", path.clone())
        .str("content", content)
        .build()
}

fn terminatedMsg(): string {
    return Json.obj().str("type", "terminated").build()
}

// Carries the canonical path and the full metadata, not just the line: every
// peer applies this, including ones that did not send the command. Without the
// path a receiving browser cannot key it (breakpoints are keyed by path+line),
// so an agent's breakpoint used to be invisible in an already-open tab until it
// was reloaded and picked the set up from the bpSync replay.
fn bpAckMsg(b: &Bp, set: bool): string {
    return Json.obj().str("type", "breakpoint")
        .str("path", b.path.clone()).int("line", b.line)
        .str("condition", b.condition.clone())
        .str("hitCondition", b.hitCondition.clone())
        .str("logMessage", b.logMessage.clone())
        .bool("enabled", b.enabled)
        .bool("set", set).build()
}

fn outputMsg(raw: &string): string {
    // DAP category ("stdout"/"stderr"/"console"/"important"/…) lets the merged
    // terminal color program output apart from debugger chatter.
    return Json.obj().str("type", "output")
        .str("text", bodyStr(raw, "output"))
        .str("category", bodyStr(raw, "category"))
        .build()
}

// ── DAP request framing for R (odd seqs; D's DapClient uses even) ──

fn sendReqFd(fd: i32, seq: i64, command: &string, argsJson: &string): void {
    let payload = Json.obj().int("seq", seq).str("type", "request")
        .str("command", command.clone()).raw("arguments", argsJson.clone()).build()
    let _w = writeFrameFd(fd, payload)
}

// setBreakpoints args for one file (breakpoints are per-source in DAP).
fn buildBpArgsForPath(bps: &Vec<Bp>, path: &string): string {
    var arr = Json.arr()
    for bp in bps {
        if bp.path == path && bp.enabled {
            var o = Json.obj().int("line", bp.line)
            if bp.condition.len > 0 {
                o = o.str("condition", bp.condition.clone())
            }
            if bp.hitCondition.len > 0 {
                o = o.str("hitCondition", bp.hitCondition.clone())
            }
            if bp.logMessage.len > 0 {
                o = o.str("logMessage", bp.logMessage.clone())
            }
            arr = arr.obj(o)
        }
    }
    return Json.obj()
        .obj("source", Json.obj().str("path", path.clone()))
        .arr("breakpoints", arr)
        .build()
}

// Session-init bundle: [{"args": <setBreakpoints-json>}] — one entry per file
// with bps. D replays these during the initialized event (kind sbInit each).
fn buildAllBpArgs(bps: &Vec<Bp>): string {
    var arr = Json.arr()
    let paths = bpPaths(bps, srcPath)
    for path in paths {
        arr = arr.obj(Json.obj().str("args", buildBpArgsForPath(bps, path)))
    }
    return arr.build()
}

// setExceptionBreakpoints args from the selected filter ids.
fn excArgs(): string {
    var filters: string = "[]"
    if excFiltersJson.len > 0 {
        filters = excFiltersJson.clone()
    }
    return Json.obj().raw("filters", filters).build()
}

// Session config + adapter dialect + launch/init bodies live in ../dap/session
// (shared with the HTTP API path). These wrappers bind the shared, value-based fns
// to this driver's session globals.
fn adapterId(): string {
    return adapterIdForKind(adapterKind)
}

fn initArgs(): string {
    return initArgsFor(adapterKind)
}

fn launchRequest(): string {
    return launchRequestOf(curSpec())
}

// snapshot the session globals as the value the shared launch builders consume.
fn curSpec(): LaunchSpec {
    return LaunchSpec {
        binPath: binPath.clone(), srcPath: srcPath.clone(),
        adapterCmd: adapterCmd.clone(), adapterKind: adapterKind.clone(),
        launchExtra: launchExtra.clone(), stopAtMain: gConfigStopAtMain,
        request: gRequest.clone(), host: gDapHost.clone(), port: gDapPort,
        name: gConfigName.clone(), dapPath: gDapPathRaw.clone(),
    }
}

// Apply a config (VS Code launch-configuration object) into this session while
// idle: resolve to a LaunchSpec via the shared module, commit into the session
// globals, and reset per-session state. Returns "" on success or a user-facing
// error. Caller broadcasts hello/source. Running sessions stage instead (see
// setConfig handler); this must only run single-threaded on the green runtime.
fn applyConfig(raw: string, selectName: string): string {
    match resolveConfig(raw, selectName) {
        Result.Ok(spec) => {
            binPath = spec.binPath.clone()
            srcPath = absSourcePath(spec.srcPath)
            adapterCmd = spec.adapterCmd.clone()
            adapterKind = spec.adapterKind.clone()
            launchExtra = spec.launchExtra.clone()
            gConfigStopAtMain = spec.stopAtMain
            gRequest = spec.request.clone()
            gConfigName = spec.name.clone()
            gDapPathRaw = spec.dapPath.clone()
            gDapHost = spec.host.clone()
            gDapPort = spec.port
            gBps = []
            gOutputLog = []
            refreshSession()
            return ""
        }
        Result.Err(e) => {
            return e
        }
    }
}

// Gap-fill CLI flags into a --launch config object: --program/--source fill in
// when the config lacks them, so `--launch '{"args":[...]}' --program /x` still
// composes. A {version, configurations:[...]} wrapper is a self-contained
// launch.json file and passes through untouched.
fn mergeCliDefaults(text: string, prog: &string, src: &string): string {
    match Json.parseJsonc(text.clone()) {
        Result.Ok(d) => {
            if !d.isObject() {
                return text
            }
            if let Option.Some(_c) = d.get("configurations") {
                return text
            }
            var hasProg = false
            var hasSrc = false
            var b = Json.obj()
            let ks = d.keys()
            for k in ks {
                if k == "program" {
                    hasProg = true
                }
                if k == "source" {
                    hasSrc = true
                }
                match d.get(k) {
                    Option.Some(v) => {
                        b = b.raw(k.clone(), v.rawStr())
                    }
                    Option.None => {
                    }
                }
            }
            if !hasProg && prog.len > 0 {
                b = b.str("program", prog.clone())
            }
            if !hasSrc && src.len > 0 {
                b = b.str("source", src.clone())
            }
            return b.build()
        }
        Result.Err(_e) => {
            return text
        }
    }
}

// ── Config history (server-side, single-writer; §4) ──
//
// The server is the ONE writer: it appends on a successful run launch, persists
// to XDG state, and broadcasts historyChanged. Clients only read (via hello +
// the broadcast), which kills the old client-local dupe (drawer + hello both
// saved). $XDG_STATE_HOME/dapweb/history.json, default ~/.local/state/dapweb.

fn histDir(): string {
    return stateDir()
}

fn histFilePath(): string {
    return histDir() + "/history.json"
}

// mkdir -p: create each ancestor in turn, ignoring already-exists errors (0755).
fn ensureDir(path: &string): void {
    var cur: string = ""
    for ch in path {
        if ch == '/' {
            if cur.len > 0 {
                let _r = makeDir(cur.clone(), 493 as i32)
            }
            cur.push(ch)
        } else {
            cur.push(ch)
        }
    }
    if cur.len > 0 {
        let _r = makeDir(cur.clone(), 493 as i32)
    }
}

// Read history at boot. Missing/corrupt file → empty (never fatal).
fn loadHistory(): void {
    let p = histFilePath()
    if !pathExists(p) {
        gHistory = "[]"
        return
    }
    gHistory = "[]"
    if let Result.Ok(s) = readFile(p) {
        if let Result.Ok(d) = Json.parse(s.clone()) {
            if d.isArray() {
                gHistory = s
            }
        }
    }
}

// Breakpoints outlive the server process. Keyed by PROGRAM path, not the full
// history identity tuple: changing args or env does not change which lines you
// care about, so those edits must not throw your breakpoints away.
fn bpsFilePath(): string {
    return histDir() + "/breakpoints.json"
}

fn bpsJson(bps: &Vec<Bp>): string {
    var arr = Json.arr()
    for b in bps {
        arr = arr.raw(Json.obj()
            .str("path", b.path.clone()).int("line", b.line)
            .str("condition", b.condition.clone())
            .str("hitCondition", b.hitCondition.clone())
            .str("logMessage", b.logMessage.clone())
            .bool("enabled", b.enabled).build())
    }
    return arr.build()
}

// Rewrite this program's entry, leaving every other program's set intact.
fn persistBps(): void {
    if binPath.len == 0 {
        return
    }
    var out = Json.obj()
    if let Result.Ok(s2) = readFile(bpsFilePath()) {
        if let Result.Ok(doc) = Json.parse(s2) {
            if doc.isObject() {
                for k in doc.keys() {
                    if k != binPath {
                        if let Option.Some(v) = doc.get(k) {
                            out = out.raw(k.clone(), v.rawStr())
                        }
                    }
                }
            }
        }
    }
    out = out.raw(binPath.clone(), bpsJson(gBps))
    ensureDir(histDir())
    let _r = writeFile(bpsFilePath(), out.build())
}

// Load this program's saved set. Missing/corrupt file leaves gBps untouched.
fn loadBps(): void {
    if binPath.len == 0 {
        return
    }
    let f = bpsFilePath()
    if !pathExists(f) {
        return
    }
    var restored: Vec<Bp> = []
    if let Result.Ok(s2) = readFile(f) {
        if let Result.Ok(doc) = Json.parse(s2) {
            if let Option.Some(arr) = doc.get(binPath) {
                if arr.isArray() {
                    let n = arr.len()
                    var i: i64 = 0
                    while i < n {
                        if let Option.Some(e) = arr.at(i) {
                            let pth = e.str("path") ?? ""
                            let ln = e.i64("line") ?? (0 as i64)
                            if pth.len > 0 && ln > 0 {
                                restored.push(Bp {
                                    path: absSourcePath(pth), line: ln,
                                    condition: e.str("condition") ?? "",
                                    hitCondition: e.str("hitCondition") ?? "",
                                    logMessage: e.str("logMessage") ?? "",
                                    enabled: e.bool("enabled") ?? true,
                                })
                            }
                        }
                        i = i + 1
                    }
                }
            }
        }
    }
    if restored.len > 0 {
        gBps = restored
        logEvent("breakpoints", $"restored {gBps.len} for {binPath}")
    }
}

fn persistHistory(): void {
    ensureDir(histDir())
    let _r = writeFile(histFilePath(), gHistory)
}

// Append the current session config to history on a launch (dedup + cap 10),
// persist, and return the broadcast so the caller can push it to all peers.
fn appendHistory(): string {
    gHistory = histInsert(gHistory, histEntryFor(curSpec(), epochMillis()), 10 as i64)
    persistHistory()
    return historyChangedMsg()
}

fn historyChangedMsg(): string {
    return Json.obj().str("type", "historyChanged").raw("history", gHistory.clone()).build()
}

// history[0] as a re-appliable config object, or None if history is empty.
fn firstHistoryConfig(): Option<string> {
    if let Result.Ok(d) = Json.parse(gHistory.clone()) {
        if d.isArray() && d.len() > 0 {
            if let Option.Some(el) = d.at(0 as i64) {
                return Option.Some(el.rawStr())
            }
        }
    }
    return Option.None
}

// launch/init bodies + adapter argv come from the shared session module; these
// bind them to this driver's globals (stopAtMain is the per-run override).
fn launchArgs(): string {
    return launchArgsFor(curSpec(), stopAtMain)
}

fn adapterArgv(): Vec<string> {
    return adapterArgvOf(adapterCmd)
}

// ── D: the DAP-reader task ──

fn removePending(pend: &Vec<Pending>, idx: i64): Vec<Pending> {
    var keep: Vec<Pending> = []
    var i: i64 = 0
    while i < pend.len {
        if i != idx {
            keep.push(Pending {
                seq: pend[i].seq, kind: pend[i].kind.clone(),
                id: pend[i].id, extra: pend[i].extra.clone(),
            }
            )
        }
        i = i + 1
    }
    return keep
}

// runInTerminal reverse request → spawn debuggee in a std/pty, reply with the
// pid, start the pump. env vars are honored by exec'ing through /usr/bin/env
// (lldb-dap's launcher handshake rides on env vars, so dropping them breaks it).
fn handleRunInTerminal(cl: &mut DapClient, raw: &string, reqSeq: i64, ch: &Channel<string>, wakeWr: i32): i32 {
    var argv: Vec<string> = []
    var envs: Vec<string> = []
    match Json.parse(raw.clone()) {
        Result.Ok(doc) => {
            match doc.get("arguments") {
                Option.Some(a) => {
                    match a.get("args") {
                        Option.Some(arr) => {
                            let n = arr.len()
                            var i: i64 = 0
                            while i < n {
                                match arr.at(i) {
                                    Option.Some(el) => {
                                        argv.push(el.asStr() ?? "")
                                    }
                                    Option.None => {
                                    }
                                }
                                i = i + 1
                            }
                        }
                        Option.None => {
                        }
                    }
                    match a.get("env") {
                        Option.Some(env) => {
                            let keys = env.keys()
                            for key in keys {
                                let v = env.str(key) ?? ""
                                envs.push(key.clone() + "=" + v)
                            }
                        }
                        Option.None => {
                        }
                    }
                }
                Option.None => {
                }
            }
        }
        Result.Err(_e) => {
        }
    }
    if argv.len == 0 {
        return -1
    }

    var program: string = argv[0].clone()
    var args: Vec<string> = []
    if envs.len > 0 {
        program = "/usr/bin/env"
        for e in envs {
            args.push(e.clone())
        }
        for a in argv {
            args.push(a.clone())
        }
    } else {
        var i: i64 = 1
        while i < argv.len {
            args.push(argv[i].clone())
            i = i + 1
        }
    }

    match Pty.open() {
        Result.Ok(p) => {
            var pty = p
            match pty.spawn(program, args) {
                Result.Ok(pid) => {
                    logEvent("debuggee spawned", $"pid {pid}")
                    // Ours to reap: an adapter that routes the debuggee through
                    // our pty is not the process's parent and cannot be relied on
                    // to end it (js-debug's server does not).
                    gDebuggeePid = pid as i64
                    cl.respond(reqSeq, "runInTerminal", Json.obj().int("processId", pid as i64).build())
                    let master = pty.masterFd
                    // direct global set (same scheduler thread) — and flush
                    // any keystrokes typed while the adapter was launching.
                    gPtyFd = master
                    if gStdinBuf.len > 0 {
                        unsafe {
                            let _n = write(master, gStdinBuf, gStdinBuf.len)
                        }
                        gStdinBuf = ""
                    }
                    // Channel handles are refcounted: the pump task outlives this
                    // call, so it gets its own retained handle rather than ours.
                    let ptyCh = ch.clone()
                    Task.spawn(move(): void => {
                        ptyPumpLoop(master, ptyCh, wakeWr)
                    }
                    )
                    return master
                }
                Result.Err(e) => {
                    eprint($"[srv] pty spawn failed: {e}\n")
                    return -1
                }
            }
        }
        Result.Err(e) => {
            eprint($"[srv] pty open failed: {e}\n")
            return -1
        }
    }
}

// After the js-debug child handoff, the parent session matters only as an event
// source (the debuggee's stdio arrives there as output events) and as a peer
// that must not stall (reverse requests get a success reply). Session end is
// the CHILD's story — parent EOF just ends the drain, pushing nothing.
fn parentDrainLoop(client: DapClient, ch: Channel<string>, wakeWr: i32): void {
    var cl = client
    while true {
        match cl.recv() {
            Result.Ok(m) => {
                if m.kind == "event" && m.event == "output" {
                    let ocat = bodyStr(m.raw, "category")
                    if ocat != "telemetry" {
                        gOutputLog.push(OutLine {
                            text: bodyStr(m.raw, "output"), category: ocat.clone()
                        }
                        )
                        if gOutputLog.len > OUTLOG_MAX {
                            let _d = gOutputLog.remove(0)
                        }
                        wsPush(ch, wakeWr, outputMsg(m.raw))
                    }
                } else if m.kind == "request" {
                    let rc = m.command.clone()
                    if rc == "runInTerminal" {
                        // js-debug asks whichever session it launches from; an
                        // empty ack here would leave the program never started.
                        let _m = handleRunInTerminal(cl, m.raw, m.seq, ch, wakeWr)
                    } else {
                        cl.respond(m.seq, rc, "{}")
                    }
                }
            }
            Result.Err(_e) => {
                break
            }
        }
    }
    cl.child.close()
}

fn dapReaderLoop(client: DapClient, ch: Channel<string>, wakeWr: i32, pendCh: Channel<Pending>): void {
    var cl = client
    var pend: Vec<Pending> = []
    var tid: i64 = -1 as i64
    var framesJs: string = "[]"
    var stopLine: i64 = 0
    var frame0: i64 = 0
    var regRef: i64 = 0 // register scope ref for the current stop (0 = adapter has none)
    var lastSrc: string = srcPath.clone() // browser already has the main source
    var bpArgs: string = "[]" // per-file bundle from buildAllBpArgs
    var sbLeft: i64 = 0 // sbInit responses still outstanding
    var initOk = false // adapter answered `initialize` (handshake reached)

    while true {
        var msg = DapMsg {
            kind: "", seq: 0, requestSeq: -1 as i64, command: "", event: "", success: false, raw: ""
        }
        match cl.recv() {
            Result.Ok(m) => {
                msg = m
            }
            Result.Err(_e) => {
                // An adapter that dies before answering `initialize` never really
                // started (bad dapPath, missing module, crash on launch). A bare
                // "terminated" reads like a clean program exit, so surface the real
                // cause — the captured stderr — as a configError instead.
                if !initOk {
                    var em = "adapter exited before the handshake — it never started."
                    if gAdapterStderr.len > 0 {
                        em = em + "\n\n" + gAdapterStderr
                    }
                    wsPush(ch, wakeWr, configErrMsg(em))
                }
                wsPush(ch, wakeWr, terminatedMsg())
                break
            }
        }

        // Adopt R's registered pendings AFTER recv, before matching: R registers
        // before it sends (and D was parked in recv while the adapter replied),
        // so draining here guarantees the entry exists when its response lands.
        // Draining before recv instead loses any pending R registers while D is
        // parked — the response arrives unmatched and is dropped.
        while true {
            match pendCh.tryRecv() {
                Option.Some(p) => {
                    if p.kind == "initialize" {
                        bpArgs = p.extra.clone()
                    }
                    pend.push(p)
                }
                Option.None => {
                    break
                }
            }
        }

        if msg.kind == "response" {
            var idx: i64 = -1 as i64
            var i: i64 = 0
            while i < pend.len {
                if pend[i].seq == msg.requestSeq {
                    idx = i
                }
                i = i + 1
            }
            var kind: string = ""
            var pid: i64 = 0
            var pextra: string = ""
            if idx >= 0 {
                kind = pend[idx].kind.clone()
                pid = pend[idx].id
                pextra = pend[idx].extra.clone()
                pend = removePending(pend, idx)
            }

            if !msg.success {
                if kind == "eval" {
                    let emsg = respErrText(msg.raw)
                    wsPush(ch, wakeWr, Json.obj().str("type", "evalResult").int("id", pid).str("value", emsg).int("ref", 0).bool("error", true).build())
                } else if kind == "fsc" || kind == "fvars" {
                    wsPush(ch, wakeWr, Json.obj().str("type", "frameLocals").int("id", pid).raw("vars", "[]").build())
                } else if kind == "disasm" {
                    wsPush(ch, wakeWr, Json.obj().str("type", "disasm").int("id", pid).raw("instructions", "[]").build())
                } else if kind == "setv" {
                    wsPush(ch, wakeWr, Json.obj().str("type", "setVarResult").int("id", pid).str("value", respErrText(msg.raw)).int("ref", 0).bool("error", true).build())
                } else if kind == "ebInit" {
                    // Exception filters rejected — still finish configuration
                    // or the session never launches.
                    let s = cl.send("configurationDone", "{}")
                    pend.push(Pending {
                        seq: s, kind: "cfgDone", id: 0, extra: ""
                    }
                    )
                } else if kind == "cmpl" {
                    wsPush(ch, wakeWr, Json.obj().str("type", "completions").int("id", pid).raw("targets", "[]").build())
                } else if kind == "tst" {
                    var t: string = "0"
                    if pextra.len > 0 {
                        t = pextra.clone()
                    }
                    wsPush(ch, wakeWr, Json.obj().str("type", "threadStack").int("id", pid).raw("tid", t).raw("frames", "[]").build())
                } else if kind == "readmem" {
                    wsPush(ch, wakeWr, Json.obj().str("type", "memory").int("id", pid).str("address", "").str("data", "").str("error", jStr(msg.raw, "message")).build())
                } else if kind == "restartR" {
                    // Adapter without restart support (e.g. debugpy): tell the
                    // UI so it falls back to kill+rerun. lldb-dap handles
                    // restart but never advertises supportsRestartRequest, so
                    // try-then-fallback beats capability gating here.
                    wsPush(ch, wakeWr, Json.obj().str("type", "restartFailed").build())
                } else if kind == "initialize" || kind == "launch" || kind == "childLaunch" || kind == "sbInit" {
                    eprint($"[srv] {msg.command} failed: {msg.raw}\n")
                    wsPush(ch, wakeWr, terminatedMsg())
                    break
                }
            } else if kind == "initialize" {
                initOk = true
                // Forward the adapter's capabilities verbatim; the UI digs out
                // .body and gates features on it.
                gCapsMsg = Json.obj().str("type", "capabilities").str("raw", msg.raw.clone()).build()
                wsPush(ch, wakeWr, gCapsMsg.clone())
                // a js-debug child session launches with the configuration the
                // startDebugging request handed us, not our built launch args;
                // "childLaunch" so its ack doesn't re-append history.
                var lreq = launchRequest()
                var largs = launchArgs()
                var lkind: string = "launch"
                if gChildLaunch.len > 0 {
                    lreq = gChildReq.clone()
                    largs = gChildLaunch.clone()
                    lkind = "childLaunch"
                }
                let s = cl.send(lreq, largs)
                pend.push(Pending {
                    seq: s, kind: lkind, id: 0, extra: ""
                }
                )
            } else if kind == "launch" {
                // running; next signal is a stopped/terminated event.
                // Launch ack'd: this config actually ran, so record it (single
                // writer — clients never save) and tell every peer.
                wsPush(ch, wakeWr, appendHistory())
            } else if kind == "thrPause" {
                // Pause with no known tid (attach before first stop): pause
                // the first thread the adapter reports.
                let t = firstThreadId(msg.raw)
                if t >= 0 {
                    let _s = cl.send("pause", Json.obj().int("threadId", t).build())
                }
            } else if kind == "sbInit" {
                sbLeft = sbLeft - 1
                if sbLeft <= 0 {
                    let s = cl.send("setExceptionBreakpoints", excArgs())
                    pend.push(Pending {
                        seq: s, kind: "ebInit", id: 0, extra: ""
                    }
                    )
                }
            } else if kind == "ebInit" {
                let cd: string = "{}"
                let s = cl.send("configurationDone", cd)
                pend.push(Pending {
                    seq: s, kind: "cfgDone", id: 0, extra: ""
                }
                )
            } else if kind == "st" {
                framesJs = framesJson(msg.raw)
                stopLine = frame0Field(msg.raw, "line")
                frame0 = frame0Field(msg.raw, "id")
                let path = frame0Path(msg.raw)
                if path.len > 0 && path != lastSrc {
                    wsPush(ch, wakeWr, sourceMsg(path))
                    lastSrc = path
                }
                let scArgs = Json.obj().int("frameId", frame0).build()
                let s = cl.send("scopes", scArgs)
                pend.push(Pending {
                    seq: s, kind: "sc", id: 0, extra: ""
                }
                )
                // Memory map for region-coloring — lldb only (python/go repl has
                // no `memory region`). Fired alongside scopes; reply → "regions".
                if adapterKind == "lldb" {
                    let rArgs = Json.obj().str("expression", "memory region --all")
                        .str("context", "repl").int("frameId", frame0).build()
                    let rs = cl.send("evaluate", rArgs)
                    pend.push(Pending {
                        seq: rs, kind: "regions", id: 0, extra: ""
                    }
                    )
                }
            } else if kind == "sc" {
                let ref = scopes0Ref(msg.raw)
                regRef = registersScopeRef(msg.raw)
                let vArgs = Json.obj().int("variablesReference", ref).build()
                let s = cl.send("variables", vArgs)
                // scope ref rides along: setVariable needs the parent
                // container ref, and for top-level locals that's the scope.
                pend.push(Pending {
                    seq: s, kind: "vars", id: 0, extra: ref.toString()
                }
                )
            } else if kind == "vars" {
                var scopeRef: string = "0"
                if pextra.len > 0 {
                    scopeRef = pextra.clone()
                }
                gStopMsg = Json.obj().str("type", "stopped")
                    .int("line", stopLine).str("path", lastSrc.clone()).int("tid", tid)
                    .raw("scopeRef", scopeRef)
                    .int("registersRef", regRef)
                    .raw("frames", framesJs.clone())
                    .raw("locals", localsJson(msg.raw)).build()
                wsPush(ch, wakeWr, gStopMsg.clone())
            } else if kind == "regions" {
                // Cached + replayed like gStopMsg so a tab that reloads mid-stop
                // keeps its region colors instead of going grey until the next step.
                gRegionsMsg = Json.obj().str("type", "regions")
                    .raw("regions", regionsJson(bodyStr(msg.raw, "result"))).build()
                wsPush(ch, wakeWr, gRegionsMsg.clone())
            } else if kind == "eval" {
                wsPush(ch, wakeWr, Json.obj().str("type", "evalResult").int("id", pid).str("value", bodyStr(msg.raw, "result")).int("ref", bodyI64(msg.raw, "variablesReference", 0 as i64)).build())
            } else if kind == "expand" {
                wsPush(ch, wakeWr, Json.obj().str("type", "children").int("id", pid).raw("vars", localsJson(msg.raw)).build())
            } else if kind == "fsc" {
                // Frame navigation: scopes for a non-top frame the user
                // clicked; chains into fvars like the stop-time sc → vars pair.
                let ref = scopes0Ref(msg.raw)
                let vArgs = Json.obj().int("variablesReference", ref).build()
                let s = cl.send("variables", vArgs)
                pend.push(Pending {
                    seq: s, kind: "fvars", id: pid, extra: ref.toString()
                }
                )
            } else if kind == "fvars" {
                var scopeRef: string = "0"
                if pextra.len > 0 {
                    scopeRef = pextra.clone()
                }
                wsPush(ch, wakeWr, Json.obj().str("type", "frameLocals").int("id", pid).raw("scopeRef", scopeRef).raw("vars", localsJson(msg.raw)).build())
            } else if kind == "setv" {
                // setVariable: body carries the adapter-formatted new
                // value (+ a fresh children ref for containers).
                wsPush(ch, wakeWr, Json.obj().str("type", "setVarResult").int("id", pid).str("value", bodyStr(msg.raw, "value")).int("ref", bodyI64(msg.raw, "variablesReference", 0 as i64)).build())
            } else if kind == "disasm" {
                wsPush(ch, wakeWr, Json.obj().str("type", "disasm").int("id", pid).raw("instructions", disasmJson(msg.raw)).build())
            } else if kind == "cmpl" {
                wsPush(ch, wakeWr, Json.obj().str("type", "completions").int("id", pid).raw("targets", completionsJson(msg.raw)).build())
            } else if kind == "readmem" {
                // readMemory body: address + base64 data; UI decodes.
                wsPush(ch, wakeWr, Json.obj().str("type", "memory").int("id", pid).str("address", bodyStr(msg.raw, "address")).str("data", bodyStr(msg.raw, "data")).build())
            } else if kind == "thr" {
                // threads at this stop; "current" is the stopping thread.
                gThreadsMsg = Json.obj().str("type", "threads").int("current", tid)
                    .raw("threads", threadsJson(msg.raw)).build()
                wsPush(ch, wakeWr, gThreadsMsg.clone())
                // lldb-dap fills its thread list lazily after a stop — the
                // immediate response usually carries only the stopping thread.
                // Re-poll a few times (attempt count rides in the id field);
                // the requests go through R's odd-seq path since D owns cl.
                if pid < 3 {
                    let att = pid + 1
                    // the re-poll task outlives this iteration, so it carries its
                    // own retained handle instead of moving D's out of the loop.
                    let pollPend = pendCh.clone()
                    Task.spawn(move(): void => {
                        sleepMs(300)
                        if gStopMsg.len > 0 && gDapIn >= 0 {
                            gOddSeq = gOddSeq + 2
                            let _p = pollPend.trySend(Pending {
                                seq: gOddSeq, kind: "thr", id: att, extra: ""
                            }
                            )
                            sendReqFd(gDapIn, gOddSeq, "threads", "{}")
                        }
                    }
                    )
                }
            } else if kind == "tst" {
                // stack for a user-selected thread; tid rides in extra.
                var t: string = "0"
                if pextra.len > 0 {
                    t = pextra.clone()
                }
                wsPush(ch, wakeWr, Json.obj().str("type", "threadStack").int("id", pid).raw("tid", t).raw("frames", framesJson(msg.raw)).build())
            }
            // bpLive / cfgDone / unmatched: nothing to route
        } else if msg.kind == "event" {
            if msg.event == "initialized" {
                // "Stop at main" for native targets = a function breakpoint
                // (plain stopOnEntry would strand the user at dyld's entry with
                // no source). Python uses launch stopOnEntry instead — see
                // launchArgs(). Failure is tolerated: fbInit response is a no-op.
                // python and node stop at entry via launch stopOnEntry instead
                // (no "main" symbol; js-debug has no function breakpoints).
                if stopAtMain && adapterKind != "python" && adapterKind != "node" {
                    let fb = Json.obj().arr("breakpoints", Json.arr().obj(Json.obj().str("name", mainSymbolFor(adapterKind)))).build()
                    let fs = cl.send("setFunctionBreakpoints", fb)
                    pend.push(Pending {
                        seq: fs, kind: "fbInit", id: 0, extra: ""
                    }
                    )
                }
                // One setBreakpoints per file with bps; configurationDone
                // is deferred until the last sbInit + ebInit round-trips.
                sbLeft = 0
                match Json.parse(bpArgs.clone()) {
                    Result.Ok(doc) => {
                        let n = doc.len()
                        var i: i64 = 0
                        while i < n {
                            match doc.at(i) {
                                Option.Some(el) => {
                                    let a = el.str("args") ?? "{}"
                                    let s = cl.send("setBreakpoints", a)
                                    pend.push(Pending {
                                        seq: s, kind: "sbInit", id: 0, extra: ""
                                    }
                                    )
                                    sbLeft = sbLeft + 1
                                }
                                Option.None => {
                                }
                            }
                            i = i + 1
                        }
                    }
                    Result.Err(_e) => {
                    }
                }
                if sbLeft == 0 {
                    let s = cl.send("setExceptionBreakpoints", excArgs())
                    pend.push(Pending {
                        seq: s, kind: "ebInit", id: 0, extra: ""
                    }
                    )
                }
            } else if msg.event == "output" {
                // Buffer for late-join replay — skip telemetry (adapter-internal,
                // never displayed). Bounded FIFO; a non-pty adapter floods here.
                let ocat = bodyStr(msg.raw, "category")
                if ocat != "telemetry" {
                    gOutputLog.push(OutLine {
                        text: bodyStr(msg.raw, "output"), category: ocat.clone()
                    }
                    )
                    if gOutputLog.len > OUTLOG_MAX {
                        let _d = gOutputLog.remove(0)
                    }
                }
                wsPush(ch, wakeWr, outputMsg(msg.raw))
            } else if msg.event == "process" {
                // "launch" only: an ATTACHED process was running before this
                // session and has to outlive it: reaping it would turn a
                // detach into a kill.
                if bodyStr(msg.raw, "startMethod") == "launch" {
                    gDebuggeePid = bodyI64(msg.raw, "systemProcessId", 0 as i64)
                }
            } else if msg.event == "exited" {
                // Not session end (restart emits it for the old process) —
                // just remember the code for the run-exited log line.
                gLastExit = bodyI64(msg.raw, "exitCode", -1 as i64)
            } else if msg.event == "stopped" {
                if gLogLevel >= 2 {
                    logEvent("stopped", $"thread {bodyI64(msg.raw, "threadId", -1 as i64)}  reason {bodyStr(msg.raw, "reason")}")
                }
                tid = bodyI64(msg.raw, "threadId", -1 as i64)
                let stArgs = Json.obj().int("threadId", tid)
                    .int("startFrame", 0).int("levels", 20).build()
                let s = cl.send("stackTrace", stArgs)
                pend.push(Pending {
                    seq: s, kind: "st", id: 0, extra: ""
                }
                )
                // every stop also refreshes the threads panel.
                let ts = cl.send("threads", "{}")
                pend.push(Pending {
                    seq: ts, kind: "thr", id: 0, extra: ""
                }
                )
            } else if msg.event == "terminated" {
                wsPush(ch, wakeWr, terminatedMsg())
                break
            }
            // "exited" alone is NOT session end: a native restart kills
            // the old process and emits exited for it. Real session end always
            // arrives as terminated or adapter EOF (recv error above).
        } else if msg.kind == "request" {
            if msg.command == "runInTerminal" {
                // A restart replaces the pty; the old master needs no close
                // here — its own pump owns it and closes it when the dead child
                // EOFs the master.
                let _m = handleRunInTerminal(cl, msg.raw, msg.seq, ch, wakeWr)
            } else if msg.command == "startDebugging" {
                // js-debug: the debuggee lives in a CHILD session the adapter
                // asks us to open — a second connection to the same server,
                // launched with the configuration riding in this request. The
                // child is where stops/threads/frames happen, so the loop swaps
                // onto it; the parent is left to a drain task (its output
                // events still carry the program's stdio).
                cl.respond(msg.seq, "startDebugging", "{}")
                var childCfg: string = ""
                var childReq: string = "launch"
                if let Result.Ok(doc) = Json.parse(msg.raw.clone()) {
                    match doc.get("arguments") {
                        Option.Some(args) => {
                            childReq = args.str("request") ?? "launch"
                            match args.get("configuration") {
                                Option.Some(c) => {
                                    childCfg = c.rawStr()
                                }
                                Option.None => {
                                }
                            }
                        }
                        Option.None => {
                        }
                    }
                }
                var host: string = "127.0.0.1"
                if gDapPort > 0 && gDapHost.len > 0 {
                    host = gDapHost.clone()
                }
                if childCfg.len == 0 || gSrvPort <= 0 {
                    eprint("[srv] startDebugging without a child config/port — ignored\n")
                } else {
                    match DapClient.startTcp(host, gSrvPort) {
                        Result.Ok(childCl) => {
                            gChildLaunch = childCfg
                            gChildReq = childReq
                            var parentCl = cl
                            gParentIn = parentCl.child.stdinFd
                            cl = childCl
                            // parent pendings can never match child seqs — drop
                            // them (the drain task ignores stray responses).
                            pend = []
                            gDapIn = cl.child.stdinFd
                            let dch = ch.clone()
                            Task.spawn(move(): void => {
                                parentDrainLoop(parentCl, dch, wakeWr)
                            }
                            )
                            let s = cl.send("initialize", initArgs())
                            pend.push(Pending {
                                seq: s, kind: "initialize", id: 0, extra: ""
                            }
                            )
                        }
                        Result.Err(e) => {
                            eprint($"[srv] child session connect failed: {e}\n")
                            wsPush(ch, wakeWr, terminatedMsg())
                            break
                        }
                    }
                }
            }
        }
    }

    cl.close()
    var durSecs = (epochMillis() - gRunStartMs) / 1000
    if gLastExit >= 0 {
        logEvent("run exited", $"code {gLastExit}  ({durSecs}s)")
    } else {
        // No exited event: killed, detached from an attach, or adapter EOF.
        logEvent("run ended", $"({durSecs}s)")
    }
    // Session over: re-arm `run` directly (globals, same scheduler
    // thread). Stale pendings must not collide with the next adapter's seq
    // numbers, which restart at 1.
    if gParentIn >= 0 {
        // adapter EOF / a `terminated` we did not ask for: same reasoning as the
        // kill path, and it costs one write to a fd that is about to close.
        sendReqFd(gParentIn, 999999 as i64, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
        gParentIn = -1
    }
    killAdapterSrv()
    reapDebuggee()
    gChildLaunch = ""
    gChildReq = ""
    gStarted = false
    gDapIn = -1
    gPtyFd = -1
    gStdinBuf = ""
    gOddSeq = -1 as i64
    gStopMsg = ""
    gThreadsMsg = ""
    gRegionsMsg = ""
    gCapsMsg = ""
    while true {
        match pendCh.tryRecv() {
            Option.Some(_p) => {
            }
            Option.None => {
                break
            }
        }
    }
    // A forced run killed the old debuggee; auto-rerun here with its config
    // (a new config can't ride a live adapter — it caches launch args).
    if gPendingRun {
        gPendingRun = false
        var err: string = ""
        if gPendingConfig.len > 0 {
            // .clone(): passing the global by value would move its buffer into
            // applyConfig and the reassignment below would double-free it (the
            // checker doesn't track moves out of globals).
            err = applyConfig(gPendingConfig.clone(), "")
            gPendingConfig = ""
            if err.len == 0 {
                // applyConfig empties gBps (the new config may be a different
                // program); reload the program-keyed store before the hello, or
                // a forced relaunch of the same target silently throws away the
                // breakpoints the user set for it.
                loadBps()
                pushHelloState(ch, wakeWr)
            }
        }
        if err.len > 0 {
            wsPush(ch, wakeWr, configErrMsg(err))
        } else if binPath.len > 0 || gRequest == "attach" {
            stopAtMain = gPendingStopAtMain
            let _ok = startRun(ch, wakeWr, pendCh)
        }
    }
}

// "Debug server listening at 127.0.0.1:61234" → 61234, or 0 while incomplete.
// No trailing space in the needle: delve punctuates it "listening at: host:port".
fn parseListenPort(s: &string): i64 {
    let Option.Some(at) = s.indexOf("listening at") else {
        return 0
    }
    let rest = s.substr(at, s.len)
    let Option.Some(nl) = rest.indexOf("\n") else {
        return 0 // line still arriving — wait for more stdout
    }
    let line = rest.substr(0, nl)
    let Option.Some(colon) = line.lastIndexOf(":") else {
        return 0
    }
    return line.substr(colon + 1, line.len).trim().parseInt() ?? (0 as i64)
}

// Spawn a TCP-only adapter (js-debug's dapDebugServer) with a port argument of
// 0, read the port the OS picked off its stdout, and leave both output streams
// pumped. Returns the port to connect to; the server pid lands in gSrvPid for
// teardown (closing our sockets leaves it listening forever).
fn spawnTcpAdapter(prog: &string, args: &Vec<string>): Result<i64> {
    let child = Child.spawn(prog, args, false)?
    gSrvPid = child.pid as i64
    let errFd = child.stderrFd
    if errFd >= 0 {
        // same pre-handshake crash capture as stdio adapters
        Task.spawn(move(): void => {
            adapterStderrPump(errFd)
        }
        )
    }
    let outFd = child.stdoutFd
    var chOut = fdChannel(outFd)
    var acc: string = ""
    var port: i64 = 0
    for chunk in chOut {
        acc = acc + chunk
        port = parseListenPort(acc)
        // 4KB with no listen line = it's printing something else (a crash, a
        // usage error) — stop accumulating and fail with what it said.
        if port > 0 || acc.len > 4096 {
            break
        }
    }
    if port <= 0 {
        return Result.Err("adapter never printed its listen port" + (if acc.len > 0 { ":\n" + acc } else { "" }))
    }
    // keep draining stdout or a chatty server fills the pipe and stalls
    Task.spawn(move(): void => {
        var rest = chOut
        for c in rest {
            eprint("[adapter] " + c)
        }
        unsafe {
            close(outFd)
        }
    }
    )
    return Result.Ok(port)
}

// SIGTERM + reap the spawned TCP adapter server, if any. Synthetic Child: only
// the pid matters; the stdio fds are owned (and closed) by their pump tasks.
// signal 0 delivers nothing and only asks "could I signal this pid?", the
// portable liveness check for a process that is not our child (so not waitable).
fn pidAlive(c: &mut Child): bool {
    if let Result.Ok(_) = c.signal(0) {
        return true
    }
    return false
}

fn killAdapterSrv(): void {
    if gSrvPid > 0 {
        var c = Child {
            pid: gSrvPid as i32, stdinFd: -1 as i32, stdoutFd: -1 as i32, stderrFd: -1 as i32
        }
        // Let it exit on its own first: the disconnect we just sent is what makes
        // it kill the debuggee, and SIGTERMing it mid-teardown skips that.
        var waited: i64 = 0
        while waited < 1000 && pidAlive(c) {
            unsafe {
                let _u = usleep(50000 as u32)
            }
            waited = waited + 50
        }
        let _k = c.signal(15)
        let _w = c.wait()
    }
    gSrvPid = 0
    gSrvPort = 0
}

// Make sure a launched debuggee is actually dead at session end. lldb-dap and
// debugpy kill their child themselves, but js-debug and dlv run the program
// under a SERVER we spawned: SIGTERMing that server reparents the program to
// init and dapweb reports "idle" while it is still running (and still holding
// the port/file the next run wants). Give it a moment to go on its own, then
// SIGTERM it. Not a child of ours, so signal, never wait.
fn reapDebuggee(): void {
    if gDebuggeePid > 0 {
        var c = Child {
            pid: gDebuggeePid as i32, stdinFd: -1 as i32, stdoutFd: -1 as i32, stderrFd: -1 as i32
        }
        var waited: i64 = 0
        while waited < 500 && pidAlive(c) {
            unsafe {
                let _u = usleep(50000 as u32)
            }
            waited = waited + 50
        }
        if pidAlive(c) {
            let _k = c.signal(15)
            logEvent("debuggee reaped", $"pid {gDebuggeePid} outlived the adapter (SIGTERM)")
        }
    }
    gDebuggeePid = 0
}

// spawn the DAP adapter for the current config and drive the handshake.
// Shared by the run command (R) and restart-with-staged auto-rerun (D). Assumes
// binPath set and !gStarted. Broadcasts terminated and returns false if the
// adapter fails to spawn. bus/busWakeWr are the broadcast channel + wake fd.
fn startRun(bus: &Channel<string>, busWakeWr: i32, pendCh: &Channel<Pending>): bool {
    gStarted = true
    // reset BEFORE any spawn: the node path starts its stderr pump inside
    // spawnTcpAdapter, and a reset after it would wipe an early crash capture.
    gAdapterStderr = ""
    // Transport: TCP connects to a running adapter (gDapPort>0); stdio spawns
    // the resolved adapter command. Both yield a DapClient whose child.stdinFd
    // is the DAP write fd — the rest of the handshake is identical.
    var startRes: Result<DapClient> = Result.Err("uninitialized")
    var label: string = ""
    if gDapPort > 0 {
        label = $"tcp {gDapHost}:{gDapPort}"
        startRes = DapClient.startTcp(gDapHost, gDapPort)
        // a user-run js-debug server also hands the debuggee to a child session;
        // remember where to open that second connection (see startDebugging).
        if adapterKind == "node" {
            gSrvPort = gDapPort
        }
    } else if tcpListenArgs(adapterKind).len > 0 {
        // A socket-only adapter (js-debug, dlv): spawn it asking for port 0,
        // read the port it bound off stdout, connect. From here the handshake is
        // the same as any TCP adapter.
        var argv = adapterArgvOf(adapterCmd)
        if argv.len == 0 {
            eprint("[srv] no adapter configured\n")
            gStarted = false
            wsPush(bus, busWakeWr, terminatedMsg())
            return false
        }
        var prog: string = argv[0].clone()
        var rest: Vec<string> = []
        var ai: i64 = 1
        while ai < argv.len {
            rest.push(argv[ai].clone())
            ai = ai + 1
        }
        for la in tcpListenArgs(adapterKind) {
            rest.push(la.clone())
        }
        label = $"adapter {Path.basename(prog)}"
        match spawnTcpAdapter(prog, rest) {
            Result.Ok(port) => {
                gSrvPort = port
                startRes = DapClient.startTcp("127.0.0.1", port)
            }
            Result.Err(e) => {
                startRes = Result.Err(e)
            }
        }
    } else {
        var argv = adapterArgvOf(adapterCmd)
        // adapterCmd is always set by config-apply before a stdio run reaches here.
        if argv.len == 0 {
            eprint("[srv] no adapter configured\n")
            gStarted = false
            wsPush(bus, busWakeWr, terminatedMsg())
            return false
        }
        var prog: string = argv[0].clone()
        var rest: Vec<string> = []
        var ai: i64 = 1
        while ai < argv.len {
            rest.push(argv[ai].clone())
            ai = ai + 1
        }
        label = $"adapter {Path.basename(prog)}"
        startRes = DapClient.startArgs(prog, rest)
    }
    match startRes {
        Result.Ok(client) => {
            var cl = client
            gRunStartMs = epochMillis()
            gLastExit = -1 as i64
            logEvent("run started", $"{binPath}  {label} pid {cl.child.pid}")
            gDapIn = cl.child.stdinFd
            // Drain + capture adapter stderr (stdio spawns only; TCP has no child
            // stderr, errFd -1). Must start before cl moves into the reader task.
            let errFd = cl.child.stderrFd
            if errFd >= 0 {
                // Hand the descriptor to the pump: -1 here makes Child.close()
                // skip it, so it is closed exactly once, by its only reader.
                cl.child.stderrFd = -1
                Task.spawn(move(): void => {
                    adapterStderrPump(errFd)
                }
                )
            }
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "initialize", id: 0, extra: buildAllBpArgs(gBps),
            }
            )
            sendReqFd(gDapIn, gOddSeq, "initialize", initArgs())
            let readerBus = bus.clone()
            let readerPend = pendCh.clone()
            Task.spawn(move(): void => {
                dapReaderLoop(cl, readerBus, busWakeWr, readerPend)
            }
            )
            return true
        }
        Result.Err(e) => {
            eprint($"[srv] adapter spawn failed: {e}\n")
            killAdapterSrv()
            gStarted = false
            wsPush(bus, busWakeWr, configErrMsg($"adapter failed to start: {e}"))
            wsPush(bus, busWakeWr, terminatedMsg())
            return false
        }
    }
}

// One client command (the `{"cmd": ...}` JSON the browser sends over WS).
// Factored out of the WS reader so the HTTP API can drive the exact same verbs:
// one vocabulary, so `dapweb api` cannot drift from what the UI does.
// One human-readable line for what a command is about to do. Only the verbs an
// onlooker would care about get spelled out; anything else falls back to its name.
fn activityText(c: &string, payload: &string): string {
    if c == "run" {
        return "launch the program"
    }
    if c == "continue" {
        return "continue"
    }
    if c == "pause" {
        return "pause the program"
    }
    if c == "kill" {
        return "terminate the program"
    }
    if c == "restart" {
        return "restart the program"
    }
    if c == "stepOver" || c == "stepIn" || c == "stepOut" {
        return c.clone()
    }
    if c == "evaluate" {
        return $"evaluate `{jStr(payload, "expr")}`"
    }
    if c == "setBreakpoint" {
        return $"set a breakpoint at line {jI64(payload, "line", 0 as i64)}"
    }
    if c == "clearBreakpoint" {
        return $"clear the breakpoint at line {jI64(payload, "line", 0 as i64)}"
    }
    if c == "setVar" {
        return $"set {jStr(payload, "name")} = {jStr(payload, "value")}"
    }
    if c == "setConfig" {
        return "change the debug target"
    }
    if c == "newSession" {
        return "reset the session"
    }
    return c.clone()
}

fn dispatchClientCmd(payload: string, peerKind: string, peerLabel: string, bus: &Channel<string>, busWakeWr: i32, pendCh: &Channel<Pending>): void {
    let c = jStr(payload, "cmd")
    // A browser peer's actions are self-evident to whoever performed them; an
    // agent's are not. Announce before acting, so the human watching the UI is
    // never surprised by a program that moves on its own.
    if peerKind != "browser" {
        let who = peerLabel
        let what = activityText(c, payload)
        logEvent("agent", $"{who} is attempting to {what}")
        wsPush(bus, busWakeWr, Json.obj().str("type", "activity")
            .str("peer", peerKind.clone()).str("who", who.clone()).str("cmd", c.clone())
            .str("text", $"{who} is attempting to {what}").build())
    }
    if c == "setBreakpoint" || c == "clearBreakpoint" {
        let line = jI64(payload, "line", 0 as i64)
        var path = absSourcePath(jStr(payload, "path"))
        if path.len == 0 {
            path = absSourcePath(srcPath)
        }
        // Upsert: drop any existing bp at (path, line), then re-add for
        // "set" (a condition edit is a set on an existing line).
        var keep: Vec<Bp> = []
        for bp in gBps {
            if bp.line != line || bp.path != path {
                keep.push(cloneBp(bp))
            }
        }
        gBps = keep
        if c == "setBreakpoint" {
            gBps.push(Bp {
                path: path.clone(),
                line: line,
                condition: jStr(payload, "condition"),
                hitCondition: jStr(payload, "hitCondition"),
                logMessage: jStr(payload, "logMessage"),
                enabled: jBool(payload, "enabled", true),
            }
            )
        }
        persistBps()
        // Echo the resulting state: for a set that is the stored breakpoint, for
        // a clear a bare (path, line) is all a peer needs to drop its own copy.
        let ack = Bp {
            path: path.clone(), line: line,
            condition: jStr(payload, "condition"),
            hitCondition: jStr(payload, "hitCondition"),
            logMessage: jStr(payload, "logMessage"),
            enabled: jBool(payload, "enabled", true),
        }
        wsPush(bus, busWakeWr, bpAckMsg(ack, c == "setBreakpoint"))
        if gStarted && gDapIn >= 0 {
            gOddSeq = gOddSeq + 2
            // Register before sending (here and below): D drains pendings
            // after each recv, so the entry must exist before the adapter
            // can possibly reply or the response is dropped unmatched.
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "bpLive", id: 0, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "setBreakpoints", buildBpArgsForPath(gBps, path))
        }
    } else if c == "run" {
        // The editor is the source of truth: an inline `config` object rides
        // the run and is applied just before launch — no staging. A live
        // session requires force:true (the client confirms with the user),
        // which kills it and reruns with the new config after teardown.
        let cfgRaw = jObjRaw(payload, "config")
        if gStarted {
            if jBool(payload, "force", false) && gDapIn >= 0 {
                gPendingRun = true
                gPendingConfig = cfgRaw
                gPendingStopAtMain = jBool(payload, "stopAtMain", gConfigStopAtMain)
                logEvent("run killed", $"forced by {peerKind} peer — relaunching")
                gOddSeq = gOddSeq + 2
                let _p = pendCh.trySend(Pending {
                    seq: gOddSeq, kind: "disc", id: 0, extra: ""
                }
                )
                sendReqFd(gDapIn, gOddSeq, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
            } else {
                wsPush(bus, busWakeWr, configErrMsg("a debug session is already active — run with force:true to kill and relaunch"))
            }
        } else {
            var cfgErr: string = ""
            if cfgRaw.len > 0 {
                cfgErr = applyConfig(cfgRaw, "")
                if cfgErr.len == 0 {
                    logEvent("target changed", $"{binPath}  (by {peerKind} peer)")
                    loadBps()
                    pushHelloState(bus, busWakeWr)
                }
            }
            if cfgErr.len > 0 {
                wsPush(bus, busWakeWr, configErrMsg(cfgErr))
            } else if binPath.len == 0 && gRequest != "attach" {
                // Booted idle with no target: nudge to the config drawer instead
                // of spawning the adapter with an empty program path.
                wsPush(bus, busWakeWr, configErrMsg("no program configured — set a debug target (⚙) before running"))
            } else {
                stopAtMain = jBool(payload, "stopAtMain", gConfigStopAtMain)
                let _ok = startRun(bus, busWakeWr, pendCh)
            }
        }
    } else if c == "continue" || c == "stepOver" || c == "stepIn" || c == "stepOut" || c == "pause" {
        if c != "pause" {
            gStopMsg = ""
            gThreadsMsg = ""
            gRegionsMsg = ""
        } // resumed: snapshots are stale for late joiners
        if gDapIn >= 0 {
            var dapCmd: string = "continue"
            if c == "stepOver" {
                dapCmd = "next"
            } 
            else if c == "stepIn" {
                dapCmd = "stepIn"
            } 
            else if c == "stepOut" {
                dapCmd = "stepOut"
            } 
            else if c == "pause" {
                dapCmd = "pause"
            }
            let t = jI64(payload, "tid", 1 as i64)
            if c == "pause" && t < 0 {
                // Attach flow: Pause can arrive before any stop, so
                // there's no tid yet — ask for threads and pause the first.
                gOddSeq = gOddSeq + 2
                let _p = pendCh.trySend(Pending {
                    seq: gOddSeq, kind: "thrPause", id: 0, extra: ""
                }
                )
                sendReqFd(gDapIn, gOddSeq, "threads", "{}")
            } else {
                var b = Json.obj().int("threadId", t)
                // instruction-granularity stepping from the asm pane.
                let gran = jStr(payload, "granularity")
                if gran.len > 0 {
                    b = b.str("granularity", gran)
                }
                gOddSeq = gOddSeq + 2
                sendReqFd(gDapIn, gOddSeq, dapCmd, b.build())
            }
        }
    } else if c == "restart" {
        gStopMsg = ""
        gThreadsMsg = ""
        gRegionsMsg = ""
        // native restart — adapter re-launches with the same launch
        // config; gBps and the stop-at-main function bp persist. UI gates
        // this on supportsRestartRequest (kill+rerun is its fallback). A
        // config change is a Run (force-kills), not a restart.
        if gDapIn >= 0 {
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "restartR", id: 0, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "restart", Json.obj().build())
        }
    } else if c == "kill" {
        // End the session: adapter tears down the debuggee and exits; the
        // reader loop's terminated/EOF path re-arms `run` via endCh.
        logEvent("kill requested", $"(by {peerKind} peer)")
        if gDapIn >= 0 {
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "disc", id: 0, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
        }
        // The child session debugs the process; the PARENT is what spawned it.
        // Disconnecting only the child leaves the program running with nobody
        // attached, which reads in the UI as "killed" and is not.
        if gParentIn >= 0 {
            sendReqFd(gParentIn, gOddSeq + 1, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
        }
    } else if c == "evaluate" {
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            let frameId = jI64(payload, "frameId", -1 as i64)
            var b = Json.obj().str("expression", jStr(payload, "expr"))
                .str("context", jStr(payload, "context"))
            if frameId >= 0 {
                b = b.int("frameId", frameId)
            }
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "eval", id: id, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "evaluate", b.build())
        }
    } else if c == "expand" {
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "expand", id: id, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "variables", Json.obj().int("variablesReference", jI64(payload, "ref", 0 as i64)).build())
        }
    } else if c == "threadStack" {
        // stack for a clicked thread; the UI then drives frameScopes
        // for its locals like any other frame selection.
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            let t = jI64(payload, "tid", 1 as i64)
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "tst", id: id, extra: t.toString()
            }
            )
            sendReqFd(gDapIn, gOddSeq, "stackTrace", Json.obj().int("threadId", t).int("startFrame", 0).int("levels", 20).build())
        }
    } else if c == "frameScopes" {
        // locals for a user-selected stack frame.
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "fsc", id: id, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "scopes", Json.obj().int("frameId", jI64(payload, "frameId", 0 as i64)).build())
        }
    } else if c == "setExceptions" {
        // selected exception filter ids. Stored globally so session
        // init applies them; live-applied when a session is running.
        var arr = Json.arr()
        match Json.parse(payload.clone()) {
            Result.Ok(doc) => {
                match doc.get("filters") {
                    Option.Some(f) => {
                        let n = f.len()
                        var i: i64 = 0
                        while i < n {
                            match f.at(i) {
                                Option.Some(el) => {
                                    arr = arr.str(el.asStr() ?? "")
                                }
                                Option.None => {
                                }
                            }
                            i = i + 1
                        }
                    }
                    Option.None => {
                    }
                }
            }
            Result.Err(_e) => {
            }
        }
        excFiltersJson = arr.build()
        if gStarted && gDapIn >= 0 {
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "ebLive", id: 0, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "setExceptionBreakpoints", excArgs())
        }
    } else if c == "complete" {
        // debug-console completions.
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            let frameId = jI64(payload, "frameId", -1 as i64)
            var b = Json.obj().str("text", jStr(payload, "text"))
                .int("column", jI64(payload, "column", 1 as i64))
            if frameId >= 0 {
                b = b.int("frameId", frameId)
            }
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "cmpl", id: id, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "completions", b.build())
        }
    } else if c == "readMem" {
        // raw memory window. memoryReference is whatever the UI got
        // from a value/ipRef; lldb-dap accepts plain hex addresses.
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "readmem", id: id, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "readMemory", Json.obj().str("memoryReference", jStr(payload, "memoryReference")).int("offset", jI64(payload, "offset", 0 as i64)).int("count", jI64(payload, "count", 256 as i64)).build())
        }
    } else if c == "setVar" {
        // edit a variable. ref = parent container (scope ref for
        // top-level locals, the variable's own ref for expanded children).
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "setv", id: id, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "setVariable", Json.obj().int("variablesReference", jI64(payload, "ref", 0 as i64)).str("name", jStr(payload, "name")).str("value", jStr(payload, "value")).build())
        }
    } else if c == "disassemble" {
        // window of instructions around a frame's pc (memoryReference =
        // the frame's instructionPointerReference from stackTrace).
        if gDapIn >= 0 {
            let id = jI64(payload, "id", 0 as i64)
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "disasm", id: id, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "disassemble", Json.obj().str("memoryReference", jStr(payload, "memoryReference")).int("instructionOffset", -16).int("instructionCount", 64).bool("resolveSymbols", true).build())
        }
    } else if c == "openSource" {
        // show the file a clicked frame lives in. sourceMsg itself
        // handles unreadable pseudo-paths (dyld etc.) with a placeholder.
        let p = jStr(payload, "path")
        if p.len > 0 {
            wsPush(bus, busWakeWr, sourceMsg(p))
        }
    } else if c == "stdin" {
        let data = jStr(payload, "data")
        if gPtyFd >= 0 {
            unsafe {
                let _n = write(gPtyFd, data, data.len)
            }
        } else {
            gStdinBuf = gStdinBuf + data
        }
    } else if c == "setConfig" {
        // config = a VS Code launch-configuration object (see applyConfig).
        // The browser applies configs inline on Run; setConfig is the
        // programmatic path (`dapweb api` callers). Idle-only — a live session must be
        // force-run to change target (setConfig never kills a debuggee).
        if gStarted {
            wsPush(bus, busWakeWr, configErrMsg("a debug session is active — stop it (or Run with force) to change the target"))
        } else {
            let err = applyConfig(payload, "")
            if err.len > 0 {
                wsPush(bus, busWakeWr, configErrMsg(err))
            } else {
                logEvent("target changed", $"{binPath}  (by {peerKind} peer)")
                    loadBps()
                pushHelloState(bus, busWakeWr)
            }
        }
    } else if c == "importHistory" {
        // One-shot localStorage migration: fold the client's legacy entries
        // into the server store, then the client stops sending (server is the
        // sole writer thereafter). Idempotent — dedup collapses re-imports.
        match Json.parse(payload.clone()) {
            Result.Ok(d) => {
                match d.get("entries") {
                    Option.Some(e) => {
                        if e.isArray() {
                            gHistory = histMergeMany(gHistory, e.rawStr(), 10 as i64)
                            persistHistory()
                            wsPush(bus, busWakeWr, historyChangedMsg())
                        }
                    }
                    Option.None => {
                    }
                }
            }
            Result.Err(_e) => {
            }
        }
    } else if c == "newSession" {
        // Deliberate fresh start (a reload reconnects to the live session
        // by design): end any running debuggee via the kill path, drop bps
        // and the late-join replay snapshots, mint a new id, and re-hello
        // every peer — each resets its client state on the id change.
        // Target config survives; the ⚙ drawer changes it.
        if gStarted && gDapIn >= 0 {
            gOddSeq = gOddSeq + 2
            let _p = pendCh.trySend(Pending {
                seq: gOddSeq, kind: "disc", id: 0, extra: ""
            }
            )
            sendReqFd(gDapIn, gOddSeq, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
        }
        gBps = []
        persistBps()
        gStopMsg = ""
        gThreadsMsg = ""
        gRegionsMsg = ""
        gOutputLog = []
        gSessionId = newSessionName(sessionNameSeeds())
        logEvent("session reset", $"new session {gSessionId}")
        pushHelloState(bus, busWakeWr)
    }
}

// ── session registry ──
//
// This server IS its session's identity (one process, one session), so the
// descriptor it drops in the registry is what `dapweb api list` and the
// /sessions dashboard read. Directory layout and pruning live in ../sessions.
// Five candidates, so a name already taken by a live session can be re-rolled
// without another trip out to the uuid generator mid-loop.
fn sessionNameSeeds(): Vec<string> {
    var out: Vec<string> = []
    var i: i64 = 0
    while i < 5 {
        out.push(Uuid.v4().toString())
        i = i + 1
    }
    return out
}

fn registerSession(port: i64): void {
    gListenPort = port
    gStartedAt = epochMillis()
    writeSession(gSessionId, getpid() as i64, port, binPath, adapterId(), gStartedAt)
}

// The descriptor names the program this server is debugging, and that changes
// whenever someone retargets from the browser. Written once at startup it would
// go stale on the first retarget, and the dashboard's whole job is to say what
// each session is on — so rewrite it, keeping the original start time.
fn refreshSession(): void {
    if gListenPort > 0 {
        writeSession(gSessionId, getpid() as i64, gListenPort, binPath, adapterId(), gStartedAt)
    }
}

fn unregisterSession(): void {
    removeSession(gSessionId)
}

// First port above ours that nothing is listening on. Deliberately sequential
// rather than an ephemeral port: 8080 → 8081 → 8082 is a number a human can
// remember and type, which is the whole reason the dashboard exists.
//
// The listener is dropped on the way out, so the port is free by the time the
// child binds it. That is a race, and losing it costs the child its bind with a
// clear error rather than anything silent.
fn freePortFrom(base: i64): i64 {
    var p = base + 1
    while p < base + 200 {
        match TcpListener.bind(p as u16) {
            Result.Ok(_l) => {
                return p
            }
            Result.Err(_e) => {
            }
        }
        p = p + 1
    }
    return 0
}

// The dashboard's "new session" button. A session IS a server process, so making
// one means spawning one — this server cannot host a second.
//
// It spawns OUR OWN executable and nothing else: the path comes from exePath(),
// never from the caller. That matters less than it looks like it should, since
// /api/cmd already forwards `evaluate` to the debugger and can therefore run
// arbitrary code in the debuggee — which is why the README says keep this port
// on loopback.
fn spawnSessionJson(): string {
    let port = freePortFrom(gListenPort)
    if port == 0 {
        return Json.obj().bool("ok", false).str("error", "no free port near this one").build()
    }
    let exe = match exePath() {
        Result.Ok(x) => {
            x
        }
        Result.Err(_e) => {
            return Json.obj().bool("ok", false).str("error", "could not resolve the dapweb executable").build()
        }
    }
    // --no-browser: the tab is opened by whoever clicked, on their machine. This
    // server's host may not even have a browser.
    var cmd = Command.new(exe).arg("web").arg("--port").arg($"{port}").arg("--no-browser")
    // Inherit --webroot: without it a child serves the bundle embedded at compile
    // time, so during UI work every spawned session silently shows yesterday's UI.
    if webroot.len > 0 {
        cmd = cmd.arg("--webroot").arg(webroot.clone())
    }
    match cmd.spawn() {
        Result.Ok(child) => {
            // Deliberately not waited on: it outlives this request, and us.
            let _c = child
            return Json.obj().bool("ok", true).int("port", port).build()
        }
        Result.Err(_e) => {
            return Json.obj().bool("ok", false).str("error", "could not start a new dapweb").build()
        }
    }
}

// Running processes, for the target bar's attach picker. Nobody remembers a pid,
// and making the user go find one in another terminal is most of why attaching
// feels harder than launching.
//
// Shelling out to ps rather than reading kinfo_proc through sysctl: the struct
// layout is neither stable nor shared between macOS and Linux, and this is a
// picker, not a monitor. Windows has no ps, so it answers an empty list with a
// note instead of a plausible-looking lie.
//
// The command line is included because "which of these four node processes" is
// exactly the question being asked, and argv can carry secrets. That is not a
// new exposure: this port already answers `evaluate`, so anyone who can reach it
// can already run ps through the debugger. It is a reason to keep the port on
// loopback, which the README already says.
fn processListJson(): string {
    var arr = Json.arr()
    var count: i64 = 0
    // args= only, deliberately: macOS pads/TRUNCATES the comm column to 16
    // characters, so "/usr/libexec/logd" comes back as "/usr/libexec/log" and
    // the name shown in the picker would be subtly wrong. argv[0] is not
    // truncated, and its basename is the name anyway.
    let cmd = Command.new("ps").arg("-axo").arg("pid=,args=").stdout(Stdio.Pipe)
    match cmd.spawn() {
        Result.Ok(child) => {
            var ch = child
            var out: string = ""
            if ch.stdoutFd >= 0 {
                for chunk in fdChannel(ch.stdoutFd) {
                    out = out + chunk
                }
            }
            let _w = ch.wait()
            for line in splitLines(out) {
                let t = line.trim()
                if t.len == 0 {
                    continue
                }
                // "<pid> <argv…>"
                let fields = t.splitWhitespace()
                if fields.len < 2 {
                    continue
                }
                let pid = fields[0].parseInt() ?? (0 as i64)
                if pid <= 0 {
                    continue
                }
                let full = t.substr(fields[0].len, t.len).trim()
                arr = arr.raw(Json.obj().int("pid", pid)
                    .str("name", Path.basename(fields[1]))
                    .str("cmd", full).build())
                count = count + 1
            }
        }
        Result.Err(_e) => {
            return Json.obj().arr("processes", Json.arr())
                .str("error", "could not list processes on this platform").build()
        }
    }
    return Json.obj().arr("processes", arr).int("count", count).build()
}

// ── HTTP API ──
//
// Snapshot of everything a caller needs to decide what to do next. Built from the
// same globals the WS replay uses, so `api state` and a freshly-opened browser tab
// always agree.
fn apiStateJson(): string {
    var phase = "idle"
    if gStarted {
        phase = "running"
    }
    if gStopMsg.len > 0 {
        phase = "stopped"
    }
    var bps = Json.arr()
    for bp in gBps {
        bps = bps.raw(Json.obj().str("path", bp.path.clone()).int("line", bp.line)
            .str("condition", bp.condition.clone()).bool("enabled", bp.enabled).build())
    }
    var b = Json.obj().str("type", "state")
        .str("sessionId", gSessionId.clone())
        .str("phase", phase)
        .str("program", binPath.clone())
        .str("sourcePath", srcPath.clone())
        .str("adapter", adapterId())
        .int("peers", gPeers)
        .arr("breakpoints", bps)
    if gStopMsg.len > 0 {
        b = b.raw("stopped", gStopMsg.clone())
    }
    if gThreadsMsg.len > 0 {
        b = b.raw("threads", gThreadsMsg.clone())
    }
    return b.build()
}

// Display name for an api caller: ?agent=<label>&pid=<n>, both optional. Identity
// rides the query string so the {"cmd":...} body stays exactly what the browser
// speaks and cannot drift from it.
fn apiWho(query: &string): string {
    var who = queryParam(query, "agent")
    if who.len == 0 {
        // An unlabelled caller (curl, a hand-rolled client) is an api caller and
        // nothing more; "agent" would be a claim about it we cannot make.
        who = "api"
    }
    let apid = queryParam(query, "pid")
    if apid.len > 0 {
        who = $"{who} (pid {apid})"
    }
    return who
}

// Value of `key` in a raw query string ("a=1&b=2"); "" when absent.
fn queryParam(query: &string, key: &string): string {
    var i: i64 = 0
    var cur: string = ""
    while i <= query.len {
        if i == query.len || query[i] == '&' {
            var eq: i64 = 0
            while eq < cur.len && cur[eq] != '=' {
                eq = eq + 1
            }
            if eq < cur.len && cur.substr(0, eq) == key {
                return cur.substr(eq + 1, cur.len)
            }
            cur = ""
        } else {
            cur.push(query[i])
        }
        i = i + 1
    }
    return ""
}

// Run one command and, when `awaitType` is set, block until a broadcast of that
// type arrives (or the deadline passes). Registering as a Sink first means no
// reply can slip through between dispatch and listening.
fn apiRunCmd(body: string, awaitType: string, timeoutMs: i64, who: string, bus: &Channel<string>, busWakeWr: i32, pendCh: &Channel<Pending>): string {
    // An agent driving the session IS activity: without this an --idle-ttl server
    // reaps the debuggee out from under a caller that has no WS peer holding it.
    gLastActivityMs = epochMillis()
    if awaitType.len == 0 {
        dispatchClientCmd(body, "api", who, bus, busWakeWr, pendCh)
        return Json.obj().bool("ok", true).build()
    }
    let ch = Channel<string>.new(256)!
    var wake: [i32; 2] = [0; 2]
    unsafe {
        if pipe(wake as *i32) != 0 {
            return Json.obj().bool("ok", false).str("error", "pipe failed").build()
        }
    }
    let clientId = gNextClient
    gNextClient = gNextClient + 1
    sinkRegister(clientId, ch, wake[1])
    var one: [u8; 1] = [110; 1]
    unsafe {
        let _w = write(busWakeWr, one as *u8, 1)
    }
    dispatchClientCmd(body, "api", who, bus, busWakeWr, pendCh)

    let deadline = epochMillis() + timeoutMs
    var out: string = ""
    while epochMillis() < deadline {
        match ch.tryRecv() {
            Option.Some(m) => {
                let mt = jStr(m, "type")
                if mt == awaitType {
                    out = m.clone()
                    break
                }
                // A rejected command never produces the awaited reply, so return
                // the refusal rather than burning the caller's whole timeout and
                // then reporting a useless {"error":"timeout"}.
                if mt == "configError" {
                    out = Json.obj().bool("ok", false).str("error", jStr(m, "error")).build()
                    break
                }
            }
            Option.None => {
                sleepMs(10)
            }
        }
    }
    sinkUnregister(clientId)
    unsafe {
        let _w2 = write(busWakeWr, one as *u8, 1)
        // wake[0] is never read here (the await polls tryRecv), and leaving it
        // open leaked one descriptor per api call: an agent stepping in a loop
        // walked the server into EMFILE.
        close(wake[0])
    }
    if out.len == 0 {
        return Json.obj().bool("ok", false).str("error", "timeout").str("awaited", awaitType).build()
    }
    return out
}

// ── R: the WS-reader task (entry point per debug WebSocket) ──

fn handleDebugWs(ws: WsConn, peerKind: string, bus: &Channel<string>, busWakeWr: i32, pendCh: &Channel<Pending>): void {
    var conn = ws

    let ch = Channel<string>.new(256)!
    var wake: [i32; 2] = [0; 2]
    unsafe {
        if pipe(wake as *i32) != 0 {
            return
        }
    }
    let wakeRd = wake[0]
    let wakeWr = wake[1]
    let wfd = conn.fd
    // Channel handles are refcounted and @send: the writer task outlives this
    // frame, so it gets its own retained handle (as does the registry's Sink).
    let writerCh = ch.clone()
    Task.spawn(move(): void => {
        wsWriterLoop(wfd, writerCh, wakeRd)
    }
    )

    // join the shared session. Register with the broadcaster, then replay
    // current state directly onto our own sink — no yield point in between,
    // so the replay is ordered before any subsequent broadcast fanout.
    let clientId = gNextClient
    gNextClient = gNextClient + 1
    sinkRegister(clientId, ch, wakeWr)
    gPeers = gPeers + 1
    logEvent("peer connected", $"{peerKind}  {peerCountStr()}")
    var one: [u8; 1] = [110; 1]
    unsafe {
        let _w1 = write(busWakeWr, one as *u8, 1)
    }

    wsPush(ch, wakeWr, helloMsg())
    if srcPath.len > 0 {
        wsPush(ch, wakeWr, sourceMsg(srcPath))
    }
    if gCapsMsg.len > 0 {
        wsPush(ch, wakeWr, gCapsMsg.clone())
    }
    for bp in gBps {
        wsPush(ch, wakeWr, bpSyncMsg(bp))
    }
    if gStopMsg.len > 0 {
        wsPush(ch, wakeWr, gStopMsg.clone())
    }
    if gThreadsMsg.len > 0 {
        wsPush(ch, wakeWr, gThreadsMsg.clone())
    }
    if gRegionsMsg.len > 0 {
        wsPush(ch, wakeWr, gRegionsMsg.clone())
    }
    // replay buffered terminal history. Flagged so a same-session reconnect
    // (which kept its scrollback) can drop it; a fresh/new-session tab renders it.
    for outLine in gOutputLog {
        wsPush(ch, wakeWr, Json.obj().str("type", "output").str("text", outLine.text.clone()).str("category", outLine.category.clone()).bool("replay", true).build())
    }

    while true {
        var payload: string = ""
        match conn.recv() {
            Result.Ok(m) => {
                payload = m.payload
            }
            Result.Err(_e) => {
                break
            }
        }

        dispatchClientCmd(payload.clone(), peerKind.clone(), peerKind.clone(), bus, busWakeWr, pendCh)
    }

    // Leave the shared session; sinkUnregister closes our wake fd.
    sinkUnregister(clientId)
    unsafe {
        let _w2 = write(busWakeWr, one as *u8, 1)
    }
    gPeers = gPeers - 1
    gLastActivityMs = epochMillis()
    logEvent("peer disconnected", $"{peerKind}  {peerCountStr()}")
}

// ── Idle TTL (session GC) ──

// OS-thread ticker: the green scheduler blocks in kevent with no timeout, so
// time-based wakeups need an external poke. Raw usleep + pipe write only — no
// runtime calls here (the scheduler pointer is a plain global, not
// thread-local, so std sleep/yield on a foreign thread would corrupt it).
fn tickerMain(): i64 {
    while true {
        unsafe {
            let _s = usleep((gTickUsecs & 0xffffffff) as u32)
            var one: [u8; 1] = [116; 1]
            let _w = write(gTickWr, one as *u8, 1)
        }
    }
    return 0
}

// Green task: parks on the tick pipe; a session with no peers for the TTL is
// ended via the same disconnect(terminateDebuggee) path as the kill command —
// D's terminated/EOF handling resets session state for a later fresh run.
fn reaperLoop(tickRd: i32, pendCh: Channel<Pending>): void {
    var buf: [u8; 8] = [0; 8]
    while true {
        var n: i64 = 0
        unsafe {
            schedulerWaitRead(tickRd)
            n = read(tickRd, buf as *u8, 8)
        }
        if n <= 0 {
            break
        }
        if !gStarted || gPeers > 0 || gDapIn < 0 {
            continue
        }
        if epochMillis() - gLastActivityMs < gIdleTtlSecs * 1000 {
            continue
        }
        logEvent("session idle", $"no peers for {gIdleTtlSecs}s — terminating debuggee")
        gOddSeq = gOddSeq + 2
        let _p = pendCh.trySend(Pending {
            seq: gOddSeq, kind: "disc", id: 0, extra: ""
        }
        )
        sendReqFd(gDapIn, gOddSeq, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    }
}

// ── HTTP plumbing ──

fn sendHttp(fd: i32, status: i32, contentType: &string, body: &string): void {
    var statusText: string = "200 OK"
    if status == 404 {
        statusText = "404 Not Found"
    }
    var resp: string = "HTTP/1.1 " + statusText + "\r\n"
    resp = resp + "Content-Type: " + contentType + "\r\n"
    resp = resp + "Content-Length: " + body.len.toString() + "\r\n"
    resp = resp + "Connection: close\r\n\r\n"
    resp = resp + body
    // Accepted fds are non-blocking under the green runtime: a single write()
    // stops at the socket buffer (~half a MB of app.js got dropped this way).
    // Loop with scheduler parking until the whole response is out.
    var sent: i64 = 0
    while sent < resp.len {
        let chunk = resp.substr(sent, resp.len)
        var n: i64 = 0
        unsafe {
            n = write(fd, chunk, chunk.len)
        }
        if n < 0 {
            if getErrno() == eagain() {
                schedulerWaitWrite(fd)
                continue
            }
            return
        }
        sent = sent + n
    }
}

// UI assets are embedded, so the binary is self-contained: a downloaded release
// runs from any cwd with nothing next to it. Embedding the whole ~5.8MB bundle
// costs ~0.4s of build time — the old "byte-array emission dominates compile
// time" concern (papercut #7) no longer holds. --webroot still overrides for UI
// iteration: rebuild the bundle, refresh the page, no server rebuild.
//
// A renamed build.sh output breaks the build here rather than at runtime, which
// is the point: a missing asset is a compile error, not a 404 in the browser.
fn embeddedAsset(p: &string): Option<string> {
    if p == "/index.html" {
        return Option.Some(@embedFile("ui/dist/index.html"))
    }
    if p == "/app.js" {
        return Option.Some(@embedFile("ui/dist/app.js"))
    }
    if p == "/app.css" {
        return Option.Some(@embedFile("ui/dist/app.css"))
    }
    if p == "/editor.worker.js" {
        return Option.Some(@embedFile("ui/dist/editor.worker.js"))
    }
    if p == "/json.worker.js" {
        return Option.Some(@embedFile("ui/dist/json.worker.js"))
    }
    if p == "/favicon.svg" {
        return Option.Some(@embedFile("ui/dist/favicon.svg"))
    }
    if p == "/og.png" {
        return Option.Some(@embedFile("ui/dist/og.png"))
    }
    return Option.None
}
fn mimeFor(path: &string): string {
    var ext: string = ""
    var i: i64 = path.len - 1
    while i >= 0 && path[i] != '/' {
        if path[i] == '.' {
            ext = path.substr(i, path.len)
            break
        }
        i = i - 1
    }
    if ext == ".html" {
        return "text/html; charset=utf-8"
    }
    if ext == ".js" {
        return "application/javascript"
    }
    if ext == ".css" {
        return "text/css"
    }
    if ext == ".map" || ext == ".json" {
        return "application/json"
    }
    if ext == ".svg" {
        return "image/svg+xml"
    }
    if ext == ".png" {
        return "image/png"
    }
    if ext == ".wasm" {
        return "application/wasm"
    }
    if ext == ".ttf" {
        return "font/ttf"
    }
    return "application/octet-stream"
}

fn lowerByte(c: u8): u8 {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}

// Value of an HTTP header (name must be lowercase); "" if absent.
fn headerVal(raw: &string, name: &string): string {
    var i: i64 = 0
    while i < raw.len {
        var j: i64 = 0
        var m = true
        while j < name.len {
            if i + j >= raw.len || lowerByte(raw[i + j]) != name[j] {
                m = false break
            }
            j = j + 1
        }
        if m && i + j < raw.len && raw[i + j] == ':' {
            var k = i + j + 1
            while k < raw.len && raw[k] == ' ' {
                k = k + 1
            }
            var v: string = ""
            while k < raw.len && raw[k] != '\r' && raw[k] != '\n' {
                v.push(raw[k])
                k = k + 1
            }
            return v
        }
        while i < raw.len && raw[i] != '\n' {
            i = i + 1
        }
        i = i + 1
    }
    return ""
}

fn replaceAll(s: &string, needle: &string, repl: &string): string {
    var out: string = ""
    var i: i64 = 0
    while i < s.len {
        var m = false
        if i + needle.len <= s.len {
            m = true
            var j: i64 = 0
            while j < needle.len {
                if s[i + j] != needle[j] {
                    m = false break
                }
                j = j + 1
            }
        }
        if m {
            out = out + repl
            i = i + needle.len
        } else {
            out.push(s[i])
            i = i + 1
        }
    }
    return out
}

fn serveStatic(fd: i32, reqPath: &string, origin: &string): void {
    var p = reqPath.clone()
    var qi: i64 = 0
    while qi < p.len {
        if p[qi] == '?' {
            p = p.substr(0, qi)
            break
        }
        qi = qi + 1
    }
    // The dashboard is a route of the same single-page bundle, so it resolves to
    // index.html and App.tsx branches on the pathname. A second HTML entry point
    // would mean a second bundle to keep in sync for one extra screen.
    if p == "/" || p == "/sessions" {
        p = "/index.html"
    }
    // No parent traversal out of the webroot.
    var di: i64 = 0
    while di + 1 < p.len {
        if p[di] == '.' && p[di + 1] == '.' {
            sendHttp(fd, 404, "text/plain", "not found")
            return
        }
        di = di + 1
    }
    // --webroot wins when set, so UI work does not need a server rebuild;
    // otherwise serve the copy compiled into this binary.
    var body: string = ""
    if webroot.len > 0 {
        match readFile(webroot + p) {
            Result.Ok(disk) => {
                body = disk
            }
            Result.Err(_e) => {
                sendHttp(fd, 404, "text/plain", "not found")
                return
            }
        }
    } else {
        match embeddedAsset(p) {
            Option.Some(embedded) => {
                body = embedded
            }
            Option.None => {
                sendHttp(fd, 404, "text/plain", "not found")
                return
            }
        }
    }
    if p == "/index.html" {
        // og:image/og:url need absolute URLs (unfurlers reject
        // relative) but the host varies (localhost/LAN/tunnel):
        // inject the request's own origin.
        sendHttp(fd, 200, mimeFor(p), replaceAll(body, "__ORIGIN__", origin))
    } else {
        sendHttp(fd, 200, mimeFor(p), body)
    }
}

struct RequestLine {
    method: string, path: string
}

fn parseRequestLine(raw: &string): RequestLine {
    var i: i64 = 0
    while i < raw.len && raw[i] != ' ' {
        i = i + 1
    }
    let method = raw.substr(0, i)
    while i < raw.len && raw[i] == ' ' {
        i = i + 1
    }
    let uriStart = i
    while i < raw.len && raw[i] != ' ' {
        i = i + 1
    }
    let path = raw.substr(uriStart, i)
    return RequestLine {
        method: method, path: path
    }
}

fn handleConnection(fd: i32, bus: Channel<string>, busWakeWr: i32, pendCh: Channel<Pending>): void {
    var buf: [u8; 8192] = [0; 8192]
    unsafe {
        schedulerWaitRead(fd)
        let n = read(fd, buf as *u8, 8192)
        if n <= 0 {
            close(fd)
            return
        }
        var raw: string = ""
        for i in 0..n {
            raw.push(buf[i])
        }

        let rl = parseRequestLine(raw)
        if isWsUpgrade(raw) {
            // Peer kind rides the upgrade path's query string: browsers
            // hit /ws bare, other clients pass ?client=<kind> — known
            // before the first frame, so connect logs carry the right kind.
            var wsPath = rl.path.clone()
            var query: string = ""
            var qi2: i64 = 0
            while qi2 < wsPath.len {
                if wsPath[qi2] == '?' {
                    query = wsPath.substr(qi2 + 1, wsPath.len)
                    wsPath = wsPath.substr(0, qi2)
                    break
                }
                qi2 = qi2 + 1
            }
            if wsPath == "/ws" {
                var kind: string = "browser"
                if query.startsWith("client=") {
                    kind = query.substr(7, query.len)
                }
                match wsAccept(fd, raw) {
                    Result.Ok(ws) => {
                        handleDebugWs(ws, kind, bus, busWakeWr, pendCh)
                    }
                    Result.Err(_e) => {
                        close(fd)
                    }
                }
            } else {
                close(fd)
            }
            return
        }

        // ── HTTP API (same command vocabulary as the WS the browser speaks) ──
        var apiPath = rl.path.clone()
        var apiQuery: string = ""
        var qi3: i64 = 0
        while qi3 < apiPath.len {
            if apiPath[qi3] == '?' {
                apiQuery = apiPath.substr(qi3 + 1, apiPath.len)
                apiPath = apiPath.substr(0, qi3)
                break
            }
            qi3 = qi3 + 1
        }
        if apiPath == "/api/state" {
            sendHttp(fd, 200, "application/json", apiStateJson())
            close(fd)
            return
        }
        // Reports on the configured target only, with no path parameter: the API
        // port is unauthenticated, and a caller-supplied path would make this an
        // arbitrary-file header reader.
        if apiPath == "/api/processes" {
            sendHttp(fd, 200, "application/json", processListJson())
            close(fd)
            return
        }
        // Every live dapweb on this machine, for the /sessions dashboard. Reads
        // the same registry `dapweb api list` does, and prunes it on the way.
        if apiPath == "/api/sessions" {
            sendHttp(fd, 200, "application/json", sessionsJson(gSessionId))
            close(fd)
            return
        }
        if apiPath == "/api/spawn" {
            if rl.method != "POST" {
                sendHttp(fd, 405, "application/json", Json.obj().bool("ok", false).str("error", "POST required").build())
                close(fd)
                return
            }
            sendHttp(fd, 200, "application/json", spawnSessionJson())
            close(fd)
            return
        }
        if apiPath == "/api/binfo" {
            sendHttp(fd, 200, "application/json", binInfoJson(binPath))
            close(fd)
            return
        }
        if apiPath == "/api/cmd" {
            if rl.method != "POST" {
                sendHttp(fd, 405, "application/json", Json.obj().bool("ok", false).str("error", "POST required").build())
                close(fd)
                return
            }
            // Body follows the header terminator. Small JSON commands arrive in the
            // first read; keep pulling while the declared length is short.
            var body: string = ""
            var hi: i64 = 0
            while hi + 3 < raw.len {
                if raw[hi] == '\r' && raw[hi + 1] == '\n' && raw[hi + 2] == '\r' && raw[hi + 3] == '\n' {
                    body = raw.substr(hi + 4, raw.len)
                    break
                }
                hi = hi + 1
            }
            // Absent/garbage content-length reads as 0, same as the old parser: the
            // body is whatever already arrived.
            let want = headerVal(raw, "content-length").parseInt() ?? (0 as i64)
            while body.len < want {
                var more: [u8; 8192] = [0; 8192]
                schedulerWaitRead(fd)
                let n2 = read(fd, more as *u8, 8192)
                if n2 <= 0 {
                    break
                }
                for j in 0..n2 {
                    body.push(more[j])
                }
            }
            var timeoutMs = queryParam(apiQuery, "timeout").parseInt() ?? (0 as i64)
            if timeoutMs <= 0 {
                timeoutMs = 5000
            }
            let reply = apiRunCmd(body, queryParam(apiQuery, "await"), timeoutMs, apiWho(apiQuery), bus, busWakeWr, pendCh)
            sendHttp(fd, 200, "application/json", reply)
            close(fd)
            return
        }

        if rl.method == "GET" {
            var host = headerVal(raw, "host")
            if host.len == 0 {
                host = "localhost"
            }
            // Tunnels (cloudflared/ngrok) terminate TLS and set this.
            var proto = headerVal(raw, "x-forwarded-proto")
            if proto.len == 0 {
                proto = "http"
            }
            serveStatic(fd, rl.path, proto + "://" + host)
        } else {
            sendHttp(fd, 404, "text/plain", "not found")
        }
        close(fd)
    }
}

fn acceptLoop(listener: TcpListener, bus: Channel<string>, busWakeWr: i32, pendCh: Channel<Pending>): void {
    var l = listener
    while true {
        match l.accept() {
            Result.Ok(conn) => {
                var c = conn
                let fd = c.take()
                let connBus = bus.clone()
                let connPend = pendCh.clone()
                Task.spawn(move(): void => {
                    handleConnection(fd, connBus, busWakeWr, connPend)
                }
                )
            }
            Result.Err(_e) => {
                schedulerYield()
            }
        }
    }
}

// Best-effort: pop the default browser open at the served URL. Fire-and-forget —
// a headless box (no xdg-open/open, or DAPWEB_NO_OPEN set) just skips silently.
// The whole thing is backgrounded inside the shell so sh returns instantly and
// wait() reaps it without stalling startup; the real opener reparents to init.
fn openBrowser(url: &string): void {
    if Env.getOr("DAPWEB_NO_OPEN", "").len > 0 {
        return
    }
    var args: Vec<string> = []
    args.push("-c")
    // xdg-open on Linux, open on macOS — whichever exists.
    args.push($"command -v xdg-open >/dev/null 2>&1 && xdg-open '{url}' || open '{url}' >/dev/null 2>&1 &")
    if let Result.Ok(child) = Child.spawn("sh", args, true) {
        let _ = child.wait()
    }
}


// Subcommand entrypoint: dispatched from src/main.milo as `dapweb web ...`.
// argv[0] is the display name (skipped by parseFrom); the rest are the web flags.
pub fn webMain(argv: Vec<string>): i32 {
    ignoreSignal(SIGPIPE)
    Q = "\""
    var parser = ArgParser.new("dapweb web", "web UI for any DAP debugger. Serves a shared session: any number of browser tabs see and drive the same debuggee, and `dapweb api` drives it from the CLI.")
    // No default target: boot idle and let the browser configure it (⚙ drawer).
    parser.addString("program", "p", "path to the debuggee binary (optional; configure in the browser if omitted)", "")
    // optional — the debuggee's DWARF knows its sources; the first stop's
    // frame path fills the editor. The flag only pre-loads a file for
    // before-launch breakpoints.
    parser.addString("source", "s", "main source file (optional; auto-detected from the first stop)", "")
    parser.addString("dapPath", "a", "DAP adapter command (stdio); a launch config's \"dapPath\" overrides", "lldb-dap")
    parser.addI64("port", "", "listen port", 8080)
    parser.addI64("idle-ttl", "", "end the debug session after this many seconds with no ws peers attached (0 = never)", 86400)
    parser.addString("webroot", "w", "serve the UI from this dir instead of the copy embedded in the binary (UI dev: src/web/ui/build.sh)", "")
    parser.addBool("no-browser", "", "do not open a browser tab at startup (headless hosts, and servers spawned by another dapweb)")
    parser.addBool("quiet", "q", "suppress session event log lines (banner only)")
    parser.addBool("verbose", "v", "log stops and steps too (noisy)")
    // A full VS Code launch configuration (inline JSON object or a file path —
    // a single config or a whole {version, configurations:[...]} launch.json).
    parser.addString("launch", "l", "launch configuration (inline JSON object or path to a JSON file): a VS Code launch config — \"type\"/\"request\"/\"program\"/\"args\"/\"env\"/\"cwd\" plus any adapter-specific keys, or a full {version, configurations:[...]} launch.json", "")
    parser.addString("config", "c", "configuration name to select when --launch is a {configurations:[...]} file (default: first entry)", "")
    let args = parser.parseFrom(argv)
    // getString is None only when the flag is absent AND its registered default
    // is empty, so `?? ""` is exactly the value the old string-returning API gave.
    binPath = args.getString("program") ?? ""
    // Canonical from the start: bp paths go through absSourcePath, so a relative
    // --source would have the browser keying its gutter on a spelling the
    // breakpoint acks never use.
    srcPath = absSourcePath(args.getString("source") ?? "")
    webroot = args.getString("webroot") ?? ""
    gNoBrowser = args.getBool("no-browser")
    gLogLevel = 1
    if args.getBool("quiet") {
        gLogLevel = 0
    }
    if args.getBool("verbose") {
        gLogLevel = 2
    }
    // Read + syntax-check --launch now (fail fast); applied via applyConfig
    // after the session globals are initialized below.
    let launchArg = args.getString("launch") ?? ""
    var launchText: string = ""
    if launchArg.len > 0 {
        launchText = launchArg.clone()
        if launchArg[0] != '{' {
            match readFile(launchArg) {
                Result.Ok(t) => {
                    launchText = t
                }
                Result.Err(_e) => {
                    eprint($"error: --launch file not readable: {launchArg}\n")
                    return 1
                }
            }
        }
        match Json.parseJsonc(launchText.clone()) {
            Result.Ok(doc) => {
                if !doc.isObject() {
                    eprint("error: --launch must be a JSON object\n")
                    return 1
                }
            }
            Result.Err(e) => {
                eprint($"error: --launch is not valid JSON: {e}\n")
                return 1
            }
        }
    }
    // An explicit --webroot must exist; without one the embedded bundle always does.
    if webroot.len > 0 && !pathExists(webroot + "/index.html") {
        eprint($"error: --webroot {webroot} has no index.html — run src/web/ui/build.sh, or drop the flag to use the embedded UI\n")
        return 1
    }
    let adapterArg = args.getString("dapPath") ?? "lldb-dap" // mirrors the addString default
    let sel = resolveAdapterCmd(adapterArg)
    adapterCmd = sel.cmd
    adapterKind = sel.kind
    let port = args.getI64("port")

    // Shared session: one bus, one broadcaster, any number of peers.
    gStarted = false
    gHistory = "[]"
    gRestored = false
    gDapIn = -1
    gPtyFd = -1
    gOddSeq = -1 as i64
    gStdinBuf = ""
    gCapsMsg = ""
    gStopMsg = ""
    gThreadsMsg = ""
    gRegionsMsg = ""
    gNextClient = 1
    gBps = []
    gPendingConfig = ""
    gPendingStopAtMain = false
    gPendingRun = false
    gConfigStopAtMain = false
    gConfigName = ""
    gDapPathRaw = ""
    gRequest = ""
    gDapHost = ""
    gDapPort = 0
    gSessionId = newSessionName(sessionNameSeeds())
    gPeers = 0
    gLastActivityMs = epochMillis()
    gIdleTtlSecs = args.getI64("idle-ttl")

    // Apply a --launch config through the same path as every other config
    // (wrapper unwrap + --config name select + validation), CLI flags gap-filled.
    if launchText.len > 0 {
        let err = applyConfig(mergeCliDefaults(launchText, binPath, srcPath), args.getString("config") ?? "")
        if err.len > 0 {
            eprint($"error: --launch: {err}\n")
            return 1
        }
    } else if binPath.len > 0 && adapterArg == "lldb-dap" {
        // --program alone: the dapPath default hardwires lldb, but a .js/.py/.go
        // program names its own dialect — route through the config path so the
        // right adapter is probed. Best-effort like the history restore: a probe
        // miss leaves the session idle and the run command reports it.
        var b = Json.obj().str("program", binPath.clone())
        if srcPath.len > 0 {
            b = b.str("source", srcPath.clone())
        }
        let err = applyConfig(b.build(), "")
        if err.len > 0 {
            eprint($"warning: {err}\n")
        }
    }

    // History always loads (hello carries it). Boot restore, unconditional: with
    // no --program, stage history[0] as the session config (idle, not launched) so
    // a fresh browser lands on the last thing debugged. Best-effort — a restored
    // entry whose program/adapter is gone just leaves the session idle.
    loadHistory()
    if binPath.len == 0 {
        match firstHistoryConfig() {
            Option.Some(cfg) => {
                if applyConfig(cfg, "").len == 0 {
                    gRestored = true
                }
            }
            Option.None => {
            }
        }
    }
    // Breakpoints come back only once the target is settled — they are keyed by
    // program, so this has to follow --program/--launch and the history restore.
    loadBps()
    let bus = Channel<string>.new(1024)!
    let pendCh = Channel<Pending>.new(64)!
    var busWake: [i32; 2] = [0; 2]
    unsafe {
        if pipe(busWake as *i32) != 0 {
            eprint("error: pipe failed\n")
            return 1
        }
    }
    let busWakeRd = busWake[0]
    let busWakeWr = busWake[1]
    let bcBus = bus.clone()
    Task.spawn(move(): void => {
        broadcastLoop(bcBus, busWakeRd)
    }
    )

    if gIdleTtlSecs > 0 {
        // 1s ticks for short (test) TTLs, 30s otherwise — reap latency ≤ ttl + tick.
        gTickUsecs = 30000000
        if gIdleTtlSecs <= 60 {
            gTickUsecs = 1000000
        }
        var tick: [i32; 2] = [0; 2]
        unsafe {
            if pipe(tick as *i32) != 0 {
                eprint("error: pipe failed\n")
                return 1
            }
        }
        let tickRd = tick[0]
        gTickWr = tick[1]
        let reapPend = pendCh.clone()
        Task.spawn(move(): void => {
            reaperLoop(tickRd, reapPend)
        }
        )
        // real OS thread (see tickerMain): fire-and-forget, never returns
        let _ticker = Promise<i64>.blocking(move(): i64 => {
            return tickerMain()
        }
        )
    }

    match TcpListener.bind(port as u16) {
        Result.Ok(listener) => {
            var l = listener
            print($"dapweb web UI → http://localhost:{port}")
            if binPath.len > 0 {
                if gRestored {
                    print($"  target:   {binPath}   ({adapterKind})   (restored — Run to launch)")
                } else {
                    print($"  target:   {binPath}   ({adapterKind})")
                }
                if srcPath.len > 0 {
                    print($"  source:   {srcPath}")
                }
            } else {
                print("  target:   (none — configure in the browser via the ⚙ drawer)")
            }
            print($"  drive:    dapweb api state --port {port}   (or: dapweb api run / step / eval ...)")
            print($"  sessions: http://localhost:{port}/sessions   (every live dapweb on this machine)")
            print("  docs:     https://github.com/milo-language/dapweb")
            registerSession(port)
            if gLogLevel >= 1 {
                print("")
            }
            flush()
            if !gNoBrowser {
                openBrowser($"http://localhost:{port}")
            }
            let acceptBus = bus.clone()
            let acceptPend = pendCh.clone()
            Task.spawn(move(): void => {
                acceptLoop(l, acceptBus, busWakeWr, acceptPend)
            }
            )
        }
        Result.Err(_e) => {
            print($"error: could not bind port {port}")
            return 1
        }
    }
    // Go exit semantics (milo dropped the implicit end-of-main scheduler drain):
    // drive the scheduler so the accept/broadcast/reaper loops keep running.
    // The server blocks here until the process is signalled.
    schedulerRunToCompletion()
    unregisterSession()
    return 0
}
