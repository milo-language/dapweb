fn adapterArgv(): Vec<string> {
    return adapterArgvOf(gSession.target.spec.adapterCmd)
}

// One client command (the `{"cmd": ...}` JSON the browser sends over WS), as a
// handler sees it. Factored out of the WS reader so the HTTP API drives the
// exact same verbs: one vocabulary, so `dapweb api` cannot drift from the UI.
struct Cmd {
    name: string,
    doc: Json, // the payload, parsed once
    payload: string, // setConfig hands the payload itself to applyConfig
    peerKind: string,
    bus: Channel<string>,
    pendCh: Channel<Pending>,
}

impl Cmd {
    fn str(self: &Self, key: &string): string {
        return self.doc.str(key) ?? ""
    }

    fn int(self: &Self, key: &string, fallback: i64): i64 {
        return self.doc.i64(key) ?? fallback
    }

    fn flag(self: &Self, key: &string, fallback: bool): bool {
        return self.doc.bool(key) ?? fallback
    }
}

// Send a DAP request whose response D routes back by `kind`; a no-op with no
// run live. Registered before the send: D drains pendings after each recv, so
// the entry must exist before the adapter can possibly reply, or the response
// is dropped unmatched.
fn sendPending(pendCh: &Channel<Pending>, kind: &string, id: i64, extra: string, command: &string, args: &string): void {
    if let Option.Some(dfd) = gSession.proc.dapIn {
        let seq = gSession.proc.nextSeq()
        let _p = pendCh.trySend(Pending {
            seq: seq, kind: kind.clone(), id: id, extra: extra
        }
        )
        sendReqFd(dfd, seq, command, args)
    }
}

// One human-readable line for what a command is about to do. Only the cases
// that can say something the table cannot (which line, which expression);
// everything else takes the table's verb, so there is no second list of
// commands here to fall behind the first.
fn activityText(cmd: &Cmd): string {
    if cmd.name == "evaluate" {
        return $"evaluate `{cmd.str("expr")}`"
    }
    if cmd.name == "setBreakpoint" {
        return $"set a breakpoint at line {cmd.int("line", 0 as i64)}"
    }
    if cmd.name == "clearBreakpoint" {
        return $"clear the breakpoint at line {cmd.int("line", 0 as i64)}"
    }
    if cmd.name == "setVar" {
        return $"set {cmd.str("name")} = {cmd.str("value")}"
    }
    return cmdVerb(cmd.name)
}

// Which file a command means, canonical. The breakpoint commands fall back to
// the session's source when the payload names none, and this is the only place
// that rule lives: the journal keys its breakpoint counts on the same answer the
// breakpoint itself is stored under, and two spellings of one path is exactly
// what would make those counts wrong.
fn cmdPath(c: &string, doc: &Json): string {
    var path = absSourcePath(doc.str("path") ?? "")
    if path.len == 0 && (c == "setBreakpoint" || c == "clearBreakpoint") {
        path = absSourcePath(gSession.target.spec.srcPath)
    }
    return path
}

// The handler for each command in ../commands' table. A known name with no arm
// here is refused like an unknown one. tests/e2e-commands.ts reads these arms
// to check that this match and the table agree in both directions.
fn cmdHandler(name: string): Option<(&Cmd) => void> {
    match name {
        "setBreakpoint" => { return Option.Some(cmdBreakpoint) }
        "clearBreakpoint" => { return Option.Some(cmdBreakpoint) }
        "run" => { return Option.Some(cmdRun) }
        "continue" => { return Option.Some(cmdStep) }
        "stepOver" => { return Option.Some(cmdStep) }
        "stepIn" => { return Option.Some(cmdStep) }
        "stepOut" => { return Option.Some(cmdStep) }
        "pause" => { return Option.Some(cmdStep) }
        "restart" => { return Option.Some(cmdRestart) }
        "kill" => { return Option.Some(cmdKill) }
        "evaluate" => { return Option.Some(cmdEvaluate) }
        "expand" => { return Option.Some(cmdExpand) }
        "threadStack" => { return Option.Some(cmdThreadStack) }
        "frameScopes" => { return Option.Some(cmdFrameScopes) }
        "setExceptions" => { return Option.Some(cmdSetExceptions) }
        "complete" => { return Option.Some(cmdComplete) }
        "readMem" => { return Option.Some(cmdReadMem) }
        "setVar" => { return Option.Some(cmdSetVar) }
        "disassemble" => { return Option.Some(cmdDisassemble) }
        "openSource" => { return Option.Some(cmdOpenSource) }
        "stdin" => { return Option.Some(cmdStdin) }
        "resize" => { return Option.Some(cmdResize) }
        "setConfig" => { return Option.Some(cmdSetConfig) }
        "importHistory" => { return Option.Some(cmdImportHistory) }
        "newSession" => { return Option.Some(cmdNewSession) }
        _ => { return Option.None }
    }
}

// None when the command ran; Some(the refused name) otherwise. A caller that
// answers over HTTP needs that: an unknown `cmd` used to fall off the end of the if-chain, do
// nothing, and still be answered {"ok":true}, so an agent's typo looked exactly
// like success. The check comes BEFORE the activity announcement too — telling
// the human "the agent is attempting to frobnicate" about a command that will
// not run is worse than saying nothing.
fn dispatchClientCmd(payload: string, peerKind: string, peerLabel: string, bus: &Channel<string>, pendCh: &Channel<Pending>): Option<string> {
    let Result.Ok(doc) = Json.parse(payload) else {
        journalCmd("", peerKind, peerLabel, false, "not a dapweb command", payload, "")
        return Option.Some("")
    }
    let c = doc.str("cmd") ?? ""
    var handler: Option<(&Cmd) => void> = Option.None
    if isKnownCmd(c) {
        handler = cmdHandler(c.clone())
    }
    let Option.Some(run) = handler else {
        journalCmd(c, peerKind, peerLabel, false, "not a dapweb command", payload, "")
        return Option.Some(c.clone())
    }
    journalCmd(c, peerKind, peerLabel, true, "", payload, cmdPath(c, doc))
    let cmd = Cmd {
        name: c, doc: doc, payload: payload, peerKind: peerKind,
        bus: bus.clone(), pendCh: pendCh.clone(),
    }
    // A browser peer's actions are self-evident to whoever performed them; an
    // agent's are not. Announce before acting, so the human watching the UI is
    // never surprised by a program that moves on its own.
    if cmd.peerKind != "browser" {
        let what = activityText(cmd)
        logEvent("agent", $"{peerLabel} is attempting to {what}")
        wsPush(bus, Json.obj().str("type", "activity")
            .str("peer", cmd.peerKind).str("who", peerLabel).str("cmd", cmd.name)
            .str("text", $"{peerLabel} is attempting to {what}").build())
    }
    run(cmd)
    return Option.None
}

fn cmdBreakpoint(cmd: &Cmd): void {
    let set = cmd.name == "setBreakpoint"
    let line = cmd.int("line", 0 as i64)
    let path = cmdPath(cmd.name, cmd.doc)
    // Upsert: drop any existing bp at (path, line), then re-add for
    // "set" (a condition edit is a set on an existing line).
    var keep: Vec<Bp> = []
    for bp in gSession.persisted.bps {
        if bp.line != line || bp.path != path {
            keep.push(cloneBp(bp))
        }
    }
    gSession.persisted.bps = keep
    // For a set this is the stored breakpoint; for a clear a bare (path, line)
    // is all a peer needs to drop its own copy.
    let bp = Bp {
        path: path.clone(), line: line,
        condition: cmd.str("condition"),
        hitCondition: cmd.str("hitCondition"),
        logMessage: cmd.str("logMessage"),
        enabled: cmd.flag("enabled", true),
    }
    if set {
        gSession.persisted.bps.push(cloneBp(bp))
    }
    persistBps()
    wsPush(cmd.bus, bpAckMsg(bp, set))
    sendPending(cmd.pendCh, "bpLive", 0, "", "setBreakpoints", buildBpArgsForPath(gSession.persisted.bps, path))
}

// The editor is the source of truth: an inline `config` object rides the run
// and is applied just before launch, no staging. A live session requires
// force:true (the client confirms with the user), which kills it and reruns
// with the new config after teardown.
fn cmdRun(cmd: &Cmd): void {
    var cfgRaw: string = ""
    if let Option.Some(v) = cmd.doc.get("config") {
        if v.isObject() {
            cfgRaw = v.rawStr()
        }
    }
    if gSession.proc.started {
        if !cmd.flag("force", false) || gSession.proc.dapIn.isNone() {
            wsPush(cmd.bus, configErrMsg("a debug session is already active — run with force:true to kill and relaunch"))
            return
        }
        var pcfg: Option<string> = Option.None
        if cfgRaw.len > 0 {
            pcfg = Option.Some(cfgRaw)
        }
        gSession.proc.pendingRun = Option.Some(PendingRun {
            config: pcfg, stopAtMain: cmd.flag("stopAtMain", gSession.target.spec.stopAtMain),
        }
        )
        logEvent("run killed", $"forced by {cmd.peerKind} peer — relaunching")
        sendPending(cmd.pendCh, "disc", 0, "", "disconnect", Json.obj().bool("terminateDebuggee", true).build())
        return
    }
    if cfgRaw.len > 0 {
        let err = applyConfig(cfgRaw, "")
        if err.len > 0 {
            wsPush(cmd.bus, configErrMsg(err))
            return
        }
        logEvent("target changed", $"{gSession.target.spec.binPath}  (by {cmd.peerKind} peer)")
        loadBps()
        pushHelloState(cmd.bus)
    }
    if gSession.target.spec.binPath.len == 0 && gSession.target.spec.request != "attach" {
        // Booted idle with no target: nudge to the config drawer instead
        // of spawning the adapter with an empty program path.
        wsPush(cmd.bus, configErrMsg("no program configured — set a debug target (⚙) before running"))
        return
    }
    // After applyConfig: the payload's flag falls back to the NEW config's default.
    gSession.target.stopAtMain = cmd.flag("stopAtMain", gSession.target.spec.stopAtMain)
    let _ok = startRun(cmd.bus, cmd.pendCh)
}

// continue, the three steps, and pause.
fn cmdStep(cmd: &Cmd): void {
    let pause = cmd.name == "pause"
    if !pause {
        gSession.stop.resume()
    }
    let Option.Some(dfd) = gSession.proc.dapIn else {
        return
    }
    let t = cmd.int("tid", 1 as i64)
    if pause && t < 0 {
        // Attach flow: Pause can arrive before any stop, so
        // there's no tid yet — ask for threads and pause the first.
        sendPending(cmd.pendCh, "thrPause", 0, "", "threads", "{}")
        return
    }
    var dapCmd = cmd.name.clone()
    if cmd.name == "stepOver" {
        dapCmd = "next"
    }
    var b = Json.obj().int("threadId", t)
    // instruction-granularity stepping from the asm pane.
    let gran = cmd.str("granularity")
    if gran.len > 0 {
        b = b.str("granularity", gran)
    }
    let seq = gSession.proc.nextSeq()
    sendReqFd(dfd, seq, dapCmd, b.build())
}

// Native restart: the adapter re-launches with the same launch config; the bps
// and the stop-at-main function bp persist. The UI gates this on
// supportsRestartRequest (kill+rerun is its fallback). A config change is a Run
// (force-kills), not a restart.
fn cmdRestart(cmd: &Cmd): void {
    gSession.stop.resume()
    sendPending(cmd.pendCh, "restartR", 0, "", "restart", "{}")
}

// End the session: the adapter tears down the debuggee and exits; the reader
// loop's terminated/EOF path re-arms `run`.
fn cmdKill(cmd: &Cmd): void {
    logEvent("kill requested", $"(by {cmd.peerKind} peer)")
    sendPending(cmd.pendCh, "disc", 0, "", "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    // The child session debugs the process; the PARENT is what spawned it.
    // Disconnecting only the child leaves the program running with nobody
    // attached, which reads in the UI as "killed" and is not.
    if let Option.Some(pfd) = gSession.proc.parentIn {
        sendReqFd(pfd, gSession.proc.oddSeq + 1, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    }
}

fn cmdEvaluate(cmd: &Cmd): void {
    var b = Json.obj().str("expression", cmd.str("expr")).str("context", cmd.str("context"))
    let frameId = cmd.int("frameId", -1 as i64)
    if frameId >= 0 {
        b = b.int("frameId", frameId)
    }
    sendPending(cmd.pendCh, "eval", cmd.int("id", 0 as i64), "", "evaluate", b.build())
}

fn cmdExpand(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "expand", cmd.int("id", 0 as i64), "", "variables", Json.obj().int("variablesReference", cmd.int("ref", 0 as i64)).build())
}

// Stack for a clicked thread; the UI then drives frameScopes for its locals
// like any other frame selection.
fn cmdThreadStack(cmd: &Cmd): void {
    let t = cmd.int("tid", 1 as i64)
    sendPending(cmd.pendCh, "tst", cmd.int("id", 0 as i64), t.toString(), "stackTrace", Json.obj().int("threadId", t).int("startFrame", 0).int("levels", 20).build())
}

// Locals for a user-selected stack frame.
fn cmdFrameScopes(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "fsc", cmd.int("id", 0 as i64), "", "scopes", Json.obj().int("frameId", cmd.int("frameId", 0 as i64)).build())
}

// Selected exception filter ids. Kept on the target so session init applies
// them; live-applied when a session is running.
fn cmdSetExceptions(cmd: &Cmd): void {
    var arr = Json.arr()
    let f = cmd.doc.curField(cmd.doc.curRoot(), "filters")
    for i in 0..cmd.doc.curLen(f) {
        arr = arr.str(cmd.doc.curStr(cmd.doc.curChild(f, i)) ?? "")
    }
    gSession.target.excFilters = Option.Some(arr.build())
    sendPending(cmd.pendCh, "ebLive", 0, "", "setExceptionBreakpoints", excArgs())
}

// Debug-console completions.
fn cmdComplete(cmd: &Cmd): void {
    var b = Json.obj().str("text", cmd.str("text")).int("column", cmd.int("column", 1 as i64))
    let frameId = cmd.int("frameId", -1 as i64)
    if frameId >= 0 {
        b = b.int("frameId", frameId)
    }
    sendPending(cmd.pendCh, "cmpl", cmd.int("id", 0 as i64), "", "completions", b.build())
}

// Raw memory window. memoryReference is whatever the UI got from a
// value/ipRef; lldb-dap accepts plain hex addresses.
fn cmdReadMem(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "readmem", cmd.int("id", 0 as i64), "", "readMemory", Json.obj().str("memoryReference", cmd.str("memoryReference")).int("offset", cmd.int("offset", 0 as i64)).int("count", cmd.int("count", 256 as i64)).build())
}

// Edit a variable. ref = parent container (scope ref for top-level locals, the
// variable's own ref for expanded children).
fn cmdSetVar(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "setv", cmd.int("id", 0 as i64), "", "setVariable", Json.obj().int("variablesReference", cmd.int("ref", 0 as i64)).str("name", cmd.str("name")).str("value", cmd.str("value")).build())
}

// Window of instructions around a frame's pc (memoryReference = the frame's
// instructionPointerReference from stackTrace).
fn cmdDisassemble(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "disasm", cmd.int("id", 0 as i64), "", "disassemble", Json.obj().str("memoryReference", cmd.str("memoryReference")).int("instructionOffset", -16).int("instructionCount", 64).bool("resolveSymbols", true).build())
}

// Show the file a clicked frame lives in. sourceMsg itself handles unreadable
// pseudo-paths (dyld etc.) with a placeholder.
fn cmdOpenSource(cmd: &Cmd): void {
    let p = cmd.str("path")
    if p.len > 0 {
        wsPush(cmd.bus, sourceMsg(p))
    }
}

fn cmdStdin(cmd: &Cmd): void {
    let data = cmd.str("data")
    // writeOnce, not write: this runs on a peer's reader task, and parking
    // it until a debuggee that never reads stdin drains the pty would stall
    // every command that peer sends after it. A full pty drops input, as the
    // raw write here always did.
    if let Option.Some(p) = replace(gSession.proc.pty, Option.None) {
        let _n = p.writeOnce(data)
        gSession.proc.pty = Option.Some(p)
    } else {
        gSession.proc.stdinBuf = gSession.proc.stdinBuf + data
    }
}

fn cmdResize(cmd: &Cmd): void {
    let rows = cmd.int("rows", 0 as i64)
    let cols = cmd.int("cols", 0 as i64)
    // winsize fields are u16; anything outside is a bad payload, not a size.
    if rows <= 0 || cols <= 0 || rows >= 65536 || cols >= 65536 {
        return
    }
    gSession.proc.term = Option.Some(TermSize {
        rows: rows, cols: cols
    }
    )
    if let Option.Some(p) = replace(gSession.proc.pty, Option.None) {
        var pty = p
        let _r = pty.resize(rows as u16, cols as u16)
        gSession.proc.pty = Option.Some(pty)
    }
}

// config = a VS Code launch-configuration object (see applyConfig). The browser
// applies configs inline on Run; setConfig is the programmatic path (`dapweb
// api` callers). Idle-only: a live session must be force-run to change target
// (setConfig never kills a debuggee).
fn cmdSetConfig(cmd: &Cmd): void {
    if gSession.proc.started {
        wsPush(cmd.bus, configErrMsg("a debug session is active — stop it (or Run with force) to change the target"))
        return
    }
    let err = applyConfig(cmd.payload.clone(), "")
    if err.len > 0 {
        wsPush(cmd.bus, configErrMsg(err))
        return
    }
    logEvent("target changed", $"{gSession.target.spec.binPath}  (by {cmd.peerKind} peer)")
    loadBps()
    wsPush(cmd.bus, recordConfig())
    pushHelloState(cmd.bus)
}

// One-shot localStorage migration: fold the client's legacy entries into the
// server store, then the client stops sending (server is the sole writer
// thereafter). Idempotent: dedup collapses re-imports.
fn cmdImportHistory(cmd: &Cmd): void {
    if let Option.Some(e) = cmd.doc.get("entries") {
        if e.isArray() {
            gSession.persisted.history = histMergeMany(gSession.persisted.history, e.rawStr(), 10 as i64)
            persistHistory()
            wsPush(cmd.bus, historyChangedMsg())
        }
    }
}

// Deliberate fresh start (a reload reconnects to the live session by design):
// end any running debuggee via the kill path, drop bps and the late-join replay
// snapshots, mint a new id, and re-hello every peer; each resets its client
// state on the id change. Target config survives; the ⚙ drawer changes it.
fn cmdNewSession(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "disc", 0, "", "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    gSession.persisted.bps = []
    persistBps()
    gSession.stop.resume()
    gSession.output = []
    gSession.server.sessionId = newSessionName(sessionNameSeeds())
    journalHere()
    logEvent("session reset", $"new session {gSession.server.sessionId}")
    pushHelloState(cmd.bus)
}

// The dashboard's "new session" button. A session IS a server process, so making
// one means spawning one — this server cannot host a second.
//
// Port choice and the spawn itself live in ../sessions, shared with `dapweb
// start`: two ways to make a session that disagreed on which executable to run
// or which port to try is exactly the drift that module exists to prevent.
fn spawnSessionJson(): string {
    let port = freePortFrom((gSession.server.listenPort ?? (0 as i64)) + 1)
    if port == 0 {
        return Json.obj().bool("ok", false).str("error", "no free port near this one").build()
    }
    // Inherit --webroot: without it a child serves the bundle embedded at compile
    // time, so during UI work every spawned session silently shows yesterday's UI.
    var extra: Vec<string> = []
    if let Option.Some(w) = gSession.server.webroot {
        extra.push("--webroot")
        extra.push(w.clone())
    }
    match spawnSessionOn(port, extra) {
        Result.Ok(_pid) => {
            return Json.obj().bool("ok", true).int("port", port).build()
        }
        Result.Err(e) => {
            return Json.obj().bool("ok", false).str("error", e).build()
        }
    }
}

// Running processes, for the target bar's attach picker. Nobody remembers a pid,
// and making the user go find one in another terminal is most of why attaching
// feels harder than launching.
//
// Shelling out to ps rather than reading kinfo_proc through sysctl: the struct
// layout is neither stable nor shared between macOS and Linux, and this is a
// picker, not a monitor. Windows has no ps, so it answers an empty list with a
// note instead of a plausible-looking lie.
//
// The command line is included because "which of these four node processes" is
// exactly the question being asked, and argv can carry secrets. That is not a
// new exposure: this port already answers `evaluate`, so anyone who can reach it
// can already run ps through the debugger. It is a reason to keep the port on
// loopback, which the README already says.
fn processListJson(): string {
    var arr = Json.arr()
    var count: i64 = 0
    // args= only, deliberately: macOS pads/TRUNCATES the comm column to 16
    // characters, so "/usr/libexec/logd" comes back as "/usr/libexec/log" and
    // the name shown in the picker would be subtly wrong. argv[0] is not
    // truncated, and its basename is the name anyway.
    let cmd = Command.new("ps").arg("-axo").arg("pid=,args=").stdout(Stdio.Pipe)
    match cmd.spawn() {
        Result.Ok(child) => {
            var ch = child
            var out: string = ""
            if ch.stdoutFd >= 0 {
                for chunk in fdChannel(ch.stdoutFd) {
                    out = out + chunk
                }
            }
            let _w = ch.wait()
            for line in splitLines(out) {
                let t = line.trim()
                if t.len == 0 {
                    continue
                }
                // "<pid> <argv…>"
                let fields = t.splitWhitespace()
                if fields.len < 2 {
                    continue
                }
                let pid = fields[0].parseInt() ?? (0 as i64)
                if pid <= 0 {
                    continue
                }
                let full = t.substr(fields[0].len, t.len).trim()
                arr = arr.raw(Json.obj().int("pid", pid)
                    .str("name", Path.basename(fields[1]))
                    .str("cmd", full).build())
                count = count + 1
            }
        }
        Result.Err(_e) => {
            return Json.obj().arr("processes", Json.arr())
                .str("error", "could not list processes on this platform").build()
        }
    }
    return Json.obj().arr("processes", arr).int("count", count).build()
}

// ── HTTP API ──
//
// Snapshot of everything a caller needs to decide what to do next. Built from the
// same globals the WS replay uses, so `api state` and a freshly-opened browser tab
// always agree.
fn apiStateJson(): string {
    var phase = "idle"
    if gSession.proc.started {
        phase = "running"
    }
    if gSession.stop.stop.isSome() {
        phase = "stopped"
    }
    var bps = Json.arr()
    for bp in gSession.persisted.bps {
        bps = bps.raw(Json.obj().str("path", bp.path).int("line", bp.line)
            .str("condition", bp.condition).bool("enabled", bp.enabled).build())
    }
    var b = Json.obj().str("type", "state")
        .str("sessionId", gSession.server.sessionId)
        .str("phase", phase)
        .str("program", gSession.target.spec.binPath)
        .str("sourcePath", gSession.target.spec.srcPath)
        .str("adapter", adapterId())
        .int("peers", gSession.peers.count)
        .arr("breakpoints", bps)
    // The same renderers the snapshot uses, so these match what a tab joining
    // now would be sent.
    if let Option.Some(st) = gSession.stop.stop {
        b = b.raw("stopped", stoppedMsg(st))
    }
    if let Option.Some(t) = gSession.stop.threads {
        b = b.raw("threads", threadsMsg(t))
    }
    return b.build()
}

// Display name for an api caller: ?agent=<label>&pid=<n>, both optional. Identity
// rides the query string so the {"cmd":...} body stays exactly what the browser
// speaks and cannot drift from it.
fn apiWho(req: &Request): string {
    var who = req.param("agent")
    if who.len == 0 {
        // An unlabelled caller (curl, a hand-rolled client) is an api caller and
        // nothing more; "agent" would be a claim about it we cannot make.
        who = "api"
    }
    let apid = req.param("pid")
    if apid.len > 0 {
        who = $"{who} (pid {apid})"
    }
    return who
}

// Run one command and, when `awaitType` is set, block until a broadcast of that
// type arrives (or the deadline passes). Registering as a Sink first means no
// reply can slip through between dispatch and listening.
// The refusal an unknown command gets. It names the vocabulary rather than just
// saying no, because the caller that sent a typo is usually a script that cannot
// go and read the source.
fn unknownCmdJson(c: &string): string {
    var what = c.clone()
    if what.len == 0 {
        what = "(missing \"cmd\")"
    }
    return Json.obj().bool("ok", false)
        .str("error", $"unknown command {what} — known commands: {cmdNames()}. Run `dapweb api spec` for what each one takes.")
        .build()
}

fn apiRunCmd(body: string, awaitType: string, timeoutMs: i64, who: string, bus: &Channel<string>, pendCh: &Channel<Pending>): string {
    // An agent driving the session IS activity: without this an --idle-ttl server
    // reaps the debuggee out from under a caller that has no WS peer holding it.
    gSession.peers.lastActivityMs = epochMillis()
    if awaitType.len == 0 {
        if let Option.Some(bad) = dispatchClientCmd(body, "api", who, bus, pendCh) {
            return unknownCmdJson(bad)
        }
        return Json.obj().bool("ok", true).build()
    }
    let ch = Channel<Shared>.new(256)!
    let clientId = gSession.peers.nextClient
    gSession.peers.nextClient = gSession.peers.nextClient + 1
    sinkRegister(clientId, ch)
    if let Option.Some(bad) = dispatchClientCmd(body, "api", who, bus, pendCh) {
        sinkUnregister(clientId)
        return unknownCmdJson(bad)
    }

    let deadline = epochMillis() + timeoutMs
    var out: string = ""
    while epochMillis() < deadline {
        match ch.tryRecv() {
            Option.Some(sm) => {
                let m = sharedWith(sm, (s: &Sealed): string => s.text(s.span()))
                let Result.Ok(d) = Json.parse(m) else {
                    continue
                }
                let mt = d.str("type") ?? ""
                if mt == awaitType {
                    out = m
                    break
                }
                // A rejected command never produces the awaited reply, so return
                // the refusal rather than burning the caller's whole timeout and
                // then reporting a useless {"error":"timeout"}.
                if mt == "configError" {
                    out = Json.obj().bool("ok", false).str("error", d.str("error") ?? "").build()
                    break
                }
            }
            Option.None => {
                sleepMs(10)
            }
        }
    }
    sinkUnregister(clientId)
    if out.len == 0 {
        return Json.obj().bool("ok", false).str("error", "timeout").str("awaited", awaitType).build()
    }
    return out
}

// ── R: the WS-reader task (entry point per debug WebSocket) ──

fn handleDebugWs(ws: WsConn, peerKind: string, bus: &Channel<string>, pendCh: &Channel<Pending>): void {
    var conn = ws

    let ch = Channel<Shared>.new(256)!
    let wfd = conn.fd
    // Channel handles are refcounted and @send: the writer task outlives this
    // frame, so it gets its own retained handle (as does the registry's Sink).
    let writerCh = ch.clone()
    let writer = Task.spawn(move(): void => {
        wsWriterLoop(wfd, writerCh)
    }
    )

    // join the shared session. Register with the broadcaster, then replay
    // current state directly onto our own sink — no yield point in between,
    // so the replay is ordered before any subsequent broadcast fanout.
    let clientId = gSession.peers.nextClient
    gSession.peers.nextClient = gSession.peers.nextClient + 1
    sinkRegister(clientId, ch)
    gSession.peers.count = gSession.peers.count + 1
    logEvent("peer connected", $"{peerKind}  {peerCountStr()}")

    for m in gSession.snapshot() {
        peerPush(ch, m.clone())
    }

    while true {
        var payload: string = ""
        match conn.recv() {
            Result.Ok(m) => {
                payload = m.payload
            }
            Result.Err(_e) => {
                break
            }
        }

        if let Option.Some(bad) = dispatchClientCmd(payload, peerKind.clone(), peerKind.clone(), bus, pendCh) {
            wsPush(bus, configErrMsg($"unknown command {bad}"))
        }
    }

    // Leave the shared session; sinkUnregister closes our channel, which ends
    // the writer. Wait for it to exit before `conn` drops and closes the socket.
    sinkUnregister(clientId)
    writer.join()
    gSession.peers.count = gSession.peers.count - 1
    gSession.peers.lastActivityMs = epochMillis()
    logEvent("peer disconnected", $"{peerKind}  {peerCountStr()}")
}

// ── Idle TTL (session GC) ──

// Green task: sleepMs parks on a select timer arm, and the scheduler bounds its
// event-loop wait by the nearest timer deadline, so this ticks with the server
// otherwise idle and needs no OS thread. A session with no peers for the TTL is
// ended via the same disconnect(terminateDebuggee) path as the kill command —
// D's terminated/EOF handling resets session state for a later fresh run.
fn reaperLoop(tickMs: i64, pendCh: Channel<Pending>): void {
    while true {
        sleepMs(tickMs)
        let Option.Some(dfd) = gSession.proc.dapIn else {
            continue
        }
        if gSession.peers.count > 0 {
            continue
        }
        if epochMillis() - gSession.peers.lastActivityMs < gSession.server.idleTtlSecs * 1000 {
            continue
        }
        logEvent("session idle", $"no peers for {gSession.server.idleTtlSecs}s — terminating debuggee")
        let seq = gSession.proc.nextSeq()
        let _p = pendCh.trySend(Pending {
            seq: seq, kind: "disc", id: 0, extra: ""
        }
        )
        sendReqFd(dfd, seq, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    }
}

fn handleConnection(fd: i32, bus: Channel<string>, pendCh: Channel<Pending>): void {
    let Option.Some(req) = readRequest(fd) else {
        close(fd)
        return
    }
    if !requestAllowed(req) {
        sendHttp(fd, 403, "text/plain", "forbidden: dapweb only answers localhost, same-origin")
        close(fd)
        return
    }
    if sealedWith(req.buf, (raw: &string): bool => isWsUpgrade(raw)) {
        // Peer kind rides the upgrade path's query string: browsers
        // hit /ws bare, other clients pass ?client=<kind> — known
        // before the first frame, so connect logs carry the right kind.
        if req.path == "/ws" {
            var kind = req.param("client")
            if kind.len == 0 {
                kind = "browser"
            }
            match sealedWith(req.buf, (raw: &string): Result<WsConn, string> => wsAccept(fd, raw)) {
                Result.Ok(ws) => {
                    handleDebugWs(ws, kind, bus, pendCh)
                }
                Result.Err(_e) => {
                    close(fd)
                }
            }
        } else {
            close(fd)
        }
        return
    }

    // ── HTTP API (same command vocabulary as the WS the browser speaks) ──
    let apiPath = req.path.clone()
    if apiPath == "/api/state" {
        sendHttp(fd, 200, "application/json", apiStateJson())
        close(fd)
        return
    }
    // Reports on the configured target only, with no path parameter: the API
    // port is unauthenticated, and a caller-supplied path would make this an
    // arbitrary-file header reader.
    if apiPath == "/api/processes" {
        sendHttp(fd, 200, "application/json", processListJson())
        close(fd)
        return
    }
    // Every live dapweb on this machine, for the /sessions dashboard. Reads
    // the same registry `dapweb api list` does, and prunes it on the way.
    // The vocabulary, so a caller can discover it over the same port it
    // drives the session on rather than by reading the source.
    if apiPath == "/api/commands" {
        sendHttp(fd, 200, "application/json", commandsJson())
        close(fd)
        return
    }
    // What this machine's sessions have done. Same rows `dapweb log` prints,
    // over the port an agent is already talking to. Defaults to THIS
    // session, since the caller driving it is usually asking about its own
    // work; ?session=all widens to every session in the journal.
    if apiPath == "/api/log" {
        var f = logFilter()
        f.session = gSession.server.sessionId.clone()
        let qs = req.param("session")
        if qs == "all" {
            f.session = ""
        } else if qs.len > 0 {
            f.session = qs
        }
        f.kind = req.param("kind")
        f.dir = req.param("dir")
        f.since = req.param("since").parseInt() ?? (0 as i64)
        f.limit = req.param("limit").parseInt() ?? (0 as i64)
        var arr: Vec<string> = []
        if req.param("view") == "sessions" {
            arr = journalSessions(f.limit)
        } else if req.param("view") == "breakpoints" {
            arr = journalBreakpoints(req.param("program"), f.limit)
        } else {
            arr = journalRows(f)
        }
        var rows = Json.arr()
        for r in arr {
            rows = rows.raw(r)
        }
        sendHttp(fd, 200, "application/json", Json.obj().bool("ok", true).arr("rows", rows).build())
        close(fd)
        return
    }
    if apiPath == "/api/sessions" {
        sendHttp(fd, 200, "application/json", sessionsJson(gSession.server.sessionId))
        close(fd)
        return
    }
    if apiPath == "/api/spawn" {
        if req.method != "POST" {
            sendHttp(fd, 405, "application/json", Json.obj().bool("ok", false).str("error", "POST required").build())
            close(fd)
            return
        }
        sendHttp(fd, 200, "application/json", spawnSessionJson())
        close(fd)
        return
    }
    if apiPath == "/api/binfo" {
        sendHttp(fd, 200, "application/json", binInfoJson(gSession.target.spec.binPath))
        close(fd)
        return
    }
    if apiPath == "/api/cmd" {
        if req.method != "POST" {
            sendHttp(fd, 405, "application/json", Json.obj().bool("ok", false).str("error", "POST required").build())
            close(fd)
            return
        }
        let body = readBody(fd, req)
        var timeoutMs = req.param("timeout").parseInt() ?? (0 as i64)
        if timeoutMs <= 0 {
            timeoutMs = 5000
        }
        let reply = apiRunCmd(body, req.param("await"), timeoutMs, apiWho(req), bus, pendCh)
        sendHttp(fd, 200, "application/json", reply)
        close(fd)
        return
    }

    if req.method == "GET" {
        // requestAllowed has already pinned Host to a loopback name.
        serveStatic(fd, req.path, "http://" + req.header("host"))
    } else {
        sendHttp(fd, 404, "text/plain", "not found")
    }
    close(fd)
}

fn acceptLoop(listener: TcpListener, bus: Channel<string>, pendCh: Channel<Pending>): void {
    var l = listener
    while true {
        match l.accept() {
            Result.Ok(conn) => {
                var c = conn
                let fd = c.take()
                let connBus = bus.clone()
                let connPend = pendCh.clone()
                Task.spawn(move(): void => {
                    handleConnection(fd, connBus, connPend)
                }
                )
            }
            Result.Err(_e) => {
                schedulerYield()
            }
        }
    }
}

// Best-effort: pop the default browser open at the served URL. Fire-and-forget —
// a headless box (no xdg-open/open, or DAPWEB_NO_OPEN set) just skips silently.
// The whole thing is backgrounded inside the shell so sh returns instantly and
// wait() reaps it without stalling startup; the real opener reparents to init.
fn openBrowser(url: &string): void {
    if Env.getOr("DAPWEB_NO_OPEN", "").len > 0 {
        return
    }
    var args: Vec<string> = []
    args.push("-c")
    // xdg-open on Linux, open on macOS — whichever exists.
    args.push($"command -v xdg-open >/dev/null 2>&1 && xdg-open '{url}' || open '{url}' >/dev/null 2>&1 &")
    if let Result.Ok(child) = Child.spawn("sh", args, true) {
        let _ = child.wait()
    }
}

// Subcommand entrypoint: dispatched from src/main.milo as `dapweb web ...`.
// argv[0] is the display name (skipped by parseFrom); the rest are the web flags.
pub fn webMain(argv: Vec<string>): i32 {
    ignoreSignal(SIGPIPE)
    var parser = ArgParser.new("dapweb web", "web UI for any DAP debugger. Serves a shared session: any number of browser tabs see and drive the same debuggee, and `dapweb api` drives it from the CLI.")
    // No default target: boot idle and let the browser configure it (⚙ drawer).
    parser.addString("program", "p", "path to the debuggee binary (optional; configure in the browser if omitted)", "")
    // optional — the debuggee's DWARF knows its sources; the first stop's
    // frame path fills the editor. The flag only pre-loads a file for
    // before-launch breakpoints.
    parser.addString("source", "s", "main source file (optional; auto-detected from the first stop)", "")
    parser.addString("dapPath", "a", "DAP adapter command (stdio); a launch config's \"dapPath\" overrides", "lldb-dap")
    parser.addI64("port", "", "listen port", 8080)
    parser.addI64("idle-ttl", "", "end the debug session after this many seconds with no ws peers attached (0 = never)", 86400)
    parser.addString("webroot", "w", "serve the UI from this dir instead of the copy embedded in the binary (UI dev: src/web/ui/build.sh)", "")
    parser.addBool("no-browser", "", "do not open a browser tab at startup (headless hosts, and servers spawned by another dapweb)")
    parser.addBool("no-journal", "", "do not record this session's commands and events to the journal (see `dapweb log`)")
    parser.addBool("quiet", "q", "suppress session event log lines (banner only)")
    parser.addBool("verbose", "v", "log stops and steps too (noisy)")
    // A full VS Code launch configuration (inline JSON object or a file path —
    // a single config or a whole {version, configurations:[...]} launch.json).
    parser.addString("launch", "l", "launch configuration (inline JSON object or path to a JSON file): a VS Code launch config — \"type\"/\"request\"/\"program\"/\"args\"/\"env\"/\"cwd\" plus any adapter-specific keys, or a full {version, configurations:[...]} launch.json", "")
    parser.addString("config", "c", "configuration name to select when --launch is a {configurations:[...]} file (default: first entry)", "")
    let args = parser.parseFrom(argv)
    // getString is None only when the flag is absent AND its registered default
    // is empty, so `?? ""` is exactly the value the old string-returning API gave.
    gSession.target.spec.binPath = args.getString("program") ?? ""
    // Canonical from the start: bp paths go through absSourcePath, so a relative
    // --source would have the browser keying its gutter on a spelling the
    // breakpoint acks never use.
    gSession.target.spec.srcPath = absSourcePath(args.getString("source") ?? "")
    // An explicit empty --webroot means the embedded bundle, as no flag does.
    if let Option.Some(w) = args.getString("webroot") {
        if w.len > 0 {
            gSession.server.webroot = Option.Some(w.clone())
        }
    }
    gSession.server.noBrowser = args.getBool("no-browser")
    if args.getBool("no-journal") {
        journalDisable()
    }
    gSession.server.logLevel = 1
    if args.getBool("quiet") {
        gSession.server.logLevel = 0
    }
    if args.getBool("verbose") {
        gSession.server.logLevel = 2
    }
    // Read + syntax-check --launch now (fail fast); applied via applyConfig
    // after the session globals are initialized below.
    let launchArg = args.getString("launch") ?? ""
    var launchText: string = ""
    if launchArg.len > 0 {
        launchText = launchArg.clone()
        if launchArg[0] != '{' {
            match readFile(launchArg) {
                Result.Ok(t) => {
                    launchText = t
                }
                Result.Err(_e) => {
                    eprint($"error: --launch file not readable: {launchArg}\n")
                    return 1
                }
            }
        }
        match Json.parseJsonc(launchText) {
            Result.Ok(doc) => {
                if !doc.isObject() {
                    eprint("error: --launch must be a JSON object\n")
                    return 1
                }
            }
            Result.Err(e) => {
                eprint($"error: --launch is not valid JSON: {e}\n")
                return 1
            }
        }
    }
    // An explicit --webroot must exist; without one the embedded bundle always does.
    if let Option.Some(w) = gSession.server.webroot {
        if !pathExists(w + "/index.html") {
            eprint($"error: --webroot {w} has no index.html — run src/web/ui/build.sh, or drop the flag to use the embedded UI\n")
            return 1
        }
    }
    let adapterArg = args.getString("dapPath") ?? "lldb-dap" // mirrors the addString default
    let sel = resolveAdapterCmd(adapterArg)
    gSession.target.spec.adapterCmd = sel.cmd
    gSession.target.spec.adapterKind = sel.kind
    let port = args.getI64("port")

    // Shared session: one bus, one broadcaster, any number of peers.
    // gSession's declaration holds the rest of the initial state; these need a
    // runtime value (a non-empty string literal at module scope is NYI).
    gSession.persisted.history = "[]"
    gSession.server.sessionId = newSessionName(sessionNameSeeds())
    gSession.peers.lastActivityMs = epochMillis()
    gSession.server.idleTtlSecs = args.getI64("idle-ttl")

    // Apply a --launch config through the same path as every other config
    // (wrapper unwrap + --config name select + validation), CLI flags gap-filled.
    if launchText.len > 0 {
        let err = applyConfig(mergeCliDefaults(launchText, gSession.target.spec.binPath, gSession.target.spec.srcPath), args.getString("config") ?? "")
        if err.len > 0 {
            eprint($"error: --launch: {err}\n")
            return 1
        }
    } else if gSession.target.spec.binPath.len > 0 && adapterArg == "lldb-dap" {
        // --program alone: the dapPath default hardwires lldb, but a .js/.py/.go
        // program names its own dialect — route through the config path so the
        // right adapter is probed. Best-effort like the history restore: a probe
        // miss leaves the session idle and the run command reports it.
        var b = Json.obj().str("program", gSession.target.spec.binPath)
        if gSession.target.spec.srcPath.len > 0 {
            b = b.str("source", gSession.target.spec.srcPath)
        }
        let err = applyConfig(b.build(), "")
        if err.len > 0 {
            eprint($"warning: {err}\n")
        }
    }

    // History always loads (hello carries it). Boot restore, unconditional: with
    // no --program, stage history[0] as the session config (idle, not launched) so
    // a fresh browser lands on the last thing debugged. Best-effort — a restored
    // entry whose program/adapter is gone just leaves the session idle.
    loadHistory()
    if gSession.target.spec.binPath.len == 0 {
        match firstHistoryConfig() {
            Option.Some(cfg) => {
                if applyConfig(cfg, "").len == 0 {
                    gSession.server.restored = true
                }
            }
            Option.None => {
            }
        }
    } else {
        // A --program/--launch target goes into history at boot, not at first
        // Run: the point of history is that closing the tab and starting over
        // lands on what you were debugging, and a target nobody got around to
        // running is exactly the case that used to be lost.
        let _h = recordConfig()
    }
    // Breakpoints come back only once the target is settled — they are keyed by
    // program, so this has to follow --program/--launch and the history restore.
    loadBps()
    let bus = Channel<string>.new(1024)!
    let pendCh = Channel<Pending>.new(64)!
    let bcBus = bus.clone()
    Task.spawn(move(): void => {
        broadcastLoop(bcBus)
    }
    )

    if gSession.server.idleTtlSecs > 0 {
        // 1s ticks for short (test) TTLs, 30s otherwise — reap latency ≤ ttl + tick.
        var tickMs: i64 = 30000
        if gSession.server.idleTtlSecs <= 60 {
            tickMs = 1000
        }
        let reapPend = pendCh.clone()
        Task.spawn(move(): void => {
            reaperLoop(tickMs, reapPend)
        }
        )
    }

    match listenLocal(port) {
        Result.Ok(listener) => {
            var l = listener
            print($"dapweb web UI → http://localhost:{port}")
            if gSession.target.spec.binPath.len > 0 {
                if gSession.server.restored {
                    print($"  target:   {gSession.target.spec.binPath}   ({gSession.target.spec.adapterKind})   (restored — Run to launch)")
                } else {
                    print($"  target:   {gSession.target.spec.binPath}   ({gSession.target.spec.adapterKind})")
                }
                if gSession.target.spec.srcPath.len > 0 {
                    print($"  source:   {gSession.target.spec.srcPath}")
                }
            } else {
                print("  target:   (none — configure in the browser via the ⚙ drawer)")
            }
            print($"  drive:    dapweb api state --port {port}   (or: dapweb api run / step / eval ...)")
            print($"  sessions: http://localhost:{port}/sessions   (every live dapweb on this machine)")
            print("  docs:     https://github.com/milo-language/dapweb")
            registerSession(port)
            if gSession.server.logLevel >= 1 {
                print("")
            }
            flush()
            if !gSession.server.noBrowser {
                openBrowser($"http://localhost:{port}")
            }
            let acceptBus = bus.clone()
            let acceptPend = pendCh.clone()
            Task.spawn(move(): void => {
                acceptLoop(l, acceptBus, acceptPend)
            }
            )
        }
        Result.Err(_e) => {
            print($"error: could not bind port {port}")
            return 1
        }
    }
    // Go exit semantics (milo dropped the implicit end-of-main scheduler drain):
    // drive the scheduler so the accept/broadcast/reaper loops keep running.
    // The server blocks here until the process is signalled.
    schedulerRunToCompletion()
    unregisterSession()
    return 0
}
