let OUTLOG_MAX: i64 = 400

fn bpPaths(bps: &Vec<Bp>, fallback: &string): Vec<string> {
    var out: Vec<string> = []
    for bp in bps {
        var seen = false
        for p in out {
            if p == bp.path {
                seen = true
            }
        }
        if !seen {
            out.push(bp.path.clone())
        }
    }
    // Always at least one setBreakpoints per session so clearing the last bp
    // live actually clears it adapter-side.
    if out.len == 0 {
        out.push(fallback.clone())
    }
    return out
}

// A request R sent whose response D must route back to the browser.
pub struct Pending {
    seq: i64,
    kind: string, // initialize | eval | expand | bpLive | (D-internal: launch, sbInit, st, sc, vars)
    id: i64, // browser correlation id for eval/expand
    extra: string, // initialize: the setBreakpoints args JSON built from R's list
}

// ── DAP bodies → the JSON the UI renders ──

fn firstThreadId(doc: &Json): i64 {
    return doc.curInt(doc.curPath("body.threads[0].id")) ?? (-1 as i64)
}

// stackTrace body → [{"id":..,"name":..,"line":..,"path":..}] for the UI.
// path may be "" (no debug info / synthetic frame) — the UI skips navigation.
fn framesJson(doc: &Json): string {
    var arr = Json.arr()
    let frames = doc.curField(doc.curField(doc.curRoot(), "body"), "stackFrames")
    let n = doc.curLen(frames)
    var i: i64 = 0
    while i < n {
        let f = doc.curChild(frames, i)
        let path = doc.curStr(doc.curField(doc.curField(f, "source"), "path")) ?? ""
        arr = arr.obj(Json.obj().int("id", doc.curInt(doc.curField(f, "id")) ?? (0 as i64)).str("name", doc.curStr(doc.curField(f, "name")) ?? "?").int("line", doc.curInt(doc.curField(f, "line")) ?? (0 as i64)).str("path", path).str("ipRef", doc.curStr(doc.curField(f, "instructionPointerReference")) ?? ""))
        i = i + 1
    }
    return arr.build()
}

// Parse `memory region --all` console text → [{s,e,p,n}] (start/end hex kept as
// strings so the client parses them; p = perms "rw-", n = segment name if lldb
// gave one, e.g. "__TEXT"/"__DATA_CONST", else ""). Line shape:
//   [0x0000000100000000-0x0000000100004000) r-x __TEXT
// The client bins each region into a type (stack/heap/code/const/data) — it
// needs sp for the stack case, which only it has.
fn regionsJson(txt: &string): string {
    var arr = Json.arr()
    let lines = txt.clone().split("\n")
    var li: i64 = 0
    while li < lines.len {
        let line = lines[li].clone().trim()
        li = li + 1
        if !line.startsWith("[0x") {
            continue
        }
        // "[0xSTART-0xEND) perms name" — a line without both delimiters is not a
        // region line, exactly as the old -1 sentinel checks treated it.
        let Option.Some(dash) = line.indexOf("-") else {
            continue
        }
        let Option.Some(close) = line.indexOf(")") else {
            continue
        }
        let start = line.substr(1, dash) // drop leading '['
        let end = line.substr(dash + 1, close)
        let rest = line.substr(close + 1, line.len).trim() // "r-x __TEXT" | "rw-" | "---"
        let toks = rest.splitWhitespace()
        if toks.len == 0 {
            continue
        }
        var name: string = ""
        if toks.len > 1 {
            name = toks[1].clone()
        }
        arr = arr.obj(Json.obj().str("s", start).str("e", end).str("p", toks[0]).str("n", name))
    }
    return arr.build()
}

// variables body → [{"name":..,"value":..,"ref":..}] (ref>0 ⇒ expandable).
fn localsJson(doc: &Json): string {
    var arr = Json.arr()
    let vars = doc.curField(doc.curField(doc.curRoot(), "body"), "variables")
    let n = doc.curLen(vars)
    var i: i64 = 0
    while i < n {
        let v = doc.curChild(vars, i)
        arr = arr.obj(Json.obj().str("name", doc.curStr(doc.curField(v, "name")) ?? "?").str("value", doc.curStr(doc.curField(v, "value")) ?? "?")
        // DWARF-derived type (e.g. "int", "Node *", "double") when the
        // adapter supplies it; "" for register scopes and untyped values.
            .str("type", doc.curStr(doc.curField(v, "type")) ?? "").int("ref", doc.curInt(doc.curField(v, "variablesReference")) ?? (0 as i64)).str("mref", doc.curStr(doc.curField(v, "memoryReference")) ?? ""))
        i = i + 1
    }
    return arr.build()
}

// disassemble body → [{"addr":..,"text":..,"sym":..}] for the asm pane.
fn disasmJson(doc: &Json): string {
    var arr = Json.arr()
    let insns = doc.curField(doc.curField(doc.curRoot(), "body"), "instructions")
    let n = doc.curLen(insns)
    var i: i64 = 0
    while i < n {
        let ins = doc.curChild(insns, i)
        arr = arr.obj(Json.obj().str("addr", doc.curStr(doc.curField(ins, "address")) ?? "").str("text", doc.curStr(doc.curField(ins, "instruction")) ?? "").str("sym", doc.curStr(doc.curField(ins, "symbol")) ?? "").int("line", doc.curInt(doc.curField(ins, "line")) ?? (0 as i64)))
        i = i + 1
    }
    return arr.build()
}

// completions body → [{"label":..,"text":..}] (text falls back to label).
fn completionsJson(doc: &Json): string {
    var arr = Json.arr()
    let targets = doc.curField(doc.curField(doc.curRoot(), "body"), "targets")
    let n = doc.curLen(targets)
    var i: i64 = 0
    while i < n {
        let t = doc.curChild(targets, i)
        let label = doc.curStr(doc.curField(t, "label")) ?? ""
        var text = doc.curStr(doc.curField(t, "text")) ?? ""
        if text.len == 0 {
            text = label.clone()
        }
        arr = arr.obj(Json.obj().str("label", label).str("text", text))
        i = i + 1
    }
    return arr.build()
}

// threads body → [{"id":..,"name":..}] for the threads panel.
fn threadsJson(doc: &Json): string {
    var arr = Json.arr()
    let threads = doc.curField(doc.curField(doc.curRoot(), "body"), "threads")
    let n = doc.curLen(threads)
    var i: i64 = 0
    while i < n {
        let t = doc.curChild(threads, i)
        arr = arr.obj(Json.obj().int("id", doc.curInt(doc.curField(t, "id")) ?? (0 as i64)).str("name", doc.curStr(doc.curField(t, "name")) ?? "?"))
        i = i + 1
    }
    return arr.build()
}

// The register scope's variablesReference, or 0 if the adapter exposes none.
// lldb-dap tags it presentationHint "registers"; debugpy has no such scope, so
// a 0 here is what gates the UI's Registers panel (no register-cap flag in DAP).
fn registersScopeRef(doc: &Json): i64 {
    let scopes = doc.curField(doc.curField(doc.curRoot(), "body"), "scopes")
    let n = doc.curLen(scopes)
    var i: i64 = 0
    while i < n {
        let sc = doc.curChild(scopes, i)
        let hint = doc.curStr(doc.curField(sc, "presentationHint")) ?? ""
        let name = doc.curStr(doc.curField(sc, "name")) ?? ""
        if hint == "registers" || name == "Registers" {
            return doc.curInt(doc.curField(sc, "variablesReference")) ?? (0 as i64)
        }
        i = i + 1
    }
    return 0 as i64
}

// What an adapter actually said when it refused. The DAP response has two
// places for it and adapters disagree: lldb-dap puts a short line in "message",
// while its 21 series (and js-debug) leave that empty and put the real text in
// body.error.format. Reading only one of them turns a refusal into a blank.
fn respErrText(doc: &Json): string {
    let m = doc.curStr(doc.curField(doc.curRoot(), "message")) ?? ""
    if m.len > 0 {
        return m
    }
    let f = doc.curStr(doc.curPath("body.error.format")) ?? ""
    if f.len > 0 {
        return f
    }
    return "the adapter refused the request and said nothing about why"
}

// P: pty master → browser terminal. fdChannel owns the read/EAGAIN pump; we just
// wrap each chunk and forward.
//
// `reader` is this task's own dup of the master, and dropping it at the end is the
// only close it gets. fdChannel's reader parks in schedulerWaitRead on that number;
// had anything else closed it, the reader would sit parked on a free descriptor and
// the next pipe() to reuse the number would get its bytes stolen by a task from a
// dead session (which showed up as a second debug run hanging with its DAP responses
// vanishing into the previous run's stderr log). The Pty in proc.pty owns the
// original master, used by the stdin and resize commands; see closePty.
fn ptyPumpLoop(reader: OwnedFd, master: i32, ch: Channel<string>): void {
    for chunk in reader.channel() {
        wsPush(ch, Json.obj().str("type", "ptyData").str("data", chunk).build())
    }
    // The debuggee is gone: stdin typed from now on is buffered for the next run.
    if let Option.Some(p) = replace(gSession.proc.pty, Option.None) {
        if p.fd() != master {
            gSession.proc.pty = Option.Some(p)
        } else {
            closePty(p)
        }
    }
}

// The one way a Pty leaves proc.pty for good: Pty has no Drop, so overwriting or
// clearing the slot without this leaks the master.
fn closePty(p: Pty): void {
    var pty = p
    pty.close()
}

// Drain the adapter's stderr so the pipe never fills (mergeStderr=false) and
// stash the head of it for the pre-handshake death diagnostic. Cap at 8 KB —
// a Python traceback / lldb-dap gripe fits; a chatty adapter can't grow it
// unbounded. Also echoed to the server log so it's visible there too.
fn adapterStderrPump(errFd: OwnedFd): void {
    for chunk in errFd.channel() {
        eprint("[adapter] " + chunk)
        if gSession.proc.adapterStderr.len < 8192 {
            gSession.proc.adapterStderr = gSession.proc.adapterStderr + chunk
        }
    }
    // Dropping errFd here closes it: see ptyPumpLoop for why its reader must be the closer.
}

fn outputMsg(doc: &Json): string {
    // DAP category ("stdout"/"stderr"/"console"/"important"/…) lets the merged
    // terminal color program output apart from debugger chatter.
    return Json.obj().str("type", "output")
        .str("text", bodyStr(doc, "output"))
        .str("category", bodyStr(doc, "category"))
        .build()
}

// ── DAP request framing for R (odd seqs; D's DapClient uses even) ──

pub fn sendReqFd(fd: i32, seq: i64, command: &string, argsJson: &string): void {
    let payload = Json.obj().int("seq", seq).str("type", "request")
        .str("command", command).raw("arguments", argsJson).build()
    // Deliberately unchecked, as before: R has no path to report a short write
    // to, and a failed write here surfaces as the adapter going quiet, which D
    // already handles.
    let _w = writeFrameFd(fd, payload)
}

// DAP keys breakpoints on (source, line), so a second entry at a line the user
// already holds would be a duplicate the adapter may reject.
fn bpEnabledAt(bps: &Vec<Bp>, path: &string, line: i64): bool {
    for bp in bps {
        if bp.path == path && bp.line == line && bp.enabled {
            return true
        }
    }
    return false
}

// setBreakpoints args for one file (breakpoints are per-source in DAP), plus
// the in-flight runToCursor line when it is in this file.
pub fn buildBpArgsForPath(bps: &Vec<Bp>, path: &string): string {
    var arr = Json.arr()
    for bp in bps {
        if bp.path == path && bp.enabled {
            var o = Json.obj().int("line", bp.line)
            if bp.condition.len > 0 {
                o = o.str("condition", bp.condition)
            }
            if bp.hitCondition.len > 0 {
                o = o.str("hitCondition", bp.hitCondition)
            }
            if bp.logMessage.len > 0 {
                o = o.str("logMessage", bp.logMessage)
            }
            arr = arr.obj(o)
        }
    }
    if let Option.Some(t) = gSession.proc.runTo {
        if t.path == path && !bpEnabledAt(bps, path, t.line) {
            arr = arr.obj(Json.obj().int("line", t.line))
        }
    }
    return Json.obj()
        .obj("source", Json.obj().str("path", path))
        .arr("breakpoints", arr)
        .build()
}

// Session-init bundle: [{"args": <setBreakpoints-json>}] — one entry per file
// with bps. D replays these during the initialized event (kind sbInit each).
fn buildAllBpArgs(bps: &Vec<Bp>): string {
    var arr = Json.arr()
    let paths = bpPaths(bps, gSession.target.spec.srcPath)
    for path in paths {
        arr = arr.obj(Json.obj().str("args", buildBpArgsForPath(bps, path)))
    }
    return arr.build()
}

// setDataBreakpoints args: the whole set, since the request replaces it.
pub fn dataBpArgs(): string {
    var arr = Json.arr()
    for d in gSession.dataBps {
        var o = Json.obj().str("dataId", d.dataId).str("accessType", d.accessType)
        if d.condition.len > 0 {
            o = o.str("condition", d.condition)
        }
        if d.hitCondition.len > 0 {
            o = o.str("hitCondition", d.hitCondition)
        }
        arr = arr.obj(o)
    }
    return Json.obj().arr("breakpoints", arr).build()
}

// Drop the data breakpoints whose dataId dies with the process (all of them on
// lldb-dap, which never answers canPersist). Returns how many went.
pub fn dropRunDataBps(): i64 {
    var keep: Vec<DataBp> = []
    for d in gSession.dataBps {
        if d.canPersist {
            keep.push(cloneDataBp(d))
        }
    }
    let dropped = gSession.dataBps.len - keep.len
    gSession.dataBps = keep
    return dropped
}

// Who a data breakpoint change came from, carried through Pending.extra since D
// answers it long after the command's handler returned.
fn extraBy(rq: &Json): Attribution {
    return Attribution { by: rq.str("by") ?? "user", who: rq.str("who") ?? "browser" }
}

// dataBreakpointInfo answered: add the entry to the set, or refuse with the
// adapter's reason. True when the set changed and must be sent.
fn adoptDataBpInfo(doc: &Json, rq: &Json, ch: &Channel<string>): bool {
    let dataId = doc.curStr(doc.curPath("body.dataId")) ?? ""
    let desc = doc.curStr(doc.curPath("body.description")) ?? ""
    let label = rq.str("label") ?? ""
    // A null dataId is how DAP says "cannot watch this"; the description says why.
    if dataId.len == 0 {
        var why = desc.clone()
        if why.len == 0 {
            why = $"the adapter cannot watch {label}"
        }
        wsPush(ch, cmdErrorMsg("setDataBreakpoint", why))
        return false
    }
    let access = rq.str("accessType") ?? "write"
    let types = doc.curPath("body.accessTypes")
    let n = doc.curLen(types)
    if n > 0 {
        var okType = false
        var i: i64 = 0
        while i < n {
            if (doc.curStr(doc.curChild(types, i)) ?? "") == access {
                okType = true
            }
            i = i + 1
        }
        if !okType {
            wsPush(ch, cmdErrorMsg("setDataBreakpoint", $"the adapter cannot watch {label} for {access} access"))
            return false
        }
    }
    var keep: Vec<DataBp> = []
    for d in gSession.dataBps {
        if d.dataId != dataId {
            keep.push(cloneDataBp(d))
        }
    }
    keep.push(DataBp {
        dataId: dataId.clone(), label: label, description: desc,
        accessType: access, condition: rq.str("condition") ?? "",
        hitCondition: rq.str("hitCondition") ?? "",
        canPersist: doc.curBool(doc.curPath("body.canPersist")) ?? false,
        verified: false, message: "",
    }
    )
    gSession.dataBps = keep
    return true
}

// setDataBreakpoints answers in request order, one entry per data breakpoint.
fn adoptDataBpVerified(doc: &Json): void {
    let arr = doc.curPath("body.breakpoints")
    let n = doc.curLen(arr)
    var out: Vec<DataBp> = []
    var i: i64 = 0
    for d in gSession.dataBps {
        var c = cloneDataBp(d)
        if i < n {
            let el = doc.curChild(arr, i)
            c.verified = doc.curBool(doc.curField(el, "verified")) ?? false
            c.message = doc.curStr(doc.curField(el, "message")) ?? ""
        }
        out.push(c)
        i = i + 1
    }
    gSession.dataBps = out
}

// setExceptionBreakpoints args from the selected filter ids.
pub fn excArgs(): string {
    var filters: string = "[]"
    if let Option.Some(f) = gSession.target.excFilters {
        filters = f.clone()
    }
    return Json.obj().raw("filters", filters).build()
}

// launch/init bodies come from the shared ../dap/session module; these bind
// them to this session's target (stopAtMain is the per-run override).
fn initArgs(): string {
    return initArgsFor(gSession.target.spec.adapterKind)
}

fn launchRequest(): string {
    return launchRequestOf(gSession.target.spec)
}

fn launchArgs(): string {
    return launchArgsFor(gSession.target.spec, gSession.target.stopAtMain)
}

// ── D: the DAP-reader task ──

fn removePending(pend: &Vec<Pending>, idx: i64): Vec<Pending> {
    var keep: Vec<Pending> = []
    var i: i64 = 0
    while i < pend.len {
        if i != idx {
            keep.push(Pending {
                seq: pend[i].seq, kind: pend[i].kind.clone(),
                id: pend[i].id, extra: pend[i].extra.clone(),
            }
            )
        }
        i = i + 1
    }
    return keep
}

// runInTerminal reverse request → spawn debuggee in a std/pty, reply with the
// pid, start the pump. env vars are honored by exec'ing through /usr/bin/env
// (lldb-dap's launcher handshake rides on env vars, so dropping them breaks it).
fn handleRunInTerminal(cl: &mut DapClient, doc: &Json, reqSeq: i64, ch: &Channel<string>): i32 {
    var argv: Vec<string> = []
    var envs: Vec<string> = []
    let reqArgs = doc.curField(doc.curRoot(), "arguments")
    let argsCur = doc.curField(reqArgs, "args")
    for i in 0..doc.curLen(argsCur) {
        argv.push(doc.curStr(doc.curChild(argsCur, i)) ?? "")
    }
    // curLen counts an array's elements too; only an object's are env entries.
    let env = doc.curField(reqArgs, "env")
    for i in 0..(if doc.curKind(env) == 5 { doc.curLen(env) } else { 0 as i64 }) {
        envs.push(doc.curKeyAt(env, i) + "=" + (doc.curStr(doc.curValueAt(env, i)) ?? ""))
    }
    if argv.len == 0 {
        return -1
    }

    var program: string = argv[0].clone()
    var args: Vec<string> = []
    if envs.len > 0 {
        program = "/usr/bin/env"
        for e in envs {
            args.push(e.clone())
        }
        for a in argv {
            args.push(a.clone())
        }
    } else {
        var i: i64 = 1
        while i < argv.len {
            args.push(argv[i].clone())
            i = i + 1
        }
    }

    match Pty.open() {
        Result.Ok(p) => {
            var pty = p
            // Before spawn, not after: the forked child sets the slave's size
            // from the Pty's own rows/cols, and would overwrite a parent-side
            // resize that raced it.
            if let Option.Some(t) = gSession.proc.term {
                let _r = pty.resize(t.rows as u16, t.cols as u16)
            }
            match pty.spawn(program, args) {
                Result.Ok(pid) => {
                    logEvent("debuggee spawned", $"pid {pid}")
                    // Ours to reap: an adapter that routes the debuggee through
                    // our pty is not the process's parent and cannot be relied on
                    // to end it (js-debug's server does not).
                    gSession.proc.debuggeePid = Option.Some(pid as i64)
                    cl.respond(reqSeq, "runInTerminal", Json.obj().int("processId", pid as i64).build())
                    let master = pty.masterFd
                    let reader = match OwnedFd.dup(master) {
                        Result.Ok(r) => {
                            r
                        }
                        Result.Err(_e) => {
                            eprint("[srv] pty dup failed\n")
                            closePty(pty)
                            return -1
                        }
                    }
                    // direct global set (same scheduler thread) — and flush
                    // any keystrokes typed while the adapter was launching.
                    if gSession.proc.stdinBuf.len > 0 {
                        let _n = pty.writeOnce(gSession.proc.stdinBuf)
                        gSession.proc.stdinBuf = ""
                    }
                    // A restart replaces the pty: the old one's pump keeps its own
                    // dup until the dead child EOFs it, so its master can go now.
                    if let Option.Some(old) = replace(gSession.proc.pty, Option.Some(pty)) {
                        closePty(old)
                    }
                    // Channel handles are refcounted: the pump task outlives this
                    // call, so it gets its own retained handle rather than ours.
                    let ptyCh = ch.clone()
                    Task.spawn(move(): void => {
                        ptyPumpLoop(reader, master, ptyCh)
                    }
                    )
                    return master
                }
                Result.Err(e) => {
                    eprint($"[srv] pty spawn failed: {e}\n")
                    return -1
                }
            }
        }
        Result.Err(e) => {
            eprint($"[srv] pty open failed: {e}\n")
            return -1
        }
    }
}

// After the js-debug child handoff, the parent session matters only as an event
// source (the debuggee's stdio arrives there as output events) and as a peer
// that must not stall (reverse requests get a success reply). Session end is
// the CHILD's story — parent EOF just ends the drain, pushing nothing.
fn parentDrainLoop(client: DapClient, ch: Channel<string>): void {
    var cl = client
    while true {
        match cl.recv() {
            Result.Ok(m) => {
                if m.kind == "event" && m.event == "output" {
                    let ocat = bodyStr(m.doc, "category")
                    if ocat != "telemetry" {
                        gSession.output.push(OutLine {
                            text: bodyStr(m.doc, "output"), category: ocat.clone()
                        }
                        )
                        if gSession.output.len > OUTLOG_MAX {
                            let _d = gSession.output.remove(0)
                        }
                        wsPush(ch, outputMsg(m.doc))
                    }
                } else if m.kind == "request" {
                    let rc = m.command.clone()
                    if rc == "runInTerminal" {
                        // js-debug asks whichever session it launches from; an
                        // empty ack here would leave the program never started.
                        let _m = handleRunInTerminal(&mut cl, m.doc, m.seq, ch)
                    } else {
                        cl.respond(m.seq, rc, "{}")
                    }
                }
            }
            Result.Err(_e) => {
                break
            }
        }
    }
    cl.child.close()
}

fn dapReaderLoop(client: DapClient, ch: Channel<string>, pendCh: Channel<Pending>): void {
    var cl = client
    var pend: Vec<Pending> = []
    var tid: i64 = -1 as i64
    var framesJs: string = "[]"
    var stopLine: i64 = 0
    var stopReason: string = "" // DAP stopped.reason of the current stop
    var stopDesc: string = "" // optional human text the adapter attached
    // The stop-at-main function breakpoint's adapter id. DAP reports that stop as a
    // plain reason "breakpoint", so the only way to tell it from a user's is to
    // match the stop's hitBreakpointIds against the id setFunctionBreakpoints gave.
    var mainBpId: i64 = -1 as i64
    var stopAtMainHit = false
    var frame0: i64 = 0
    var regRef: i64 = 0 // register scope ref for the current stop (0 = adapter has none)
    var lastSrc: string = gSession.target.spec.srcPath.clone() // browser already has the main source
    var bpArgs: string = "[]" // per-file bundle from buildAllBpArgs
    var sbLeft: i64 = 0 // sbInit responses still outstanding
    var initOk = false // adapter answered `initialize` (handshake reached)
    // Session end is announced AFTER the globals below are re-armed, never from
    // inside the loop: a peer treats `terminated` as "you may run again", and
    // reapDebuggee alone can hold proc.started true for 500ms after the push, so an
    // immediate `run` was refused as "already active" (every e2e kill-then-run).
    var announceEnd = false

    while true {
        let Result.Ok(msg) = cl.recv() else {
            // An adapter that dies before answering `initialize` never really
            // started (bad dapPath, missing module, crash on launch). A bare
            // "terminated" reads like a clean program exit, so surface the real
            // cause — the captured stderr — as a configError instead.
            if !initOk {
                var em = "adapter exited before the handshake — it never started."
                if gSession.proc.adapterStderr.len > 0 {
                    em = em + "\n\n" + gSession.proc.adapterStderr
                }
                wsPush(ch, configErrMsg(em))
            }
            announceEnd = true
            break
        }

        // Adopt R's registered pendings AFTER recv, before matching: R registers
        // before it sends (and D was parked in recv while the adapter replied),
        // so draining here guarantees the entry exists when its response lands.
        // Draining before recv instead loses any pending R registers while D is
        // parked — the response arrives unmatched and is dropped.
        while true {
            match pendCh.tryRecv() {
                Option.Some(p) => {
                    if p.kind == "initialize" {
                        bpArgs = p.extra.clone()
                    }
                    pend.push(p)
                }
                Option.None => {
                    break
                }
            }
        }

        if msg.kind == "response" {
            var idx: i64 = -1 as i64
            var i: i64 = 0
            while i < pend.len {
                if pend[i].seq == msg.requestSeq {
                    idx = i
                }
                i = i + 1
            }
            var kind: string = ""
            var pid: i64 = 0
            var pextra: string = ""
            if idx >= 0 {
                kind = pend[idx].kind.clone()
                pid = pend[idx].id
                pextra = pend[idx].extra.clone()
                pend = removePending(pend, idx)
            }

            if !msg.success {
                if kind == "eval" {
                    let emsg = respErrText(msg.doc)
                    wsPush(ch, Json.obj().str("type", "evalResult").int("id", pid).str("value", emsg).int("ref", 0).bool("error", true).build())
                } else if kind == "fsc" || kind == "fvars" {
                    wsPush(ch, Json.obj().str("type", "frameLocals").int("id", pid).raw("vars", "[]").build())
                } else if kind == "disasm" {
                    wsPush(ch, Json.obj().str("type", "disasm").int("id", pid).raw("instructions", "[]").build())
                } else if kind == "setv" {
                    wsPush(ch, Json.obj().str("type", "setVarResult").int("id", pid).str("value", respErrText(msg.doc)).int("ref", 0).bool("error", true).build())
                } else if kind == "ebInit" {
                    // Exception filters rejected — still finish configuration
                    // or the session never launches.
                    let s = cl.send("configurationDone", "{}")
                    pend.push(Pending {
                        seq: s, kind: "cfgDone", id: 0, extra: ""
                    }
                    )
                } else if kind == "cmpl" {
                    wsPush(ch, Json.obj().str("type", "completions").int("id", pid).raw("targets", "[]").build())
                } else if kind == "tst" {
                    var t: string = "0"
                    if pextra.len > 0 {
                        t = pextra.clone()
                    }
                    wsPush(ch, Json.obj().str("type", "threadStack").int("id", pid).raw("tid", t).raw("frames", "[]").build())
                } else if kind == "readmem" {
                    wsPush(ch, Json.obj().str("type", "memory").int("id", pid).str("address", "").str("data", "").str("error", msg.doc.curStr(msg.doc.curField(msg.doc.curRoot(), "message")) ?? "").build())
                } else if kind == "gotoT" || kind == "goto" {
                    wsPush(ch, cmdErrorMsg("setNextStatement", $"{msg.command} failed: {respErrText(msg.doc)}"))
                } else if kind == "dbInfo" {
                    wsPush(ch, cmdErrorMsg("setDataBreakpoint", $"dataBreakpointInfo failed: {respErrText(msg.doc)}"))
                } else if kind == "dbSet" {
                    // The adapter refused the whole set: take back the entry
                    // this request added, so the list says what is armed.
                    if let Result.Ok(rq) = Json.parse(pextra) {
                        let added = rq.str("dataId") ?? ""
                        if added.len > 0 {
                            var keep: Vec<DataBp> = []
                            for d in gSession.dataBps {
                                if d.dataId != added {
                                    keep.push(cloneDataBp(d))
                                }
                            }
                            gSession.dataBps = keep
                        }
                    }
                    wsPush(ch, cmdErrorMsg("setDataBreakpoint", $"setDataBreakpoints failed: {respErrText(msg.doc)}"))
                    wsPush(ch, dataBpsMsg(gSession.dataBps, Option.None, 0 as i64))
                } else if kind == "restartR" {
                    // Adapter without restart support (e.g. debugpy): tell the
                    // UI so it falls back to kill+rerun. lldb-dap handles
                    // restart but never advertises supportsRestartRequest, so
                    // try-then-fallback beats capability gating here.
                    wsPush(ch, Json.obj().str("type", "restartFailed").build())
                } else if kind == "initialize" || kind == "launch" || kind == "childLaunch" || kind == "sbInit" {
                    eprint($"[srv] {msg.command} failed: {msg.raw}\n")
                    announceEnd = true
                    break
                }
            } else if kind == "initialize" {
                initOk = true
                gSession.stop.caps = Option.Some(msg.raw.clone())
                wsPush(ch, capsMsg(msg.raw))
                // a js-debug child session launches with the configuration the
                // startDebugging request handed us, not our built launch args;
                // "childLaunch" so its ack doesn't re-append history.
                var lreq = launchRequest()
                var largs = launchArgs()
                var lkind: string = "launch"
                if let Option.Some(c) = gSession.proc.child {
                    lreq = c.request.clone()
                    largs = c.body.clone()
                    lkind = "childLaunch"
                }
                let s = cl.send(lreq, largs)
                pend.push(Pending {
                    seq: s, kind: lkind, id: 0, extra: ""
                }
                )
            } else if kind == "launch" {
                // running; next signal is a stopped/terminated event.
                // Launch ack'd: this config actually ran, so record it (single
                // writer — clients never save) and tell every peer.
                wsPush(ch, appendHistory())
            } else if kind == "gotoT" {
                // The first target is the line itself; adapters list more only
                // when one line maps to several code locations.
                let target = msg.doc.curInt(msg.doc.curPath("body.targets[0].id")) ?? (-1 as i64)
                if target < 0 {
                    wsPush(ch, cmdErrorMsg("setNextStatement", "no code at that line to jump to"))
                } else {
                    let gs = cl.send("goto", Json.obj().raw("threadId", pextra).int("targetId", target).build())
                    pend.push(Pending {
                        seq: gs, kind: "goto", id: 0, extra: ""
                    }
                    )
                }
            } else if kind == "dbInfo" {
                if let Result.Ok(rq) = Json.parse(pextra) {
                    if adoptDataBpInfo(msg.doc, rq, ch) {
                        // The added dataId rides along so a refused set can take it back.
                        let ex = Json.obj().str("by", rq.str("by") ?? "user").str("who", rq.str("who") ?? "browser")
                            .str("dataId", msg.doc.curStr(msg.doc.curPath("body.dataId")) ?? "").build()
                        let s = cl.send("setDataBreakpoints", dataBpArgs())
                        pend.push(Pending {
                            seq: s, kind: "dbSet", id: 0, extra: ex
                        }
                        )
                    }
                }
            } else if kind == "dbSet" {
                adoptDataBpVerified(msg.doc)
                var by: Option<Attribution> = Option.None
                if let Result.Ok(rq) = Json.parse(pextra) {
                    if (rq.str("by") ?? "").len > 0 {
                        by = Option.Some(extraBy(rq))
                    }
                }
                wsPush(ch, dataBpsMsg(gSession.dataBps, by, 0 as i64))
            } else if kind == "thrPause" {
                // Pause with no known tid (attach before first stop): pause
                // the first thread the adapter reports.
                let t = firstThreadId(msg.doc)
                if t >= 0 {
                    let _s = cl.send("pause", Json.obj().int("threadId", t).build())
                }
            } else if kind == "sbInit" {
                sbLeft = sbLeft - 1
                if sbLeft <= 0 {
                    let s = cl.send("setExceptionBreakpoints", excArgs())
                    pend.push(Pending {
                        seq: s, kind: "ebInit", id: 0, extra: ""
                    }
                    )
                }
            } else if kind == "fbInit" {
                mainBpId = msg.doc.curInt(msg.doc.curPath("body.breakpoints[0].id")) ?? (-1 as i64)
            } else if kind == "ebInit" {
                let cd: string = "{}"
                let s = cl.send("configurationDone", cd)
                pend.push(Pending {
                    seq: s, kind: "cfgDone", id: 0, extra: ""
                }
                )
            } else if kind == "st" {
                framesJs = framesJson(msg.doc)
                stopLine = frame0Field(msg.doc, "line")
                frame0 = frame0Field(msg.doc, "id")
                let path = frame0Path(msg.doc)
                if path.len > 0 && path != lastSrc {
                    wsPush(ch, sourceMsg(path))
                    lastSrc = path
                }
                let scArgs = Json.obj().int("frameId", frame0).build()
                let s = cl.send("scopes", scArgs)
                pend.push(Pending {
                    seq: s, kind: "sc", id: 0, extra: ""
                }
                )
                // Memory map for region-coloring — lldb only (python/go repl has
                // no `memory region`). Fired alongside scopes; reply → "regions".
                if gSession.target.spec.adapterKind == "lldb" {
                    let rArgs = Json.obj().str("expression", "memory region --all")
                        .str("context", "repl").int("frameId", frame0).build()
                    let rs = cl.send("evaluate", rArgs)
                    pend.push(Pending {
                        seq: rs, kind: "regions", id: 0, extra: ""
                    }
                    )
                }
            } else if kind == "sc" {
                let ref = scopes0Ref(msg.doc)
                regRef = registersScopeRef(msg.doc)
                let vArgs = Json.obj().int("variablesReference", ref).build()
                let s = cl.send("variables", vArgs)
                // scope ref rides along: setVariable needs the parent
                // container ref, and for top-level locals that's the scope.
                pend.push(Pending {
                    seq: s, kind: "vars", id: 0, extra: ref.toString()
                }
                )
            } else if kind == "vars" {
                var scopeRef: string = "0"
                if pextra.len > 0 {
                    scopeRef = pextra.clone()
                }
                let info = StopInfo {
                    line: stopLine, path: lastSrc.clone(), tid: tid,
                    reason: stopReason.clone(), description: stopDesc.clone(), atMain: stopAtMainHit,
                    scopeRef: scopeRef, registersRef: regRef,
                    frames: framesJs.clone(), locals: localsJson(msg.doc),
                    by: Attribution { by: gSession.proc.driver.by.clone(), who: gSession.proc.driver.who.clone() },
                }
                wsPush(ch, stoppedMsg(info))
                gSession.stop.stop = Option.Some(info)
            } else if kind == "regions" {
                // Kept + replayed like the stop so a tab that reloads mid-stop
                // keeps its region colors instead of going grey until the next step.
                let regions = regionsJson(bodyStr(msg.doc, "result"))
                wsPush(ch, regionsMsg(regions))
                gSession.stop.regions = Option.Some(regions)
            } else if kind == "eval" {
                wsPush(ch, Json.obj().str("type", "evalResult").int("id", pid).str("value", bodyStr(msg.doc, "result")).int("ref", bodyI64(msg.doc, "variablesReference", 0 as i64)).build())
            } else if kind == "expand" {
                wsPush(ch, Json.obj().str("type", "children").int("id", pid).raw("vars", localsJson(msg.doc)).build())
            } else if kind == "fsc" {
                // Frame navigation: scopes for a non-top frame the user
                // clicked; chains into fvars like the stop-time sc → vars pair.
                let ref = scopes0Ref(msg.doc)
                let vArgs = Json.obj().int("variablesReference", ref).build()
                let s = cl.send("variables", vArgs)
                pend.push(Pending {
                    seq: s, kind: "fvars", id: pid, extra: ref.toString()
                }
                )
            } else if kind == "fvars" {
                var scopeRef: string = "0"
                if pextra.len > 0 {
                    scopeRef = pextra.clone()
                }
                wsPush(ch, Json.obj().str("type", "frameLocals").int("id", pid).raw("scopeRef", scopeRef).raw("vars", localsJson(msg.doc)).build())
            } else if kind == "setv" {
                // setVariable: body carries the adapter-formatted new
                // value (+ a fresh children ref for containers).
                wsPush(ch, Json.obj().str("type", "setVarResult").int("id", pid).str("value", bodyStr(msg.doc, "value")).int("ref", bodyI64(msg.doc, "variablesReference", 0 as i64)).build())
            } else if kind == "disasm" {
                wsPush(ch, Json.obj().str("type", "disasm").int("id", pid).raw("instructions", disasmJson(msg.doc)).build())
            } else if kind == "cmpl" {
                wsPush(ch, Json.obj().str("type", "completions").int("id", pid).raw("targets", completionsJson(msg.doc)).build())
            } else if kind == "readmem" {
                // readMemory body: address + base64 data; UI decodes.
                wsPush(ch, Json.obj().str("type", "memory").int("id", pid).str("address", bodyStr(msg.doc, "address")).str("data", bodyStr(msg.doc, "data")).build())
            } else if kind == "thr" {
                // threads at this stop; "current" is the stopping thread.
                let tl = ThreadList {
                    current: tid, threads: threadsJson(msg.doc)
                }
                wsPush(ch, threadsMsg(tl))
                gSession.stop.threads = Option.Some(tl)
                // lldb-dap fills its thread list lazily after a stop — the
                // immediate response usually carries only the stopping thread.
                // Re-poll a few times (attempt count rides in the id field);
                // the requests go through R's odd-seq path since D owns cl.
                if pid < 3 {
                    let att = pid + 1
                    // the re-poll task outlives this iteration, so it carries its
                    // own retained handle instead of moving D's out of the loop.
                    let pollPend = pendCh.clone()
                    Task.spawn(move(): void => {
                        sleepMs(300)
                        if gSession.stop.stop.isSome() {
                            if let Option.Some(dfd) = gSession.proc.dapIn {
                                let seq = gSession.proc.nextSeq()
                                let _p = pollPend.trySend(Pending {
                                    seq: seq, kind: "thr", id: att, extra: ""
                                }
                                )
                                sendReqFd(dfd, seq, "threads", "{}")
                            }
                        }
                    }
                    )
                }
            } else if kind == "tst" {
                // stack for a user-selected thread; tid rides in extra.
                var t: string = "0"
                if pextra.len > 0 {
                    t = pextra.clone()
                }
                wsPush(ch, Json.obj().str("type", "threadStack").int("id", pid).raw("tid", t).raw("frames", framesJson(msg.doc)).build())
            }
            // bpLive / cfgDone / unmatched: nothing to route
        } else if msg.kind == "event" {
            if msg.event == "initialized" {
                // "Stop at main" for native targets = a function breakpoint
                // (plain stopOnEntry would strand the user at dyld's entry with
                // no source). Python uses launch stopOnEntry instead — see
                // launchArgs(). Failure is tolerated: fbInit response is a no-op.
                // python and node stop at entry via launch stopOnEntry instead
                // (no "main" symbol; js-debug has no function breakpoints).
                // Attach is excluded too: the process is already running, so main
                // is long past and the breakpoint would never hit. There the same
                // toggle means "stop on attach" and rides in the attach body's
                // stopOnEntry — see launchArgsFor().
                if gSession.target.stopAtMain && gSession.target.spec.adapterKind != "python" && gSession.target.spec.adapterKind != "node" && gSession.target.spec.request != "attach" {
                    let fb = Json.obj().arr("breakpoints", Json.arr().obj(Json.obj().str("name", mainSymbolFor(gSession.target.spec.adapterKind)))).build()
                    let fs = cl.send("setFunctionBreakpoints", fb)
                    pend.push(Pending {
                        seq: fs, kind: "fbInit", id: 0, extra: ""
                    }
                    )
                }
                // One setBreakpoints per file with bps; configurationDone
                // is deferred until the last sbInit + ebInit round-trips.
                sbLeft = 0
                match Json.parse(bpArgs) {
                    Result.Ok(doc) => {
                        let n = doc.len()
                        var i: i64 = 0
                        while i < n {
                            match doc.at(i) {
                                Option.Some(el) => {
                                    let a = el.str("args") ?? "{}"
                                    let s = cl.send("setBreakpoints", a)
                                    pend.push(Pending {
                                        seq: s, kind: "sbInit", id: 0, extra: ""
                                    }
                                    )
                                    sbLeft = sbLeft + 1
                                }
                                Option.None => {
                                }
                            }
                            i = i + 1
                        }
                    }
                    Result.Err(_e) => {
                    }
                }
                // Only canPersist ones survive a run, so this is usually empty.
                // In flight before configurationDone, as DAP orders it.
                if gSession.dataBps.len > 0 {
                    let ds = cl.send("setDataBreakpoints", dataBpArgs())
                    pend.push(Pending {
                        seq: ds, kind: "dbSet", id: 0, extra: "{}"
                    }
                    )
                }
                if sbLeft == 0 {
                    let s = cl.send("setExceptionBreakpoints", excArgs())
                    pend.push(Pending {
                        seq: s, kind: "ebInit", id: 0, extra: ""
                    }
                    )
                }
            } else if msg.event == "output" {
                // Buffer for late-join replay — skip telemetry (adapter-internal,
                // never displayed). Bounded FIFO; a non-pty adapter floods here.
                let ocat = bodyStr(msg.doc, "category")
                if ocat != "telemetry" {
                    gSession.output.push(OutLine {
                        text: bodyStr(msg.doc, "output"), category: ocat.clone()
                    }
                    )
                    if gSession.output.len > OUTLOG_MAX {
                        let _d = gSession.output.remove(0)
                    }
                }
                wsPush(ch, outputMsg(msg.doc))
            } else if msg.event == "process" {
                // "launch" only: an ATTACHED process was running before this
                // session and has to outlive it: reaping it would turn a
                // detach into a kill.
                if bodyStr(msg.doc, "startMethod") == "launch" {
                    let dpid = bodyI64(msg.doc, "systemProcessId", 0 as i64)
                    if dpid > 0 {
                        gSession.proc.debuggeePid = Option.Some(dpid)
                    }
                }
            } else if msg.event == "exited" {
                // Not session end (restart emits it for the old process) —
                // just remember the code for the run-exited log line.
                let code = bodyI64(msg.doc, "exitCode", -1 as i64)
                gSession.proc.lastExit = Option.None
                if code >= 0 {
                    gSession.proc.lastExit = Option.Some(code)
                }
            } else if msg.event == "stopped" {
                if gSession.server.logLevel >= 2 {
                    logEvent("stopped", $"thread {bodyI64(msg.doc, "threadId", -1 as i64)}  reason {bodyStr(msg.doc, "reason")}")
                }
                // Any stop ends a runToCursor, wherever it landed: a user
                // breakpoint hit on the way leaves the temporary line armed
                // otherwise, and a later continue would stop there unasked.
                if let Option.Some(t) = replace(gSession.proc.runTo, Option.None) {
                    let rs = cl.send("setBreakpoints", buildBpArgsForPath(gSession.persisted.bps, t.path))
                    pend.push(Pending {
                        seq: rs, kind: "bpLive", id: 0, extra: ""
                    }
                    )
                }
                tid = bodyI64(msg.doc, "threadId", -1 as i64)
                stopReason = bodyStr(msg.doc, "reason")
                stopDesc = bodyStr(msg.doc, "description")
                stopAtMainHit = false
                if mainBpId >= 0 {
                    let hits = msg.doc.curPath("body.hitBreakpointIds")
                    var hi: i64 = 0
                    while hi < msg.doc.curLen(hits) {
                        if (msg.doc.curInt(msg.doc.curChild(hits, hi)) ?? (-1 as i64)) == mainBpId {
                            stopAtMainHit = true
                        }
                        hi = hi + 1
                    }
                }
                let stArgs = Json.obj().int("threadId", tid)
                    .int("startFrame", 0).int("levels", 20).build()
                let s = cl.send("stackTrace", stArgs)
                pend.push(Pending {
                    seq: s, kind: "st", id: 0, extra: ""
                }
                )
                // every stop also refreshes the threads panel.
                let ts = cl.send("threads", "{}")
                pend.push(Pending {
                    seq: ts, kind: "thr", id: 0, extra: ""
                }
                )
            } else if msg.event == "terminated" {
                announceEnd = true
                break
            }
            // "exited" alone is NOT session end: a native restart kills
            // the old process and emits exited for it. Real session end always
            // arrives as terminated or adapter EOF (recv error above).
        } else if msg.kind == "request" {
            if msg.command == "runInTerminal" {
                // A restart replaces the pty; handleRunInTerminal closes the old one.
                let _m = handleRunInTerminal(&mut cl, msg.doc, msg.seq, ch)
            } else if msg.command == "startDebugging" {
                // js-debug: the debuggee lives in a CHILD session the adapter
                // asks us to open — a second connection to the same server,
                // launched with the configuration riding in this request. The
                // child is where stops/threads/frames happen, so the loop swaps
                // onto it; the parent is left to a drain task (its output
                // events still carry the program's stdio).
                cl.respond(msg.seq, "startDebugging", "{}")
                let childReq = msg.doc.strPath("arguments.request") ?? "launch"
                var childCfg: string = ""
                if let Option.Some(c) = msg.doc.path("arguments.configuration") {
                    childCfg = c.rawStr()
                }
                var host: string = "127.0.0.1"
                if gSession.target.spec.port > 0 && gSession.target.spec.host.len > 0 {
                    host = gSession.target.spec.host.clone()
                }
                let srvPort = gSession.proc.srvPort ?? (0 as i64)
                if childCfg.len == 0 || srvPort <= 0 {
                    eprint("[srv] startDebugging without a child config/port — ignored\n")
                } else {
                    match DapClient.startTcp(host, srvPort) {
                        Result.Ok(childCl) => {
                            gSession.proc.child = Option.Some(ChildLaunch {
                                body: childCfg, request: childReq
                            }
                            )
                            var parentCl = cl
                            gSession.proc.parentIn = Option.Some(parentCl.child.stdinFd())
                            cl = childCl
                            // parent pendings can never match child seqs — drop
                            // them (the drain task ignores stray responses).
                            pend = []
                            gSession.proc.dapIn = Option.Some(cl.child.stdinFd())
                            let dch = ch.clone()
                            Task.spawn(move(): void => {
                                parentDrainLoop(parentCl, dch)
                            }
                            )
                            let s = cl.send("initialize", initArgs())
                            pend.push(Pending {
                                seq: s, kind: "initialize", id: 0, extra: ""
                            }
                            )
                        }
                        Result.Err(e) => {
                            eprint($"[srv] child session connect failed: {e}\n")
                            announceEnd = true
                            break
                        }
                    }
                }
            }
        }
    }

    cl.close()
    var durSecs = (epochMillis() - gSession.proc.runStartMs) / 1000
    if let Option.Some(code) = gSession.proc.lastExit {
        logEvent("run exited", $"code {code}  ({durSecs}s)")
    } else {
        // No exited event: killed, detached from an attach, or adapter EOF.
        logEvent("run ended", $"({durSecs}s)")
    }
    // Session over: re-arm `run` directly (globals, same scheduler
    // thread). Stale pendings must not collide with the next adapter's seq
    // numbers, which restart at 1.
    if let Option.Some(pfd) = replace(gSession.proc.parentIn, Option.None) {
        // adapter EOF / a `terminated` we did not ask for: same reasoning as the
        // kill path, and it costs one write to a fd that is about to close.
        sendReqFd(pfd, 999999 as i64, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    }
    killAdapterSrv()
    reapDebuggee()
    gSession.proc.child = Option.None
    gSession.proc.runTo = Option.None
    gSession.proc.started = false
    gSession.proc.dapIn = Option.None
    if let Option.Some(p) = replace(gSession.proc.pty, Option.None) {
        closePty(p)
    }
    gSession.proc.stdinBuf = ""
    gSession.proc.oddSeq = -1 as i64
    gSession.stop.resume()
    gSession.stop.caps = Option.None
    let droppedDb = dropRunDataBps()
    if droppedDb > 0 {
        wsPush(ch, dataBpsMsg(gSession.dataBps, Option.None, droppedDb))
    }
    while true {
        match pendCh.tryRecv() {
            Option.Some(_p) => {
            }
            Option.None => {
                break
            }
        }
    }
    if announceEnd {
        wsPush(ch, terminatedMsg(gSession.proc.lastExit))
    }
    // A forced run killed the old debuggee; auto-rerun here with its config
    // (a new config can't ride a live adapter — it caches launch args).
    // replace(), not a read: taking the value out of the global is a move the
    // checker can see, where passing the field by value would not be tracked.
    if let Option.Some(pr) = replace(gSession.proc.pendingRun, Option.None) {
        let runStopAtMain = pr.stopAtMain
        var err: string = ""
        if let Option.Some(cfg) = pr.config {
            err = applyConfig(cfg.clone(), "")
            if err.len == 0 {
                // applyConfig empties gBps (the new config may be a different
                // program); reload the program-keyed store before the hello, or
                // a forced relaunch of the same target silently throws away the
                // breakpoints the user set for it.
                loadBps()
                pushHelloState(ch)
            }
        }
        if err.len > 0 {
            wsPush(ch, configErrMsg(err))
        } else if gSession.target.spec.binPath.len > 0 || gSession.target.spec.request == "attach" {
            gSession.target.stopAtMain = runStopAtMain
            let _ok = startRun(ch, pendCh)
        }
    }
}

// "Debug server listening at 127.0.0.1:61234" → 61234, or 0 while incomplete.
// No trailing space in the needle: delve punctuates it "listening at: host:port".
fn parseListenPort(s: &string): i64 {
    let Option.Some(at) = s.indexOf("listening at") else {
        return 0
    }
    let rest = s.substr(at, s.len)
    let Option.Some(nl) = rest.indexOf("\n") else {
        return 0 // line still arriving — wait for more stdout
    }
    let line = rest.substr(0, nl)
    let Option.Some(colon) = line.lastIndexOf(":") else {
        return 0
    }
    return line.substr(colon + 1, line.len).trim().parseInt() ?? (0 as i64)
}

// Spawn a TCP-only adapter (js-debug's dapDebugServer) with a port argument of
// 0, read the port the OS picked off its stdout, and leave both output streams
// pumped. Returns the port to connect to; the server lands in proc.srv for
// teardown (closing our sockets leaves it listening forever).
fn spawnTcpAdapter(prog: &string, args: &Vec<string>): Result<i64> {
    var child = Child.spawn(prog, args, false)?
    let errFd = child.takeStderr()
    if errFd.fd() >= 0 {
        // same pre-handshake crash capture as stdio adapters
        Task.spawn(move(): void => {
            adapterStderrPump(errFd)
        }
        )
    }
    let outFd = child.takeStdout()
    // Stored once both pipes are taken: what teardown holds is only the process.
    gSession.proc.srv = Option.Some(child)
    var chOut = outFd.channel()
    var acc: string = ""
    var port: i64 = 0
    for chunk in chOut {
        acc = acc + chunk
        port = parseListenPort(acc)
        // 4KB with no listen line = it's printing something else (a crash, a
        // usage error) — stop accumulating and fail with what it said.
        if port > 0 || acc.len > 4096 {
            break
        }
    }
    if port <= 0 {
        return Result.Err("adapter never printed its listen port" + (if acc.len > 0 { ":\n" + acc } else { "" }))
    }
    // keep draining stdout or a chatty server fills the pipe and stalls
    Task.spawn(move(): void => {
        var rest = chOut
        for c in rest {
            eprint("[adapter] " + c)
        }
        // Closes stdout now that its pump is drained: this task is its last user.
        let _drained = outFd
    }
    )
    return Result.Ok(port)
}

// SIGTERM + reap the spawned TCP adapter server, if any. Its stdio fds are owned
// (and closed) by their pump tasks. processAlive is the signal-0 probe: it delivers
// nothing and works on a pid that is not our child (the debuggee below).
fn killAdapterSrv(): void {
    if let Option.Some(c) = gSession.proc.srv {
        // Let it exit on its own first: the disconnect we just sent is what makes
        // it kill the debuggee, and SIGTERMing it mid-teardown skips that.
        // Blocking, not sleepMs: D calls this mid-teardown with proc.started, proc.dapIn
        // and proc.srv still describing the dead session, and a parked D would let
        // a peer's step or run act on them (proc.dapIn names an fd cl.close() freed).
        var waited: i64 = 0
        while waited < 1000 && processAlive(c.pid()) {
            sleepBlockingMs(50)
            waited = waited + 50
        }
        let _k = c.signal(15)
        let _w = c.wait()
    }
    gSession.proc.srv = Option.None
    gSession.proc.srvPort = Option.None
}

// Make sure a launched debuggee is actually dead at session end. lldb-dap and
// debugpy kill their child themselves, but js-debug and dlv run the program
// under a SERVER we spawned: SIGTERMing that server reparents the program to
// init and dapweb reports "idle" while it is still running (and still holding
// the port/file the next run wants). Give it a moment to go on its own, then
// SIGTERM it. Not a child of ours: no Child handle exists for it, so this is a raw
// kill by pid (unsafe: the pid may have been reused), and never a wait.
fn reapDebuggee(): void {
    if let Option.Some(dpid) = gSession.proc.debuggeePid {
        let pid = dpid as i32
        // blocking for the same reason as killAdapterSrv
        var waited: i64 = 0
        while waited < 500 && processAlive(pid) {
            sleepBlockingMs(50)
            waited = waited + 50
        }
        if processAlive(pid) {
            unsafe {
                let _k = kill(pid, 15)
            }
            logEvent("debuggee reaped", $"pid {dpid} outlived the adapter (SIGTERM)")
        }
    }
    gSession.proc.debuggeePid = Option.None
}

// spawn the DAP adapter for the current config and drive the handshake.
// Shared by the run command (R) and restart-with-staged auto-rerun (D). Assumes
// binPath set and !proc.started. Broadcasts terminated and returns false if the
// adapter fails to spawn. bus is the broadcast channel.
pub fn startRun(bus: &Channel<string>, pendCh: &Channel<Pending>): bool {
    gSession.proc.started = true
    // reset BEFORE any spawn: the node path starts its stderr pump inside
    // spawnTcpAdapter, and a reset after it would wipe an early crash capture.
    gSession.proc.adapterStderr = ""
    // Transport: TCP connects to a running adapter (spec.port>0); stdio spawns
    // the resolved adapter command. Both yield a DapClient whose child.stdinFd
    // is the DAP write fd — the rest of the handshake is identical.
    var startRes: Result<DapClient> = Result.Err("uninitialized")
    var label: string = ""
    if gSession.target.spec.port > 0 {
        label = $"tcp {gSession.target.spec.host}:{gSession.target.spec.port}"
        startRes = DapClient.startTcp(gSession.target.spec.host, gSession.target.spec.port)
        // a user-run js-debug server also hands the debuggee to a child session;
        // remember where to open that second connection (see startDebugging).
        if gSession.target.spec.adapterKind == "node" {
            gSession.proc.srvPort = Option.Some(gSession.target.spec.port)
        }
    } else if tcpListenArgs(gSession.target.spec.adapterKind).len > 0 {
        // A socket-only adapter (js-debug, dlv): spawn it asking for port 0,
        // read the port it bound off stdout, connect. From here the handshake is
        // the same as any TCP adapter.
        var argv = adapterArgvOf(gSession.target.spec.adapterCmd)
        if argv.len == 0 {
            eprint("[srv] no adapter configured\n")
            gSession.proc.started = false
            wsPush(bus, terminatedMsg(Option.None))
            return false
        }
        var prog: string = argv[0].clone()
        var rest: Vec<string> = []
        var ai: i64 = 1
        while ai < argv.len {
            rest.push(argv[ai].clone())
            ai = ai + 1
        }
        for la in tcpListenArgs(gSession.target.spec.adapterKind) {
            rest.push(la.clone())
        }
        label = $"adapter {Path.basename(prog)}"
        match spawnTcpAdapter(prog, rest) {
            Result.Ok(port) => {
                gSession.proc.srvPort = Option.Some(port)
                startRes = DapClient.startTcp("127.0.0.1", port)
            }
            Result.Err(e) => {
                startRes = Result.Err(e)
            }
        }
    } else {
        var argv = adapterArgvOf(gSession.target.spec.adapterCmd)
        // adapterCmd is always set by config-apply before a stdio run reaches here.
        if argv.len == 0 {
            eprint("[srv] no adapter configured\n")
            gSession.proc.started = false
            wsPush(bus, terminatedMsg(Option.None))
            return false
        }
        var prog: string = argv[0].clone()
        var rest: Vec<string> = []
        var ai: i64 = 1
        while ai < argv.len {
            rest.push(argv[ai].clone())
            ai = ai + 1
        }
        label = $"adapter {Path.basename(prog)}"
        startRes = DapClient.startArgs(prog, rest)
    }
    match startRes {
        Result.Ok(client) => {
            var cl = client
            gSession.proc.runStartMs = epochMillis()
            gSession.proc.lastExit = Option.None
            logEvent("run started", $"{gSession.target.spec.binPath}  {label} pid {cl.child.pid()}")
            let dfd = cl.child.stdinFd()
            gSession.proc.dapIn = Option.Some(dfd)
            // Drain + capture adapter stderr (stdio spawns only; TCP has no child
            // stderr, so None). Must start before cl moves into the reader task.
            // The pump owns the descriptor from here (takeStderr leaves -1 behind,
            // so Child.close() skips it): it is closed exactly once, by its reader.
            if let Option.Some(errFd) = cl.child.takeStderr() {
                if errFd.fd() >= 0 {
                    Task.spawn(move(): void => {
                        adapterStderrPump(errFd)
                    }
                    )
                }
            }
            let seq = gSession.proc.nextSeq()
            let _p = pendCh.trySend(Pending {
                seq: seq, kind: "initialize", id: 0, extra: buildAllBpArgs(gSession.persisted.bps),
            }
            )
            sendReqFd(dfd, seq, "initialize", initArgs())
            let readerBus = bus.clone()
            let readerPend = pendCh.clone()
            Task.spawn(move(): void => {
                dapReaderLoop(cl, readerBus, readerPend)
            }
            )
            return true
        }
        Result.Err(e) => {
            eprint($"[srv] adapter spawn failed: {e}\n")
            killAdapterSrv()
            gSession.proc.started = false
            wsPush(bus, configErrMsg($"adapter failed to start: {e}"))
            wsPush(bus, terminatedMsg(Option.None))
            return false
        }
    }
}
