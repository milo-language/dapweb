// Binary inspection for the toolbar's "what am I debugging?" modal.
//
// The question this exists to answer is "does this binary actually have debug
// info?". A stripped or non-`-g` target is the number one reason a session
// silently shows no source, and until now the UI gave the user no way to tell.
//
// Two rules shape the whole module:
//
//   * It never fails. A missing, unreadable, truncated, or garbage file yields
//     format "unknown" plus a note. The endpoint is on the API port and must
//     not be able to take the server down.
//   * It never reads the whole file. Debug binaries run to hundreds of MB and
//     this runs on every modal open, so every read is a seek plus a bounded
//     `File.read`: the header, then only the section / load-command tables.

from "std/io" import {
    File, Reader
}
from "std/fs" import {
    pathExists, isDir
}
from "std/path" import {
    Path
}
from "std/json" import {
    Json
}

// Refuse to allocate more than this for one table. Real section tables and
// load-command blocks are kilobytes; anything larger is a corrupt or hostile
// header field, not something worth honouring.
let MAX_TABLE_BYTES: i64 = 8388608

// ── byte decoding ──
//
// The headers below are packed little- or big-endian integers at fixed offsets,
// so every field read goes through these. Out-of-range reads return -1 rather
// than trapping, which lets the parsers treat "truncated" and "absurd" alike.

fn uintAt(bytes: &string, off: i64, width: i64, little: bool): i64 {
    if off < 0 || width <= 0 || width > 4 || off + width > bytes.len {
        return -1
    }
    var v: i64 = 0
    var i: i64 = 0
    while i < width {
        var shift = i * 8
        if !little {
            shift = (width - 1 - i) * 8
        }
        v = v | ((bytes[off + i] as i64) << shift)
        i = i + 1
    }
    return v
}

fn u16At(bytes: &string, off: i64, little: bool): i64 {
    return uintAt(bytes, off, 2, little)
}

fn u32At(bytes: &string, off: i64, little: bool): i64 {
    return uintAt(bytes, off, 4, little)
}

// 64-bit fields are assembled from two 32-bit halves: Milo's arithmetic is
// checked, so shifting a byte >= 0x80 up by 56 would trap on overflow instead
// of producing a negative i64. A high half beyond 2^24 is rejected outright,
// since no real file offset or size is above 2^56.
fn u64At(bytes: &string, off: i64, little: bool): i64 {
    var lo: i64 = 0
    var hi: i64 = 0
    if little {
        lo = u32At(bytes, off, true)
        hi = u32At(bytes, off + 4, true)
    } else {
        hi = u32At(bytes, off, false)
        lo = u32At(bytes, off + 4, false)
    }
    if lo < 0 || hi < 0 || hi > 16777215 {
        return -1
    }
    return hi * 4294967296 + lo
}

// NUL-terminated name out of a byte range (section-header string tables, Mach-O
// segment names). `maxLen` bounds a name that runs to the end of the buffer;
// Mach-O segnames in particular are a fixed 16 bytes with no terminator when
// full.
fn cstrAt(bytes: &string, off: i64, maxLen: i64): string {
    var out: string = ""
    if off < 0 {
        return out
    }
    var i = off
    while i < bytes.len && i - off < maxLen {
        let c = bytes[i]
        if c == 0 {
            break
        }
        out.push(c)
        i = i + 1
    }
    return out
}

// ── bounded reads ──

// Read exactly `want` bytes at `off`, or fewer at EOF / on error. The caller
// bounds-checks the result length; a short buffer just means the file is
// truncated relative to what its own header claimed.
fn readAt(f: &mut File, off: i64, want: i64): string {
    if off < 0 || want <= 0 || want > MAX_TABLE_BYTES {
        return ""
    }
    match f.seek(off) {
        Result.Ok(_at) => {
        }
        Result.Err(_e) => {
            return ""
        }
    }
    var out: string = ""
    while out.len < want {
        match f.read(want - out.len) {
            Result.Ok(chunk) => {
                if chunk.len == 0 {
                    break
                }
                out.pushStr(chunk)
            }
            Result.Err(_e) => {
                break
            }
        }
    }
    return out
}

// ── accumulated answer ──

// Everything the JSON reports, filled in as far as each format parser gets.
// Defaults are the "could not tell" values, so a parser that bails halfway
// still produces a well-formed object.
struct BinInfo {
    format: string,
    cls: string,
    endian: string,
    arch: string,
    fileType: string,
    debugInfo: string,
    hasDebugInfo: bool,
    stripped: bool,
    dsym: string,
    // Go's linker embeds build info (module path, Go version) in its own
    // section, so its presence identifies a Go program without reading code.
    goBuildInfo: bool,
    // How the code was optimized, from what the binary records (see the
    // optimization section below): "-O0", "-O2", "optimized", "not optimized",
    // "-N -l", or "unknown"; optSource names the record it came from.
    opt: string,
    optimized: bool,
    optSource: string,
    notes: Vec<string>,
}

fn newBinInfo(): BinInfo {
    return BinInfo {
        format: "unknown", cls: "", endian: "", arch: "", fileType: "",
        debugInfo: "none", hasDebugInfo: false, stripped: false, dsym: "",
        goBuildInfo: false, opt: "unknown", optimized: false, optSource: "", notes: Vec.new(),
    }
}

impl BinInfo {
    fn note(self: &mut Self, msg: string): void {
        self.notes.push(msg)
    }
}

// ── ELF ──

fn elfMachineName(machine: i64): string {
    if machine == 62 {
        return "x86-64"
    }
    if machine == 183 {
        return "arm64"
    }
    if machine == 3 {
        return "i386"
    }
    if machine == 40 {
        return "armv7"
    }
    return ""
}

fn elfTypeName(etype: i64): string {
    if etype == 1 {
        return "object"
    }
    if etype == 2 {
        return "executable"
    }
    if etype == 3 {
        return "shared object"
    }
    if etype == 4 {
        return "core"
    }
    return ""
}

fn inspectElf(info: &mut BinInfo, f: &mut File, head: &string, fileSize: i64): void {
    info.format = "ELF"
    let is64 = head[4] == 2
    if is64 {
        info.cls = "64-bit"
    } else if head[4] == 1 {
        info.cls = "32-bit"
    } else {
        info.note("unknown ELF class")
        return
    }
    let little = head[5] != 2
    if head[5] == 1 {
        info.endian = "little"
    } else if head[5] == 2 {
        info.endian = "big"
    } else {
        info.note("unknown ELF endianness; assuming little")
        info.endian = "little"
    }

    info.fileType = elfTypeName(u16At(head, 16, little))
    info.arch = elfMachineName(u16At(head, 18, little))
    if info.arch.len == 0 {
        info.note("unrecognised e_machine")
    }

    let sects = elfSections(&mut info, &mut f, head, fileSize, is64, little)
    var hasSymtab = false
    var hasDynsym = false
    var hasInterp = false
    var debugLink = false
    var compressed = false
    for s in sects {
        let name = s.name.clone()
        if name == ".debug_info" {
            info.hasDebugInfo = true
            // SHF_COMPRESSED: zlib/zstd payload behind an Elf_Chdr.
            if (s.flags & 2048) != 0 {
                compressed = true
            }
        } else if name == ".zdebug_info" {
            info.hasDebugInfo = true
            compressed = true
        } else if name == ".symtab" {
            hasSymtab = true
        } else if name == ".dynsym" {
            hasDynsym = true
        } else if name == ".gnu_debuglink" {
            debugLink = true
        } else if name == ".interp" {
            hasInterp = true
        } else if name == ".go.buildinfo" {
            info.goBuildInfo = true
        }
    }
    if sects.len == 0 {
        return
    }
    if info.goBuildInfo {
        goOpt(&mut info, &mut f, sects)
    } else if info.hasDebugInfo && !compressed {
        dwarfOpt(&mut info, &mut f, sects, false)
    }

    // Every modern toolchain links executables position-independent, which makes
    // them ET_DYN and indistinguishable from a library by e_type alone. A program
    // interpreter is what tells the two apart, and calling a PIE a "shared object"
    // in the modal would just confuse the user reading it.
    if info.fileType == "shared object" && hasInterp {
        info.fileType = "executable"
        info.note("position-independent executable")
    }

    info.stripped = !hasSymtab
    if info.hasDebugInfo {
        if compressed {
            info.debugInfo = "DWARF (compressed sections)"
        } else {
            info.debugInfo = "DWARF (sections)"
        }
    } else if debugLink {
        // Split-debug builds (Fedora/Debian -dbg packages) keep DWARF in a
        // separate file the linker names here. The debugger can still find
        // source if that file is installed, so say so rather than "none".
        info.debugInfo = "separate file (.gnu_debuglink)"
        info.note("DWARF lives in a separate debug file named by .gnu_debuglink")
    }
    if info.stripped {
        if hasDynsym {
            info.note("no .symtab; only dynamic symbols (.dynsym) remain")
        } else {
            info.note("no symbol table")
        }
    }
}

// ── Mach-O ──

fn machoArchName(cputype: i64): string {
    if cputype == 16777228 {
        return "arm64"
    }
    if cputype == 16777223 {
        return "x86-64"
    }
    if cputype == 7 {
        return "i386"
    }
    if cputype == 12 {
        return "armv7"
    }
    return ""
}

fn machoTypeName(filetype: i64): string {
    if filetype == 1 {
        return "object"
    }
    if filetype == 2 {
        return "executable"
    }
    if filetype == 4 {
        return "core"
    }
    if filetype == 6 {
        return "dylib"
    }
    if filetype == 8 {
        return "bundle"
    }
    return ""
}

// `<path>.dSYM/Contents/Resources/DWARF/<basename>` is where `clang -g` leaves
// DWARF on macOS: the linker copies only a symbol table into the executable and
// dsymutil writes the debug info beside it. Reporting only what the Mach-O
// itself carries would therefore say "no debug info" for the overwhelmingly
// common case. `path` is used exactly as configured (cwd-relative stays
// cwd-relative, no realpath) so the modal shows the string the user gave the
// adapter, not a symlink-resolved path they would not recognise.
fn findDsym(info: &mut BinInfo, path: &string): void {
    let bundle = path.clone() + ".dSYM"
    if !pathExists(bundle) {
        return
    }
    info.dsym = bundle.clone()
    let inner = bundle.clone() + "/Contents/Resources/DWARF/" + Path.basename(path)
    if pathExists(inner) {
        info.hasDebugInfo = true
    } else {
        // A bundle whose inner DWARF is named differently (renamed binary, or a
        // dSYM for a dylib inside a framework) still means debug info exists,
        // but we could not confirm the file the debugger will open.
        info.note("companion .dSYM exists but holds no DWARF for this basename")
    }
}

// Does the symbol table still name any code in this image?
//
// This is the "stripped" test, and it cannot be "is LC_SYMTAB missing" or
// "is nsyms zero": macOS `strip` leaves the command in place with the nine or
// so undefined imports plus `__mh_execute_header` still in it, so a stripped
// executable and an unstripped one both report a non-zero nsyms. What actually
// changes is whether any entry is *defined in a section* of this image, which
// is exactly what a debugger needs to turn an address into a function name.
//
// Both tables are read with caps rather than in full: an image carrying more
// than the cap is self-evidently not stripped.
fn machoHasNamedCode(f: &mut File, fileSize: i64, is64: bool, little: bool,
                     symoff: i64, nsyms: i64, stroff: i64, strsize: i64): bool {
    if symoff <= 0 || nsyms <= 0 || stroff <= 0 || strsize <= 0 {
        return false
    }
    var entrySize: i64 = 12
    if is64 {
        entrySize = 16
    }
    var count = nsyms
    if count > 16384 {
        count = 16384
    }
    if symoff + count * entrySize > fileSize {
        return false
    }
    var strWant = strsize
    if strWant > 1048576 {
        strWant = 1048576
    }
    if stroff + strWant > fileSize {
        return false
    }
    let syms = readAt(&mut f, symoff, count * entrySize)
    let strs = readAt(&mut f, stroff, strWant)

    var i: i64 = 0
    while (i + 1) * entrySize <= syms.len {
        let base = i * entrySize
        let ntype = syms[base + 4] as i64
        // n_type packs N_STAB (0xe0), N_PEXT, N_TYPE (0x0e) and N_EXT. A stab
        // is debug bookkeeping, not a symbol; N_TYPE == N_SECT (0x0e) is the
        // only value that means "defined in a section of this file".
        if (ntype & 224) == 0 && (ntype & 14) == 14 {
            // The linker always emits this one, stripped or not, so it is not
            // evidence that anything survived.
            if cstrAt(strs, u32At(syms, base, little), 128) != "__mh_execute_header" {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn inspectMachO(info: &mut BinInfo, f: &mut File, head: &string, fileSize: i64, path: &string,
                is64: bool, little: bool): void {
    info.format = "Mach-O"
    if is64 {
        info.cls = "64-bit"
    } else {
        info.cls = "32-bit"
    }
    if little {
        info.endian = "little"
    } else {
        info.endian = "big"
    }

    info.arch = machoArchName(u32At(head, 4, little))
    if info.arch.len == 0 {
        info.note("unrecognised cputype")
    }
    let filetype = u32At(head, 12, little)
    info.fileType = machoTypeName(filetype)
    if filetype == 10 {
        info.note("this file is itself a dSYM companion, not a program image")
    }

    // The load commands follow the header contiguously: 32 bytes for a 64-bit
    // header (it carries a reserved word), 28 for 32-bit.
    var hdrSize: i64 = 28
    if is64 {
        hdrSize = 32
    }
    let ncmds = u32At(head, 16, little)
    let sizeofcmds = u32At(head, 20, little)

    var inBinaryDwarf = false
    var msects: Vec<Sect> = Vec.new()
    var hasSymtab = false
    var symoff: i64 = 0
    var nsyms: i64 = 0
    var stroff: i64 = 0
    var strsize: i64 = 0
    if ncmds <= 0 || sizeofcmds <= 0 || sizeofcmds > MAX_TABLE_BYTES
        || hdrSize + sizeofcmds > fileSize {
        info.note("unreadable load commands")
    } else {
        let cmds = readAt(&mut f, hdrSize, sizeofcmds)
        if cmds.len < sizeofcmds {
            info.note("truncated load commands")
        }
        var off: i64 = 0
        var seen: i64 = 0
        while seen < ncmds {
            let cmd = u32At(cmds, off, little)
            let cmdsize = u32At(cmds, off + 4, little)
            // A zero or unaligned cmdsize would spin or walk off the end; both
            // mean the table is corrupt, so stop with what we have.
            if cmd < 0 || cmdsize < 8 || off + cmdsize > cmds.len {
                break
            }
            if cmd == 2 {
                // symtab_command: cmd, cmdsize, symoff, nsyms, stroff, strsize.
                hasSymtab = true
                symoff = u32At(cmds, off + 8, little)
                nsyms = u32At(cmds, off + 12, little)
                stroff = u32At(cmds, off + 16, little)
                strsize = u32At(cmds, off + 20, little)
            } else if cmd == 25 || cmd == 1 {
                // segname is a fixed 16-byte field right after cmd/cmdsize.
                // A __DWARF segment means the debug info is in this file
                // (an unlinked .o, or a dSYM's own payload).
                if cstrAt(cmds, off + 8, 16) == "__DWARF" {
                    inBinaryDwarf = true
                }
            }
            off = off + cmdsize
            seen = seen + 1
        }
        msects = machoSections(cmds, ncmds, little)
    }

    if inBinaryDwarf {
        info.hasDebugInfo = true
    }
    findDsym(&mut info, path)
    info.goBuildInfo = sectIndex(msects, ".go.buildinfo") >= 0
    if info.goBuildInfo {
        goOpt(&mut info, &mut f, msects)
    } else if inBinaryDwarf {
        dwarfOpt(&mut info, &mut f, msects, true)
    } else if info.dsym.len > 0 {
        // A linked Mach-O keeps only a debug map; the DWARF itself is in the
        // dSYM's own Mach-O, which has the same section layout.
        let inner = info.dsym.clone() + "/Contents/Resources/DWARF/" + Path.basename(path)
        if let Result.Ok(dfh) = File.openRead(inner) {
            var df = dfh
            let dsize = df.size()
            let dhead = readAt(&mut df, 0, 64)
            if dhead.len >= 32 {
                let dsects = machoFileSections(&mut df, dhead, dsize)
                dwarfOpt(&mut info, &mut df, dsects, true)
            }
        }
    }

    if inBinaryDwarf && info.dsym.len > 0 {
        info.debugInfo = "DWARF (in binary + .dSYM)"
    } else if inBinaryDwarf {
        info.debugInfo = "DWARF (in binary)"
    } else if info.hasDebugInfo {
        info.debugInfo = "DWARF (.dSYM)"
    }

    if !hasSymtab {
        info.stripped = true
        info.note("no symbol table")
    } else {
        info.stripped = !machoHasNamedCode(&mut f, fileSize, is64, little, symoff, nsyms, stroff, strsize)
        if info.stripped {
            info.note("no function symbols; addresses will not resolve to names")
        }
    }
    if !info.hasDebugInfo && info.dsym.len == 0 {
        info.note("no companion .dSYM; build with -g for source-level debugging")
    }
}

// ── PE ──

fn peMachineName(machine: i64): string {
    if machine == 34404 {
        return "x86-64"
    }
    if machine == 332 {
        return "i386"
    }
    if machine == 43620 {
        return "arm64"
    }
    if machine == 448 || machine == 452 {
        return "armv7"
    }
    return ""
}

fn inspectPe(info: &mut BinInfo, f: &mut File, head: &string, fileSize: i64): void {
    info.format = "PE"
    info.endian = "little"
    // Windows is a partial target here, so this stays deliberately shallow: the
    // COFF header, the debug data directory, and the section names.
    info.note("PE inspection is shallow")

    let peOff = u32At(head, 60, true)
    if peOff <= 0 || peOff + 24 > fileSize {
        info.note("PE header offset out of range")
        return
    }
    // COFF header (20 bytes) plus the optional header's magic word.
    let coff = readAt(&mut f, peOff, 26)
    if coff.len < 26 || coff[0] != 'P' || coff[1] != 'E' || coff[2] != 0 || coff[3] != 0 {
        info.note("missing PE signature")
        return
    }
    info.arch = peMachineName(u16At(coff, 4, true))
    if info.arch.len == 0 {
        info.note("unrecognised COFF machine")
    }
    let nsections = u16At(coff, 6, true)
    let symtabPtr = u32At(coff, 12, true)
    let nsymbols = u32At(coff, 16, true)
    let optSize = u16At(coff, 20, true)
    let characteristics = u16At(coff, 22, true)

    // IMAGE_FILE_DLL (0x2000) and IMAGE_FILE_EXECUTABLE_IMAGE (0x0002); a file
    // with neither is a relocatable object.
    if (characteristics & 8192) != 0 {
        info.fileType = "shared object"
    } else if (characteristics & 2) != 0 {
        info.fileType = "executable"
    } else {
        info.fileType = "object"
    }
    // PE32+ optional header magic 0x20b vs PE32 0x10b is the only 32/64 signal
    // that is independent of the machine field.
    let optMagic = u16At(coff, 24, true)
    if optMagic == 523 {
        info.cls = "64-bit"
    } else if optMagic == 267 {
        info.cls = "32-bit"
    }
    // IMAGE_FILE_DEBUG_STRIPPED (0x0200) plus an empty COFF symbol table.
    info.stripped = nsymbols <= 0 || (characteristics & 512) != 0

    // Data directory 6 is IMAGE_DIRECTORY_ENTRY_DEBUG; a non-zero size means a
    // debug directory (usually a PDB reference) is present. The directories
    // begin 112 bytes into a PE32+ optional header, 96 into a PE32 one.
    var dirBase: i64 = -1
    if optMagic == 523 {
        dirBase = 112
    } else if optMagic == 267 {
        dirBase = 96
    }
    if dirBase >= 0 && optSize >= dirBase + 56 {
        let dir = readAt(&mut f, peOff + 24 + dirBase + 48, 8)
        if dir.len == 8 && u32At(dir, 4, true) > 0 {
            info.hasDebugInfo = true
            info.debugInfo = "PDB (debug directory)"
        }
    }

    // A MinGW/clang -g build carries DWARF in sections instead. Their names run
    // past COFF's 8-byte name field, so they are stored as "/<decimal offset>"
    // into the string table that follows the symbol table.
    if nsections > 0 && nsections < 4096 && optSize >= 0 {
        let secOff = peOff + 24 + optSize
        let secs = readAt(&mut f, secOff, nsections * 40)
        var strtabOff: i64 = -1
        if symtabPtr > 0 && nsymbols > 0 {
            strtabOff = symtabPtr + nsymbols * 18
        }
        var i: i64 = 0
        // Each long name costs its own small read of the string table, so cap
        // how many a corrupt section count can make us issue.
        var lookups: i64 = 0
        while i * 40 + 8 <= secs.len && !info.hasDebugInfo {
            var name = cstrAt(secs, i * 40, 8)
            if name.len > 1 && name[0] == '/' && strtabOff > 0 && lookups < 256 {
                if let Option.Some(rel) = name.substr(1, name.len).parseInt() {
                    lookups = lookups + 1
                    name = cstrAt(readAt(&mut f, strtabOff + rel, 128), 0, 128)
                }
            }
            if name == ".debug_info" {
                info.hasDebugInfo = true
                info.debugInfo = "DWARF (sections)"
            }
            i = i + 1
        }
    }
}

// ── entry point ──

// A JSON description of the binary at `path` for the toolbar modal. Never
// fails: an absent file reports only `exists: false`, and anything unreadable
// or unrecognised reports format "unknown" plus a note.
pub fn binInfoJson(path: &string): string {
    if path.len == 0 || !pathExists(path) {
        return Json.obj().str("path", path).bool("exists", false).build()
    }

    var info = newBinInfo()
    var size: i64 = 0

    if isDir(path) {
        info.note("path is a directory")
    } else {
        match File.openRead(path) {
            Result.Ok(fh) => {
                var f = fh
                size = f.size()
                if size < 0 {
                    size = 0
                    info.note("could not measure file size")
                }
                // 64 bytes covers every header this module reads fields from:
                // the ELF64 header is exactly 64, the Mach-O header 32, and the
                // PE stub only needs its e_lfanew word at 0x3C.
                let head = readAt(&mut f, 0, 64)
                if head.len < 4 {
                    info.note("file too small to identify")
                } else if head[0] == 127 && head[1] == 'E' && head[2] == 'L' && head[3] == 'F' {
                    inspectElf(&mut info, &mut f, head, size)
                } else if head[0] == 207 && head[1] == 250 && head[2] == 237 && head[3] == 254 {
                    // CF FA ED FE reads little-endian as MH_MAGIC_64 (0xFEEDFACF).
                    inspectMachO(&mut info, &mut f, head, size, path, true, true)
                } else if head[0] == 206 && head[1] == 250 && head[2] == 237 && head[3] == 254 {
                    // CE FA ED FE is the 32-bit MH_MAGIC.
                    inspectMachO(&mut info, &mut f, head, size, path, false, true)
                } else if head[0] == 254 && head[1] == 237 && head[2] == 250
                    && (head[3] == 207 || head[3] == 206) {
                    // Byte-swapped magic: a big-endian Mach-O (PowerPC era).
                    inspectMachO(&mut info, &mut f, head, size, path, head[3] == 207, false)
                } else if head[0] == 202 && head[1] == 254 && head[2] == 186 && head[3] == 190 {
                    // CA FE BA BE: fat header, big-endian by definition.
                    fatInfo(&mut info, head, true)
                } else if head[0] == 190 && head[1] == 186 && head[2] == 254 && head[3] == 202 {
                    fatInfo(&mut info, head, false)
                } else if head[0] == 'M' && head[1] == 'Z' {
                    inspectPe(&mut info, &mut f, head, size)
                } else {
                    info.note("unrecognised file format")
                }
            }
            Result.Err(_e) => {
                info.note("could not open file")
            }
        }
    }

    var notes = Json.arr()
    for n in info.notes {
        notes = notes.str(n)
    }
    return Json.obj()
        .str("path", path)
        .bool("exists", true)
        .int("size", size)
        .str("format", info.format)
        .str("class", info.cls)
        .str("endian", info.endian)
        .str("arch", info.arch)
        .str("fileType", info.fileType)
        .str("debugInfo", info.debugInfo)
        .bool("hasDebugInfo", info.hasDebugInfo)
        .bool("stripped", info.stripped)
        .str("dsym", info.dsym)
        .bool("goBuildInfo", info.goBuildInfo)
        .str("opt", info.opt)
        .bool("optimized", info.optimized)
        .str("optSource", info.optSource)
        .arr("notes", notes)
        .build()
}

// Universal ("fat") binaries are a container of per-architecture Mach-O slices.
// Picking the right slice would mean matching the host cputype and re-running
// the whole Mach-O parser at its offset; the modal only needs to say what kind
// of file this is, so report the slice count and stop.
fn fatInfo(info: &mut BinInfo, head: &string, bigEndian: bool): void {
    info.format = "universal"
    let n = u32At(head, 4, !bigEndian)
    if n > 0 && n < 64 {
        info.note($"universal binary containing {n} architectures")
    } else {
        info.note("universal binary with an unreadable architecture count")
    }
    info.note("per-architecture debug info was not inspected")
}

// Whether `path` is a Go program, from its embedded build info section. This is
// the debugger picker's question, asked per keystroke and per listed process, so
// it reads only what that needs: the ELF section table, or the Mach-O load
// commands, never the symbol table binInfoJson walks. Anything else (PE, fat,
// unreadable) is "not Go", since the answer only upgrades lldb to delve.
pub fn isGoBinary(path: &string): bool {
    if path.len == 0 || !pathExists(path) || isDir(path) {
        return false
    }
    let Result.Ok(fh) = File.openRead(path) else {
        return false
    }
    var f = fh
    let size = f.size()
    let head = readAt(&mut f, 0, 64)
    if head.len < 32 {
        return false
    }
    if head[0] == 127 && head[1] == 'E' && head[2] == 'L' && head[3] == 'F' && head.len >= 64 {
        var scratch = newBinInfo()
        let sects = elfSections(&mut scratch, &mut f, head, size, head[4] == 2, head[5] != 2)
        return sectIndex(sects, ".go.buildinfo") >= 0
    }
    return sectIndex(machoFileSections(&mut f, head, size), ".go.buildinfo") >= 0
}

// ── section tables ──
//
// Both formats reduced to one list so the DWARF and Go readers below do not
// care which container they are in. Mach-O names are normalised to the ELF
// spelling ("__debug_info" is ".debug_info"); Mach-O truncates names to 16
// bytes, so the two that overflow are mapped back by hand.

struct Sect {
    name: string,
    off: i64,
    size: i64,
    flags: i64,
}

fn sectIndex(sects: &Vec<Sect>, name: &string): i64 {
    var i: i64 = 0
    while i < sects.len {
        if sects[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// Every section header of an ELF file, or an empty list after noting why not.
fn elfSections(info: &mut BinInfo, f: &mut File, head: &string, fileSize: i64, is64: bool, little: bool): Vec<Sect> {
    var out: Vec<Sect> = Vec.new()
    // Section-table locators live at different offsets in the two classes; the
    // section headers themselves are 64 bytes (ELF64) vs 40 (ELF32).
    var shoff: i64 = 0
    var shentsize: i64 = 0
    var shnum: i64 = 0
    var shstrndx: i64 = 0
    if is64 {
        shoff = u64At(head, 40, little)
        shentsize = u16At(head, 58, little)
        shnum = u16At(head, 60, little)
        shstrndx = u16At(head, 62, little)
    } else {
        shoff = u32At(head, 32, little)
        shentsize = u16At(head, 46, little)
        shnum = u16At(head, 48, little)
        shstrndx = u16At(head, 50, little)
    }
    if shoff <= 0 || shentsize <= 0 || shoff >= fileSize {
        info.note("no section table; debug info cannot be determined")
        return out
    }

    // Extended numbering: an object with >= 0xFF00 sections stores the real
    // count in section 0's sh_size, and an out-of-range string-table index in
    // its sh_link. Section 0 is otherwise all zeroes.
    if shnum == 0 || shstrndx == 65535 {
        let sh0 = readAt(&mut f, shoff, shentsize)
        if sh0.len < shentsize {
            info.note("truncated section table")
            return out
        }
        if shnum == 0 {
            if is64 {
                shnum = u64At(sh0, 32, little)
            } else {
                shnum = u32At(sh0, 20, little)
            }
        }
        if shstrndx == 65535 {
            if is64 {
                shstrndx = u32At(sh0, 40, little)
            } else {
                shstrndx = u32At(sh0, 24, little)
            }
        }
    }
    if shnum <= 0 || shstrndx < 0 || shstrndx >= shnum {
        info.note("section table locators out of range")
        return out
    }
    let tableBytes = shnum * shentsize
    if tableBytes > MAX_TABLE_BYTES || shoff + tableBytes > fileSize {
        info.note("section table extends past end of file")
        return out
    }
    let table = readAt(&mut f, shoff, tableBytes)
    if table.len < tableBytes {
        info.note("truncated section table")
        return out
    }

    // The names of every section live in one string table, itself a section.
    var strOff: i64 = 0
    var strSize: i64 = 0
    let strHdr = shstrndx * shentsize
    if is64 {
        strOff = u64At(table, strHdr + 24, little)
        strSize = u64At(table, strHdr + 32, little)
    } else {
        strOff = u32At(table, strHdr + 16, little)
        strSize = u32At(table, strHdr + 20, little)
    }
    if strOff <= 0 || strSize <= 0 || strSize > MAX_TABLE_BYTES || strOff + strSize > fileSize {
        info.note("unreadable section-header string table")
        return out
    }
    let strtab = readAt(&mut f, strOff, strSize)
    var i: i64 = 0
    while i < shnum {
        let h = i * shentsize
        var s = Sect { name: cstrAt(strtab, u32At(table, h, little), 128), off: 0, size: 0, flags: 0 }
        s.flags = u32At(table, h + 8, little)
        if is64 {
            s.off = u64At(table, h + 24, little)
            s.size = u64At(table, h + 32, little)
        } else {
            s.off = u32At(table, h + 16, little)
            s.size = u32At(table, h + 20, little)
        }
        out.push(s)
        i = i + 1
    }
    return out
}

// Every section of every segment in an already-read Mach-O load-command block.
// The section headers follow each segment header inline: 72 + 80*n bytes for
// LC_SEGMENT_64, 56 + 68*n for LC_SEGMENT, sectname first in each.
fn machoSections(cmds: &string, ncmds: i64, little: bool): Vec<Sect> {
    var out: Vec<Sect> = Vec.new()
    var off: i64 = 0
    var seen: i64 = 0
    while seen < ncmds {
        let cmd = u32At(cmds, off, little)
        let cmdsize = u32At(cmds, off + 4, little)
        if cmd < 0 || cmdsize < 8 || off + cmdsize > cmds.len {
            break
        }
        if cmd == 25 || cmd == 1 {
            let is64 = cmd == 25
            var hdr: i64 = 56
            var each: i64 = 68
            var nsects = u32At(cmds, off + 48, little)
            if is64 {
                hdr = 72
                each = 80
                nsects = u32At(cmds, off + 64, little)
            }
            if nsects > 0 && hdr + nsects * each <= cmdsize {
                var i: i64 = 0
                while i < nsects {
                    let at = off + hdr + i * each
                    var name = cstrAt(cmds, at, 16)
                    if name.startsWith("__") {
                        name = "." + name.substr(2, name.len)
                    }
                    if name == ".debug_str_offs" {
                        name = ".debug_str_offsets"
                    } else if name == ".go_buildinfo" {
                        name = ".go.buildinfo"
                    }
                    var s = Sect { name: name, off: 0, size: 0, flags: 0 }
                    if is64 {
                        s.size = u64At(cmds, at + 40, little)
                        s.off = u32At(cmds, at + 48, little)
                    } else {
                        s.size = u32At(cmds, at + 36, little)
                        s.off = u32At(cmds, at + 40, little)
                    }
                    out.push(s)
                    i = i + 1
                }
            }
        }
        off = off + cmdsize
        seen = seen + 1
    }
    return out
}

// The sections of a thin little-endian Mach-O, or none if `head` is not one.
// No Go or DWARF producer this reads for targets big-endian Mach-O.
fn machoFileSections(f: &mut File, head: &string, fileSize: i64): Vec<Sect> {
    let is64 = head[0] == 207 && head[1] == 250 && head[2] == 237 && head[3] == 254
    let is32 = head[0] == 206 && head[1] == 250 && head[2] == 237 && head[3] == 254
    if !is64 && !is32 {
        return Vec.new()
    }
    var hdrSize: i64 = 28
    if is64 {
        hdrSize = 32
    }
    let ncmds = u32At(head, 16, true)
    let sizeofcmds = u32At(head, 20, true)
    if ncmds <= 0 || sizeofcmds <= 0 || sizeofcmds > MAX_TABLE_BYTES || hdrSize + sizeofcmds > fileSize {
        return Vec.new()
    }
    let cmds = readAt(&mut f, hdrSize, sizeofcmds)
    return machoSections(cmds, ncmds, true)
}

// ── optimization level ──
//
// "Why are my locals <optimized out>?" is the second most common debugging
// surprise after missing -g, so the summary says how the code was compiled.
// Only what the binary records is reported, in this order of precision:
//   1. -O switches in a compile unit's DW_AT_producer (GCC records its switches
//      there by default) or DW_AT_APPLE_flags (clang's -grecord-command-line on
//      Darwin). Exact level.
//   2. DW_AT_APPLE_optimized on any subprogram: clang marks every optimized
//      function with it under Apple tuning (lldb's "compiled with optimization"
//      warning reads the same flag). Optimized, level unknown. Under that same
//      tuning its ABSENCE across clang units that have subprograms is a fact
//      too: LLVM emits it for every subprogram of an optimized unit.
//   3. Go build info's -gcflags: -N -l disables optimization and inlining.
// Anything else stays "unknown".

// A forward-only reader over a byte buffer. `bad` latches on any read past the
// end, so callers check once after a run of reads instead of after each.
struct Cur {
    pos: i64,
    bad: bool,
}

impl Cur {
    fn u8(self: &mut Self, b: &string): i64 {
        if self.pos >= b.len {
            self.bad = true
            return 0
        }
        let v = b[self.pos] as i64
        self.pos = self.pos + 1
        return v
    }

    fn fixed(self: &mut Self, b: &string, width: i64, little: bool): i64 {
        var v: i64 = 0
        if width == 8 {
            v = u64At(b, self.pos, little)
        } else {
            v = uintAt(b, self.pos, width, little)
        }
        if v < 0 {
            self.bad = true
            return 0
        }
        self.pos = self.pos + width
        return v
    }

    fn skip(self: &mut Self, b: &string, n: i64): void {
        if n < 0 || self.pos + n > b.len {
            self.bad = true
            return
        }
        self.pos = self.pos + n
    }

    // ULEB128. SLEB128 has the same length, and every value read through this
    // is a code, form, length or index, so the sign is never needed. Bits past
    // 56 are dropped rather than shifted: arithmetic is checked and would trap.
    fn leb(self: &mut Self, b: &string): i64 {
        var v: i64 = 0
        var shift: i64 = 0
        while true {
            let byte = self.u8(b)
            if self.bad {
                return 0
            }
            if shift < 56 {
                v = v | ((byte & 127) << shift)
            }
            shift = shift + 7
            if (byte & 128) == 0 {
                break
            }
        }
        return v
    }

    fn cstr(self: &mut Self, b: &string): string {
        let s = cstrAt(b, self.pos, 4096)
        self.skip(b, s.len + 1)
        return s
    }
}

// One attribute value of a compile-unit DIE, as far as strings need it:
// kind 1 = inline text, 2 = .debug_str offset, 3 = .debug_line_str offset,
// 4 = .debug_str_offsets index; 0 = anything else (num holds a constant).
struct FormVal {
    kind: i64,
    num: i64,
    text: string,
}

// Read one value of `form` (DWARF 2-5 plus the GNU split-DWARF forms),
// advancing past it. Unknown forms latch `bad`: the size of what follows is
// then unknowable and the rest of the DIE is noise.
fn readForm(c: &mut Cur, b: &string, form: i64, os: i64, asz: i64, little: bool): FormVal {
    var v = FormVal { kind: 0, num: 0, text: "" }
    if form == 8 {
        v.kind = 1
        v.text = c.cstr(b)
    } else if form == 14 {
        v.kind = 2
        v.num = c.fixed(b, os, little)
    } else if form == 31 {
        v.kind = 3
        v.num = c.fixed(b, os, little)
    } else if form == 26 || form == 7938 {
        v.kind = 4
        v.num = c.leb(b)
    } else if form >= 37 && form <= 40 {
        v.kind = 4
        v.num = c.fixed(b, form - 36, little)
    } else if form == 1 {
        c.skip(b, asz)
    } else if form == 11 || form == 12 || form == 17 {
        v.num = c.fixed(b, 1, little)
    } else if form == 5 || form == 18 {
        v.num = c.fixed(b, 2, little)
    } else if form == 6 || form == 19 || form == 28 {
        v.num = c.fixed(b, 4, little)
    } else if form == 7 || form == 20 || form == 32 || form == 36 {
        v.num = c.fixed(b, 8, little)
    } else if form == 16 || form == 23 || form == 29 || form == 7968 || form == 7969 {
        v.num = c.fixed(b, os, little)
    } else if form == 13 || form == 15 || form == 21 || form == 27 || form == 34 || form == 35 || form == 7937 {
        v.num = c.leb(b)
    } else if form >= 41 && form <= 44 {
        c.skip(b, form - 40)
    } else if form == 30 {
        c.skip(b, 16)
    } else if form == 25 || form == 33 {
        // flag_present / implicit_const: no bytes in the DIE
    } else if form == 9 || form == 24 {
        let n = c.leb(b)
        c.skip(b, n)
    } else if form == 10 {
        let n = c.fixed(b, 1, little)
        c.skip(b, n)
    } else if form == 3 {
        let n = c.fixed(b, 2, little)
        c.skip(b, n)
    } else if form == 4 {
        let n = c.fixed(b, 4, little)
        c.skip(b, n)
    } else if form == 22 {
        let inner = c.leb(b)
        if inner == 22 {
            c.bad = true
            return v
        }
        return readForm(&mut c, b, inner, os, asz, little)
    } else {
        c.bad = true
    }
    return v
}

// The -O level a compiler command line asks for, or "" if it names none. The
// last switch wins, as it does for the compiler; a bare "-O" is -O1.
pub fn optLevelOf(cmdline: &string): string {
    var level: string = ""
    for tok in cmdline.splitWhitespace() {
        if !tok.startsWith("-O") {
            continue
        }
        let rest = tok.substr(2, tok.len)
        if rest.len == 0 {
            level = "-O1"
        } else if rest == "0" || rest == "1" || rest == "2" || rest == "3" || rest == "s"
            || rest == "z" || rest == "g" || rest == "fast" {
            level = tok.clone()
        }
    }
    return level
}

// The level a producer string pins down: its own -O switch, or -O0 for a GCC
// producer that recorded switches but no -O (GCC's default is -O0 and it
// records every switch it was given, so a missing -O is the default, not a gap).
pub fn producerOptLevel(producer: &string): string {
    let lvl = optLevelOf(producer)
    if lvl.len > 0 {
        return lvl
    }
    if producer.startsWith("GNU ") && producer.contains(" -") {
        return "-O0"
    }
    return ""
}

fn dwarfString(f: &mut File, sects: &Vec<Sect>, v: &FormVal, strOffBase: i64, os: i64, little: bool): string {
    if v.kind == 1 {
        return v.text.clone()
    }
    var sectName = ".debug_str"
    var strOff = v.num
    if v.kind == 3 {
        sectName = ".debug_line_str"
    } else if v.kind == 4 {
        let so = sectIndex(sects, ".debug_str_offsets")
        if so < 0 {
            return ""
        }
        let at = strOffBase + v.num * os
        if at < 0 || at + os > sects[so].size {
            return ""
        }
        let raw = readAt(&mut f, sects[so].off + at, os)
        if os == 8 {
            strOff = u64At(raw, 0, little)
        } else {
            strOff = u32At(raw, 0, little)
        }
    } else if v.kind != 2 {
        return ""
    }
    let si = sectIndex(sects, sectName)
    if si < 0 || strOff < 0 || strOff >= sects[si].size {
        return ""
    }
    var want = sects[si].size - strOff
    if want > 4096 {
        want = 4096
    }
    return cstrAt(readAt(&mut f, sects[si].off + strOff, want), 0, 4096)
}

// Find abbreviation declaration `code` in the table at `tableOff`, leaving `c`
// on its first attribute spec; false if the table does not have it.
fn seekAbbrev(c: &mut Cur, abbrev: &string, tableOff: i64, code: i64): bool {
    c.pos = tableOff
    c.bad = false
    while !c.bad {
        let k = c.leb(abbrev)
        if k == 0 || c.bad {
            return false
        }
        let _tag = c.leb(abbrev)
        c.skip(abbrev, 1)
        if k == code {
            return !c.bad
        }
        skipAttrSpecs(&mut c, abbrev)
    }
    return false
}

// Past one declaration's (attribute, form[, implicit const]) list.
fn skipAttrSpecs(c: &mut Cur, abbrev: &string): void {
    while !c.bad {
        let at = c.leb(abbrev)
        let fm = c.leb(abbrev)
        if fm == 33 {
            let _ic = c.leb(abbrev)
        }
        if at == 0 && fm == 0 {
            return
        }
    }
}

// Fill info.opt* from the DWARF in `sects` (this file, or its dSYM's).
fn dwarfOpt(info: &mut BinInfo, f: &mut File, sects: &Vec<Sect>, appleTuning: bool): void {
    let ii = sectIndex(sects, ".debug_info")
    let ai = sectIndex(sects, ".debug_abbrev")
    if ii < 0 || ai < 0 || sects[ai].size <= 0 {
        return
    }
    var abbrevSize = sects[ai].size
    if abbrevSize > MAX_TABLE_BYTES {
        abbrevSize = MAX_TABLE_BYTES
    }
    let abbrev = readAt(&mut f, sects[ai].off, abbrevSize)
    let little = info.endian != "big"

    // Pass 1: the abbreviation tables alone say whether any subprogram can carry
    // DW_AT_APPLE_optimized (0x3fe1): a producer only declares what it uses.
    var hasSubprogram = false
    var hasAppleOpt = false
    var c = Cur { pos: 0, bad: false }
    while c.pos < abbrev.len && !c.bad {
        let code = c.leb(abbrev)
        if code == 0 {
            continue // end of one unit's table; the next follows
        }
        let tag = c.leb(abbrev)
        c.skip(abbrev, 1)
        if tag == 46 {
            hasSubprogram = true
        }
        while !c.bad {
            let at = c.leb(abbrev)
            let fm = c.leb(abbrev)
            if fm == 33 {
                let _ic = c.leb(abbrev)
            }
            if at == 0 && fm == 0 {
                break
            }
            if at == 16353 && tag == 46 {
                hasAppleOpt = true
            }
        }
    }

    // Pass 2: the first DIE of each compile unit, for its producer and flags.
    // Bounded: a few hundred units say everything the summary needs.
    var level: string = ""
    var producer: string = ""
    var fromFlags = false
    var units: i64 = 0
    var off: i64 = 0
    let infoSize = sects[ii].size
    while off + 11 < infoSize && units < 256 {
        let hdr = readAt(&mut f, sects[ii].off + off, 32)
        let len32 = u32At(hdr, 0, little)
        var os: i64 = 4
        var hlen: i64 = 4
        var ulen = len32
        if len32 == 4294967295 {
            os = 8
            hlen = 12
            ulen = u64At(hdr, 4, little)
        } else if len32 >= 4294967280 {
            break
        }
        if ulen <= 0 {
            break
        }
        let ver = u16At(hdr, hlen, little)
        var hc = Cur { pos: hlen + 2, bad: false }
        var abbrOff: i64 = 0
        var asz: i64 = 8
        if ver >= 5 {
            let utype = hc.u8(hdr)
            asz = hc.u8(hdr)
            abbrOff = hc.fixed(hdr, os, little)
            // skeleton/split units carry a dwo_id, type units a signature and offset
            if utype == 4 || utype == 5 {
                hc.skip(hdr, 8)
            } else if utype == 2 || utype == 6 {
                hc.skip(hdr, 8 + os)
            }
        } else if ver >= 2 {
            abbrOff = hc.fixed(hdr, os, little)
            asz = hc.u8(hdr)
        } else {
            break
        }
        if hc.bad {
            break
        }
        let unitEnd = off + hlen + ulen
        var dieLen = unitEnd - off - hc.pos
        if dieLen > 4096 {
            dieLen = 4096
        }
        let die = readAt(&mut f, sects[ii].off + off + hc.pos, dieLen)
        var dc = Cur { pos: 0, bad: false }
        let code = dc.leb(die)
        var ac = Cur { pos: 0, bad: false }
        if code > 0 && seekAbbrev(&mut ac, abbrev, abbrOff, code) {
            var prod = FormVal { kind: 0, num: 0, text: "" }
            var flags = FormVal { kind: 0, num: 0, text: "" }
            var strOffBase: i64 = 8
            while !ac.bad && !dc.bad {
                let at = ac.leb(abbrev)
                let fm = ac.leb(abbrev)
                if fm == 33 {
                    let _ic = ac.leb(abbrev)
                }
                if at == 0 && fm == 0 {
                    break
                }
                let v = readForm(&mut dc, die, fm, os, asz, little)
                if at == 37 {
                    prod = v
                } else if at == 16354 {
                    flags = v
                } else if at == 114 {
                    strOffBase = v.num
                }
            }
            let ptext = dwarfString(&mut f, sects, prod, strOffBase, os, little)
            let ftext = dwarfString(&mut f, sects, flags, strOffBase, os, little)
            if producer.len == 0 {
                producer = ptext.clone()
            }
            var lvl = producerOptLevel(ptext)
            let flvl = optLevelOf(ftext)
            if flvl.len > 0 {
                lvl = flvl
                fromFlags = true
            }
            // One optimized unit is what the warning is about: it wins over -O0s.
            if lvl.len > 0 && (level.len == 0 || (level == "-O0" && lvl != "-O0")) {
                level = lvl
            }
        }
        units = units + 1
        off = unitEnd
    }

    if level.len > 0 {
        info.optimized = level != "-O0"
        info.opt = level
        info.optSource = "DW_AT_producer"
        if fromFlags {
            info.optSource = "DW_AT_APPLE_flags"
        }
    } else if hasAppleOpt {
        info.opt = "optimized"
        info.optimized = true
        info.optSource = "DW_AT_APPLE_optimized"
    } else if appleTuning && hasSubprogram && producer.contains("clang") {
        info.opt = "not optimized"
        info.optimized = false
        info.optSource = "no DW_AT_APPLE_optimized"
    }
}

// Go's -gcflags in the embedded module info decide: -N (no optimization) and
// -l (no inlining) together are what delve asks for. Without them Go optimized,
// which is its compiler's default, not a guess.
fn goOpt(info: &mut BinInfo, f: &mut File, sects: &Vec<Sect>): void {
    let gi = sectIndex(sects, ".go.buildinfo")
    if gi < 0 {
        return
    }
    var want = sects[gi].size
    if want > 65536 {
        want = 65536
    }
    let blob = readAt(&mut f, sects[gi].off, want)
    // Header: 14-byte magic "\xff Go buildinf:", pointer size, flags. Flag bit
    // 2 means the version and module strings follow inline (Go 1.18+); older
    // binaries point at them through the data segment, which this does not chase.
    if blob.len < 32 || blob[0] != 255 || blob.substr(1, 14) != " Go buildinf:" || (blob[15] & 2) == 0 {
        return
    }
    info.optSource = "Go build info"
    if goFlagsUnoptimized(goGcflags(blob)) {
        info.opt = "-N -l"
        info.optimized = false
    } else {
        info.opt = "optimized"
        info.optimized = true
    }
}

// The value of the "build\t-gcflags=..." line in Go module info text, or "".
pub fn goGcflags(modinfo: &string): string {
    let parts = modinfo.split("build\t-gcflags=")
    if parts.len < 2 {
        return ""
    }
    var out: string = ""
    for ch in parts[1] {
        if ch == '\n' {
            break
        }
        out.push(ch)
    }
    return out
}

// -gcflags values carry an optional package pattern and, when they hold a
// space, the quotes `go build` recorded them with ("all=-N -l" arrives as
// `"all=-N -l"`); the switch is what follows the '='. Both -N and -l are what
// makes Go code steppable.
pub fn goFlagsUnoptimized(flags: &string): bool {
    var n = false
    var l = false
    var unquoted: string = ""
    for ch in flags {
        if ch != '"' {
            unquoted.push(ch)
        }
    }
    for tok in unquoted.splitWhitespace() {
        let eq = tok.split("=")
        let t = eq[eq.len - 1].clone()
        if t == "-N" {
            n = true
        } else if t == "-l" {
            l = true
        }
    }
    return n && l
}
