// Server state for the one debug session this process hosts, grouped by what
// each part describes. One global instance, gSession.
//
// Green runtime = one OS thread, cooperative scheduling: a plain global is
// race-free at yield-point granularity. Any sequence below that a comment calls
// atomic is atomic because it contains no yield point, not because of a lock.

from "../dap/session" import {
    LaunchSpec
}
from "std/pty" import {
    Pty
}
from "std/term" import {
    TermSize
}
from "std/sync" import {
    Channel
}

// A browser-set breakpoint. Keyed by (path, line); empty
// condition/hitCondition/logMessage mean a plain breakpoint — the keys are
// omitted from the DAP request.
pub struct Bp {
    path: string,
    line: i64,
    condition: string,
    hitCondition: string,
    logMessage: string,
    // Disabled bps stay in the list (and in bpSync) but are omitted from the
    // DAP request — DAP has no per-bp enable, absence IS disable.
    enabled: bool,
}

pub fn cloneBp(b: &Bp): Bp {
    return Bp {
        path: b.path.clone(),
        line: b.line,
        condition: b.condition.clone(),
        hitCondition: b.hitCondition.clone(),
        logMessage: b.logMessage.clone(),
        enabled: b.enabled,
    }
}

// one buffered terminal line for late-join replay.
pub struct OutLine {
    text: string,
    category: string,
}

// What to debug and how. `spec` is a VS Code launch configuration lowered by
// ../dap/session: meta keys (type/request/name/source/dapPath/stopAtMain/
// program/port/host) become its fields, every other key lands verbatim in
// spec.launchExtra (the DAP body). spec.srcPath is always canonical (absSourcePath).
pub struct Target {
    spec: LaunchSpec,
    // per-run (set from the run cmd): break at main / first user line.
    // spec.stopAtMain is the config's default for it.
    stopAtMain: bool,
    // JSON array of selected exception filter ids.
    excFilters: Option<string>,
}

// This server process as a registry entry and a CLI program.
pub struct ServerInfo {
    // Three words, not a uuid: this id is read off a screen, typed into
    // `api --session`, and pasted in a URL. See newSessionName in ../sessions.
    // In hello, so a reloaded tab detects same-vs-new session.
    sessionId: string,
    // the port we bound; the registry descriptor carries it. None until bound.
    listenPort: Option<i64>,
    startedAt: i64, // when this server bound its port, for the dashboard
    noBrowser: bool,
    idleTtlSecs: i64, // --idle-ttl; 0 = never reap
    // lifecycle log. 0 = --quiet (banner only), 1 = normal, 2 = --verbose
    // (adds per-stop lines). Runtime events go to stdout — a server should read
    // like a server; stderr stays for errors.
    logLevel: i64,
    // UI bundle dir served from disk (--webroot); None serves the embedded copy.
    webroot: Option<string>,
    restored: bool, // booted idle and staged history[0] (banner hint)
}

// js-debug runs the debuggee under a CHILD session it asks us to start (the
// startDebugging reverse request). The child's launch body arrives in that
// request and replaces our built launch args.
pub struct ChildLaunch {
    body: string,
    request: string, // "launch" | "attach": the child's DAP command
}

// A forced run must kill+rerun (a new config can't ride a live adapter). D's
// terminated cleanup consumes this and re-spawns once the old debuggee is gone.
pub struct PendingRun {
    config: Option<string>, // None reruns the current config
    stopAtMain: bool, // the force-run's per-run stopAtMain
}

// The adapter and debuggee of the current run. D's teardown re-arms all of it
// when the run ends.
pub struct RunState {
    started: bool,
    // R's write fd into the adapter; Some exactly while a run is live.
    dapIn: Option<i32>,
    // The live debuggee pty, for stdin and resize.
    pty: Option<Pty>,
    // The browser sizes its terminal on mount, before any pty exists, so the
    // last size asked for is kept and applied at spawn.
    term: Option<TermSize>,
    oddSeq: i64, // +2 per R send → 1, 3, 5, … (D's DapClient uses even)
    stdinBuf: string, // keystrokes typed before the pty exists
    // Recent adapter stderr, captured off the DAP stream (see startArgs). Surfaced
    // only when the adapter dies before the handshake completes — otherwise silence.
    // Bounded to the first chunk that matters (a startup traceback); reset each run.
    adapterStderr: string,
    // js-debug support: its DAP server only listens on TCP, so the node dialect
    // spawns it (`node dapDebugServer.js 0`), parses the printed port, and connects.
    // srvPid/srvPort are that spawned server — the pid is SIGTERMed at session
    // teardown, since closing the sockets leaves it listening.
    srvPid: Option<i64>,
    srvPort: Option<i64>,
    // pid of a LAUNCHED debuggee, from the adapter's `process` event (None for attach).
    // Behind a spawned TCP adapter the debuggee is our grandchild: killing the
    // adapter server orphans it instead of ending it, so teardown checks this pid.
    debuggeePid: Option<i64>,
    // Write fd of the PARENT session after a js-debug child handoff.
    // The parent is the session that owns the launched process: a disconnect sent
    // only to the child ends the debug connection and leaves the program running.
    parentIn: Option<i32>,
    child: Option<ChildLaunch>,
    pendingRun: Option<PendingRun>,
    runStartMs: i64, // epochMillis at adapter spawn — run duration
    lastExit: Option<i64>, // debuggee exitCode from the "exited" event
}

impl RunState {
    // The seq for the next request R sends.
    fn nextSeq(self: &mut Self): i64 {
        self.oddSeq = self.oddSeq + 2
        return self.oddSeq
    }
}

// one broadcaster fans the session bus out to every connected peer.
pub struct Sink {
    id: i64,
    ch: Channel<string>,
}

pub struct Peers {
    // The peer registry lives here, not in a Channel<Sink>: std/sync moves a
    // payload with memcpy + memset-to-zero and lets the zeroed original drop, and
    // Channel's own Drop dereferences its handle unconditionally — so a Sink (which
    // owns a Channel<string>) segfaults the moment it is sent through a channel.
    // Every peer task and the broadcaster are green tasks on one scheduler thread
    // and none of the register/unregister/fanout sequences contain a yield
    // point, so direct mutation is exactly as atomic as the channel round-trip was.
    sinks: Vec<Sink>,
    count: i64, // attached WS peers (browser tabs; `api` callers are one-shot HTTP)
    nextClient: i64,
    lastActivityMs: i64, // epochMillis of the last peer event OR api call — idle-ttl clock
}

// What outlives the server process (XDG state).
pub struct Persisted {
    history: string, // config history JSON array, newest first, cap 10
    bps: Vec<Bp>, // shared breakpoint set, keyed by program on disk
}

pub struct Session {
    target: Target,
    proc: RunState,
    peers: Peers,
    persisted: Persisted,
    // recent terminal output (debugger console + program stdout/stderr),
    // replayed to a joining tab so startup chatter and history survive reload /
    // late join. Bounded — a non-pty adapter routes ALL program output here.
    output: Vec<OutLine>,
    server: ServerInfo,
}

pub var gSession: Session = Session {
    target: Target {
        spec: LaunchSpec {
            binPath: "", srcPath: "", adapterCmd: "", adapterKind: "", launchExtra: "",
            stopAtMain: false, request: "", host: "", port: 0, name: "", dapPath: "",
        },
        stopAtMain: false,
        excFilters: Option.None,
    },
    proc: RunState {
        started: false, dapIn: Option.None, pty: Option.None, term: Option.None,
        oddSeq: -1, stdinBuf: "", adapterStderr: "", srvPid: Option.None,
        srvPort: Option.None, debuggeePid: Option.None, parentIn: Option.None,
        child: Option.None, pendingRun: Option.None, runStartMs: 0, lastExit: Option.None,
    },
    peers: Peers {
        sinks: [], count: 0, nextClient: 1, lastActivityMs: 0,
    },
    persisted: Persisted {
        history: "", bps: [],
    },
    output: [],
    server: ServerInfo {
        sessionId: "", listenPort: Option.None, startedAt: 0, noBrowser: false,
        idleTtlSecs: 0, logLevel: 0, webroot: Option.None, restored: false,
    },
}
