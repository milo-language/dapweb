// Server state for the one debug session this process hosts, grouped by what
// each part describes. One global instance, gSession.
//
// Green runtime = one OS thread, cooperative scheduling: a plain global is
// race-free at yield-point granularity. Any sequence below that a comment calls
// atomic is atomic because it contains no yield point, not because of a lock.

from "../dap/session" import {
    LaunchSpec, adapterIdForKind, specConfigJson
}
from "std/json" import {
    Json
}
from "std/io" import {
    readFile
}
from "std/pty" import {
    Pty
}
from "std/term" import {
    TermSize
}
from "std/sync" import {
    Channel
}
from "std/seal" import {
    Shared, seal
}

// A browser-set breakpoint. Keyed by (path, line); empty
// condition/hitCondition/logMessage mean a plain breakpoint — the keys are
// omitted from the DAP request.
pub struct Bp {
    path: string,
    line: i64,
    condition: string,
    hitCondition: string,
    logMessage: string,
    // Disabled bps stay in the list (and in bpSync) but are omitted from the
    // DAP request — DAP has no per-bp enable, absence IS disable.
    enabled: bool,
}

pub fn cloneBp(b: &Bp): Bp {
    return Bp {
        path: b.path.clone(),
        line: b.line,
        condition: b.condition.clone(),
        hitCondition: b.hitCondition.clone(),
        logMessage: b.logMessage.clone(),
        enabled: b.enabled,
    }
}

// one buffered terminal line for late-join replay.
pub struct OutLine {
    text: string,
    category: string,
}

// What to debug and how. `spec` is a VS Code launch configuration lowered by
// ../dap/session: meta keys (type/request/name/source/dapPath/stopAtMain/
// program/port/host) become its fields, every other key lands verbatim in
// spec.launchExtra (the DAP body). spec.srcPath is always canonical (absSourcePath).
pub struct Target {
    spec: LaunchSpec,
    // per-run (set from the run cmd): break at main / first user line.
    // spec.stopAtMain is the config's default for it.
    stopAtMain: bool,
    // JSON array of selected exception filter ids.
    excFilters: Option<string>,
}

// This server process as a registry entry and a CLI program.
pub struct ServerInfo {
    // Three words, not a uuid: this id is read off a screen, typed into
    // `api --session`, and pasted in a URL. See newSessionName in ../sessions.
    // In hello, so a reloaded tab detects same-vs-new session.
    sessionId: string,
    // the port we bound; the registry descriptor carries it. None until bound.
    listenPort: Option<i64>,
    startedAt: i64, // when this server bound its port, for the dashboard
    noBrowser: bool,
    idleTtlSecs: i64, // --idle-ttl; 0 = never reap
    // lifecycle log. 0 = --quiet (banner only), 1 = normal, 2 = --verbose
    // (adds per-stop lines). Runtime events go to stdout — a server should read
    // like a server; stderr stays for errors.
    logLevel: i64,
    // UI bundle dir served from disk (--webroot); None serves the embedded copy.
    webroot: Option<string>,
    restored: bool, // booted idle and staged history[0] (banner hint)
}

// js-debug runs the debuggee under a CHILD session it asks us to start (the
// startDebugging reverse request). The child's launch body arrives in that
// request and replaces our built launch args.
pub struct ChildLaunch {
    body: string,
    request: string, // "launch" | "attach": the child's DAP command
}

// A forced run must kill+rerun (a new config can't ride a live adapter). D's
// terminated cleanup consumes this and re-spawns once the old debuggee is gone.
pub struct PendingRun {
    config: Option<string>, // None reruns the current config
    stopAtMain: bool, // the force-run's per-run stopAtMain
}

// The adapter and debuggee of the current run. D's teardown re-arms all of it
// when the run ends.
pub struct RunState {
    started: bool,
    // R's write fd into the adapter; Some exactly while a run is live.
    dapIn: Option<i32>,
    // The live debuggee pty, for stdin and resize.
    pty: Option<Pty>,
    // The browser sizes its terminal on mount, before any pty exists, so the
    // last size asked for is kept and applied at spawn.
    term: Option<TermSize>,
    oddSeq: i64, // +2 per R send → 1, 3, 5, … (D's DapClient uses even)
    stdinBuf: string, // keystrokes typed before the pty exists
    // Recent adapter stderr, captured off the DAP stream (see startArgs). Surfaced
    // only when the adapter dies before the handshake completes — otherwise silence.
    // Bounded to the first chunk that matters (a startup traceback); reset each run.
    adapterStderr: string,
    // js-debug support: its DAP server only listens on TCP, so the node dialect
    // spawns it (`node dapDebugServer.js 0`), parses the printed port, and connects.
    // srvPid/srvPort are that spawned server; the pid is SIGTERMed at session
    // teardown, since closing the sockets leaves it listening.
    srvPid: Option<i64>,
    srvPort: Option<i64>,
    // pid of a LAUNCHED debuggee, from the adapter's `process` event (None for attach).
    // Behind a spawned TCP adapter the debuggee is our grandchild: killing the
    // adapter server orphans it instead of ending it, so teardown checks this pid.
    debuggeePid: Option<i64>,
    // Write fd of the PARENT session after a js-debug child handoff.
    // The parent is the session that owns the launched process: a disconnect sent
    // only to the child ends the debug connection and leaves the program running.
    parentIn: Option<i32>,
    child: Option<ChildLaunch>,
    pendingRun: Option<PendingRun>,
    // The line a runToCursor is heading for. Kept out of persisted.bps so no
    // peer ever lists it as a breakpoint; it rides along in every setBreakpoints
    // for its file until the next stop of any kind takes it out of the adapter.
    runTo: Option<Bp>,
    runStartMs: i64, // epochMillis at adapter spawn — run duration
    lastExit: Option<i64>, // debuggee exitCode from the "exited" event
    // Who last sent a command that moves the program (cmdMovesProgram): the
    // next stop is theirs. "agent" for any non-browser peer, "user" otherwise,
    // and "user" before anyone has: a run nobody commanded was started by the
    // person who launched the server.
    driver: Attribution,
}

// Who caused something, as every peer is told it: `by` is "agent" or "user",
// `who` the peer's label ("browser", "claude (pid 42)").
pub struct Attribution {
    by: string,
    who: string,
}

pub fn userAttribution(): Attribution {
    return Attribution { by: "user", who: "browser" }
}

// The same rule the activity announcement uses: anything not a browser tab is
// an agent, since a person at a terminal typing `dapweb api` is rare and an
// unannounced program move is the failure being prevented.
pub fn attributionFor(peerKind: &string, label: &string): Attribution {
    if peerKind == "browser" {
        return Attribution { by: "user", who: label.clone() }
    }
    return Attribution { by: "agent", who: label.clone() }
}

impl RunState {
    // The seq for the next request R sends.
    fn nextSeq(self: &mut Self): i64 {
        self.oddSeq = self.oddSeq + 2
        return self.oddSeq
    }
}

// one broadcaster fans the session bus out to every connected peer.
pub struct Sink {
    id: i64,
    ch: Channel<Shared>,
}

pub struct Peers {
    // The peer registry lives here, not in a Channel<Sink>: std/sync moves a
    // payload with memcpy + memset-to-zero and lets the zeroed original drop, and
    // Channel's own Drop dereferences its handle unconditionally — so a Sink (which
    // owns a Channel) segfaults the moment it is sent through a channel.
    // Every peer task and the broadcaster are green tasks on one scheduler thread
    // and none of the register/unregister/fanout sequences contain a yield
    // point, so direct mutation is exactly as atomic as the channel round-trip was.
    sinks: Vec<Sink>,
    count: i64, // attached WS peers (browser tabs; `api` callers are one-shot HTTP)
    nextClient: i64,
    lastActivityMs: i64, // epochMillis of the last peer event OR api call — idle-ttl clock
}

// What outlives the server process (XDG state).
pub struct Persisted {
    history: string, // config history JSON array, newest first, cap 10
    bps: Vec<Bp>, // shared breakpoint set, keyed by program on disk
}

// One stop as the UI shows it. frames/locals are the JSON arrays framesJson and
// localsJson build from the adapter's bodies.
pub struct StopInfo {
    line: i64,
    path: string,
    tid: i64,
    reason: string, // DAP stopped.reason
    description: string, // optional human text the adapter attached
    atMain: bool, // the stop-at-main breakpoint, not one the user set
    scopeRef: string, // raw JSON number: setVariable's parent ref for top-level locals
    registersRef: i64, // register scope ref (0 = adapter has none)
    frames: string,
    locals: string,
    by: Attribution, // the driver when this stop arrived
}

pub struct ThreadList {
    current: i64, // the stopping thread
    threads: string, // JSON array from threadsJson
}

// What a tab joining now needs to show the adapter and the current stop. The
// stop fields are Some only while the debuggee is stopped; caps lives for the run.
pub struct StopState {
    caps: Option<string>, // the adapter's raw initialize response
    stop: Option<StopInfo>,
    threads: Option<ThreadList>,
    regions: Option<string>, // JSON array from regionsJson (lldb only)
}

impl StopState {
    // Resumed: the stop is stale for late joiners. Caps stay; they are the run's.
    fn resume(self: &mut Self): void {
        self.stop = Option.None
        self.threads = Option.None
        self.regions = Option.None
    }
}

pub struct Session {
    target: Target,
    proc: RunState,
    stop: StopState,
    peers: Peers,
    persisted: Persisted,
    // recent terminal output (debugger console + program stdout/stderr),
    // replayed to a joining tab so startup chatter and history survive reload /
    // late join. Bounded — a non-pty adapter routes ALL program output here.
    output: Vec<OutLine>,
    server: ServerInfo,
}

pub var gSession: Session = Session {
    target: Target {
        spec: LaunchSpec {
            binPath: "", srcPath: "", adapterCmd: "", adapterKind: "", launchExtra: "",
            stopAtMain: false, request: "", host: "", port: 0, name: "", dapPath: "",
        },
        stopAtMain: false,
        excFilters: Option.None,
    },
    proc: RunState {
        started: false, dapIn: Option.None, pty: Option.None, term: Option.None,
        oddSeq: -1, stdinBuf: "", adapterStderr: "", srvPid: Option.None,
        srvPort: Option.None, debuggeePid: Option.None, parentIn: Option.None,
        child: Option.None, pendingRun: Option.None, runTo: Option.None, runStartMs: 0, lastExit: Option.None,
        driver: Attribution { by: "user", who: "browser" },
    },
    stop: StopState {
        caps: Option.None, stop: Option.None, threads: Option.None, regions: Option.None,
    },
    peers: Peers {
        sinks: [], count: 0, nextClient: 1, lastActivityMs: 0,
    },
    persisted: Persisted {
        history: "", bps: [],
    },
    output: [],
    server: ServerInfo {
        sessionId: "", listenPort: Option.None, startedAt: 0, noBrowser: false,
        idleTtlSecs: 0, logLevel: 0, webroot: Option.None, restored: false,
    },
}

// ── Messages rendered from session state ──
//
// The live pushes and the late-join snapshot both go through these, so a tab
// that joins mid-stop is sent the bytes a tab that watched live was sent.

impl Session {
    // The late-join replay, in the order a tab applies it: hello resets the
    // client, source and caps before the breakpoints that key on them, then the
    // stop and what refines it, then the terminal history.
    fn snapshot(self: &Self): Vec<Shared> {
        var out: Vec<Shared> = []
        out.push(seal(helloMsg(self)).share())
        if self.target.spec.srcPath.len > 0 {
            out.push(seal(sourceMsg(self.target.spec.srcPath)).share())
        }
        if let Option.Some(c) = self.stop.caps {
            out.push(seal(capsMsg(c)).share())
        }
        for bp in self.persisted.bps {
            out.push(seal(bpSyncMsg(bp)).share())
        }
        if let Option.Some(st) = self.stop.stop {
            out.push(seal(stoppedMsg(st)).share())
        }
        if let Option.Some(t) = self.stop.threads {
            out.push(seal(threadsMsg(t)).share())
        }
        if let Option.Some(r) = self.stop.regions {
            out.push(seal(regionsMsg(r)).share())
        }
        // Flagged so a same-session reconnect (which kept its scrollback) can
        // drop it; a fresh/new-session tab renders it.
        for o in self.output {
            out.push(seal(Json.obj().str("type", "output").str("text", o.text).str("category", o.category).bool("replay", true).build()).share())
        }
        return out
    }
}

pub fn helloMsg(s: &Session): string {
    // `config` is THE canonical launch-config object (what the editor shows and
    // resolveConfig accepts back verbatim); program/adapterCmd ride alongside as
    // display conveniences (toolbar span, ⓘ adapter line).
    var b = Json.obj().str("type", "hello")
        .str("program", s.target.spec.binPath)
        .str("sourcePath", s.target.spec.srcPath)
        .str("adapterCmd", s.target.spec.adapterCmd)
        .str("adapterId", adapterIdForKind(s.target.spec.adapterKind))
        .str("sessionId", s.server.sessionId)
        .raw("config", specConfigJson(s.target.spec, true, 0 as i64))
    // late joiners need to know a session is live (kill-confirm on Run etc.);
    // a replayed stopped snapshot then refines running → stopped.
    if s.proc.started {
        b = b.str("phase", "running")
    }
    b = b.raw("history", s.persisted.history)
    if s.server.restored {
        b = b.bool("restored", true)
    }
    return b.build()
}

pub fn sourceMsg(path: &string): string {
    return Json.obj().str("type", "source")
        .str("path", path)
        .str("content", sourceText(path))
        .build()
}

// A source a peer asked for: carries who asked, so a tab following the agent
// can tell an agent's openSource from its own frame click. The replay and the
// stop-driven pushes are nobody's request and use sourceMsg.
pub fn sourceMsgBy(path: &string, by: &Attribution): string {
    return Json.obj().str("type", "source")
        .str("path", path)
        .str("by", by.by).str("who", by.who)
        .str("content", sourceText(path))
        .build()
}

fn sourceText(path: &string): string {
    match readFile(path) {
        Result.Ok(text) => {
            return text
        }
        Result.Err(_e) => {
            // Frames without debug info (libc, dyld) report symbol pseudo-paths
            // like "/usr/lib/dyld`dyld4::...". Show a friendly placeholder
            // until the disassembly view exists.
            return "// no source available for this frame:\n//   " + path.clone()
            + "\n// (no debug info — try `disassemble --frame` in the Debug Console)"
        }
    }
}

// full bp state for a late-joining peer (acks are optimistic client-side).
pub fn bpSyncMsg(b: &Bp): string {
    return Json.obj().str("type", "bpSync")
        .str("path", b.path).int("line", b.line)
        .str("condition", b.condition)
        .str("hitCondition", b.hitCondition)
        .str("logMessage", b.logMessage)
        .bool("enabled", b.enabled)
        .build()
}

// The adapter's capabilities verbatim; the UI digs out .body and gates features on it.
pub fn capsMsg(raw: &string): string {
    return Json.obj().str("type", "capabilities").str("raw", raw).build()
}

pub fn stoppedMsg(st: &StopInfo): string {
    return Json.obj().str("type", "stopped")
        .int("line", st.line).str("path", st.path).int("tid", st.tid)
        .str("reason", st.reason).str("description", st.description)
        .bool("atMain", st.atMain)
        .str("by", st.by.by).str("who", st.by.who)
        .raw("scopeRef", st.scopeRef)
        .int("registersRef", st.registersRef)
        .raw("frames", st.frames)
        .raw("locals", st.locals).build()
}

pub fn threadsMsg(t: &ThreadList): string {
    return Json.obj().str("type", "threads").int("current", t.current)
        .raw("threads", t.threads).build()
}

pub fn regionsMsg(regions: &string): string {
    return Json.obj().str("type", "regions").raw("regions", regions).build()
}
