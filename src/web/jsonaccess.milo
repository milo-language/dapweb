// Shared DAP-message field readers over the one parse DapClient.recv made
// (DapMsg.doc). Milo mangles same-named fns across modules to one linkonce_odr
// symbol, so keeping these in two files silently merged one body (and now
// errors on drift); one definition removes that footgun. See docs/design.md.

from "std/json" import {
    Json
}

pub fn bodyI64(doc: &Json, key: &string, fallback: i64): i64 {
    return doc.curInt(doc.curField(doc.curField(doc.curRoot(), "body"), key)) ?? fallback
}

pub fn bodyStr(doc: &Json, key: &string): string {
    return doc.curStr(doc.curField(doc.curField(doc.curRoot(), "body"), key)) ?? ""
}

pub fn frame0Field(doc: &Json, key: &string): i64 {
    let f0 = doc.curChild(doc.curField(doc.curField(doc.curRoot(), "body"), "stackFrames"), 0)
    return doc.curInt(doc.curField(f0, key)) ?? 0
}

// stackTrace body → frame 0's source.path.
pub fn frame0Path(doc: &Json): string {
    return doc.curStr(doc.curPath("body.stackFrames[0].source.path")) ?? ""
}

pub fn scopes0Ref(doc: &Json): i64 {
    let s0 = doc.curChild(doc.curField(doc.curField(doc.curRoot(), "body"), "scopes"), 0)
    return doc.curInt(doc.curField(s0, "variablesReference")) ?? 0
}
