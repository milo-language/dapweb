// The command vocabulary's implementation: one handler per `{"cmd": ...}`
// name in ../commands, and the two ways commands arrive (R, the per-peer WS
// reader, and the HTTP API's /api/cmd).

from "../commands" import {
    isKnownCmd, cmdVerb, cmdNames
}
from "../dap/session" import {
    histMergeMany
}
from "../journal" import {
    journalCmd
}
from "../sessions" import {
    newSessionName
}
from "./dap_reader" import {
    Pending, sendReqFd, buildBpArgsForPath, excArgs, startRun
}
from "./peers" import {
    logEvent, peerCountStr, wsPush, peerPush, wsWriterLoop, sinkRegister, sinkUnregister, pushHelloState, configErrMsg, bpAckMsg
}
from "./persist" import {
    absSourcePath, applyConfig, persistBps, loadBps, persistHistory, recordConfig, historyChangedMsg, sessionNameSeeds, journalHere
}
from "./state" import {
    gSession, Bp, cloneBp, PendingRun, sourceMsg
}
from "std/json" import {
    Json
}
from "std/runtime" import {
    Task
}
from "std/seal" import {
    Sealed, Shared, sharedWith
}
from "std/sync" import {
    Channel
}
from "std/term" import {
    TermSize
}
from "std/time" import {
    epochMillis, sleepMs
}
from "std/ws" import {
    WsConn
}

// One client command (the `{"cmd": ...}` JSON the browser sends over WS), as a
// handler sees it. Factored out of the WS reader so the HTTP API drives the
// exact same verbs: one vocabulary, so `dapweb api` cannot drift from the UI.
struct Cmd {
    name: string,
    doc: Json, // the payload, parsed once
    payload: string, // setConfig hands the payload itself to applyConfig
    peerKind: string,
    bus: Channel<string>,
    pendCh: Channel<Pending>,
}

impl Cmd {
    fn str(self: &Self, key: &string): string {
        return self.doc.str(key) ?? ""
    }

    fn int(self: &Self, key: &string, fallback: i64): i64 {
        return self.doc.i64(key) ?? fallback
    }

    fn flag(self: &Self, key: &string, fallback: bool): bool {
        return self.doc.bool(key) ?? fallback
    }
}

// Send a DAP request whose response D routes back by `kind`; a no-op with no
// run live. Registered before the send: D drains pendings after each recv, so
// the entry must exist before the adapter can possibly reply, or the response
// is dropped unmatched.
fn sendPending(pendCh: &Channel<Pending>, kind: &string, id: i64, extra: string, command: &string, args: &string): void {
    if let Option.Some(dfd) = gSession.proc.dapIn {
        let seq = gSession.proc.nextSeq()
        let _p = pendCh.trySend(Pending {
            seq: seq, kind: kind.clone(), id: id, extra: extra
        }
        )
        sendReqFd(dfd, seq, command, args)
    }
}

// One human-readable line for what a command is about to do. Only the cases
// that can say something the table cannot (which line, which expression);
// everything else takes the table's verb, so there is no second list of
// commands here to fall behind the first.
fn activityText(cmd: &Cmd): string {
    if cmd.name == "evaluate" {
        return $"evaluate `{cmd.str("expr")}`"
    }
    if cmd.name == "setBreakpoint" {
        return $"set a breakpoint at line {cmd.int("line", 0 as i64)}"
    }
    if cmd.name == "clearBreakpoint" {
        return $"clear the breakpoint at line {cmd.int("line", 0 as i64)}"
    }
    if cmd.name == "setVar" {
        return $"set {cmd.str("name")} = {cmd.str("value")}"
    }
    return cmdVerb(cmd.name)
}

// Which file a command means, canonical. The breakpoint commands fall back to
// the session's source when the payload names none, and this is the only place
// that rule lives: the journal keys its breakpoint counts on the same answer the
// breakpoint itself is stored under, and two spellings of one path is exactly
// what would make those counts wrong.
fn cmdPath(c: &string, doc: &Json): string {
    var path = absSourcePath(doc.str("path") ?? "")
    if path.len == 0 && (c == "setBreakpoint" || c == "clearBreakpoint") {
        path = absSourcePath(gSession.target.spec.srcPath)
    }
    return path
}

// The handler for each command in ../commands' table. A known name with no arm
// here is refused like an unknown one. tests/e2e-commands.ts reads these arms
// to check that this match and the table agree in both directions.
fn cmdHandler(name: string): Option<(&Cmd) => void> {
    match name {
        "setBreakpoint" => { return Option.Some(cmdBreakpoint) }
        "clearBreakpoint" => { return Option.Some(cmdBreakpoint) }
        "run" => { return Option.Some(cmdRun) }
        "continue" => { return Option.Some(cmdStep) }
        "stepOver" => { return Option.Some(cmdStep) }
        "stepIn" => { return Option.Some(cmdStep) }
        "stepOut" => { return Option.Some(cmdStep) }
        "pause" => { return Option.Some(cmdStep) }
        "restart" => { return Option.Some(cmdRestart) }
        "kill" => { return Option.Some(cmdKill) }
        "evaluate" => { return Option.Some(cmdEvaluate) }
        "expand" => { return Option.Some(cmdExpand) }
        "threadStack" => { return Option.Some(cmdThreadStack) }
        "frameScopes" => { return Option.Some(cmdFrameScopes) }
        "setExceptions" => { return Option.Some(cmdSetExceptions) }
        "complete" => { return Option.Some(cmdComplete) }
        "readMem" => { return Option.Some(cmdReadMem) }
        "setVar" => { return Option.Some(cmdSetVar) }
        "disassemble" => { return Option.Some(cmdDisassemble) }
        "openSource" => { return Option.Some(cmdOpenSource) }
        "stdin" => { return Option.Some(cmdStdin) }
        "resize" => { return Option.Some(cmdResize) }
        "setConfig" => { return Option.Some(cmdSetConfig) }
        "importHistory" => { return Option.Some(cmdImportHistory) }
        "newSession" => { return Option.Some(cmdNewSession) }
        _ => { return Option.None }
    }
}

// None when the command ran; Some(the refused name) otherwise. A caller that
// answers over HTTP needs that: an unknown `cmd` used to fall off the end of the if-chain, do
// nothing, and still be answered {"ok":true}, so an agent's typo looked exactly
// like success. The check comes BEFORE the activity announcement too — telling
// the human "the agent is attempting to frobnicate" about a command that will
// not run is worse than saying nothing.
fn dispatchClientCmd(payload: string, peerKind: string, peerLabel: string, bus: &Channel<string>, pendCh: &Channel<Pending>): Option<string> {
    let Result.Ok(doc) = Json.parse(payload) else {
        journalCmd("", peerKind, peerLabel, false, "not a dapweb command", payload, "")
        return Option.Some("")
    }
    let c = doc.str("cmd") ?? ""
    var handler: Option<(&Cmd) => void> = Option.None
    if isKnownCmd(c) {
        handler = cmdHandler(c.clone())
    }
    let Option.Some(run) = handler else {
        journalCmd(c, peerKind, peerLabel, false, "not a dapweb command", payload, "")
        return Option.Some(c.clone())
    }
    journalCmd(c, peerKind, peerLabel, true, "", payload, cmdPath(c, doc))
    let cmd = Cmd {
        name: c, doc: doc, payload: payload, peerKind: peerKind,
        bus: bus.clone(), pendCh: pendCh.clone(),
    }
    // A browser peer's actions are self-evident to whoever performed them; an
    // agent's are not. Announce before acting, so the human watching the UI is
    // never surprised by a program that moves on its own.
    if cmd.peerKind != "browser" {
        let what = activityText(cmd)
        logEvent("agent", $"{peerLabel} is attempting to {what}")
        wsPush(bus, Json.obj().str("type", "activity")
            .str("peer", cmd.peerKind).str("who", peerLabel).str("cmd", cmd.name)
            .str("text", $"{peerLabel} is attempting to {what}").build())
    }
    run(cmd)
    return Option.None
}

fn cmdBreakpoint(cmd: &Cmd): void {
    let set = cmd.name == "setBreakpoint"
    let line = cmd.int("line", 0 as i64)
    let path = cmdPath(cmd.name, cmd.doc)
    // Upsert: drop any existing bp at (path, line), then re-add for
    // "set" (a condition edit is a set on an existing line).
    var keep: Vec<Bp> = []
    for bp in gSession.persisted.bps {
        if bp.line != line || bp.path != path {
            keep.push(cloneBp(bp))
        }
    }
    gSession.persisted.bps = keep
    // For a set this is the stored breakpoint; for a clear a bare (path, line)
    // is all a peer needs to drop its own copy.
    let bp = Bp {
        path: path.clone(), line: line,
        condition: cmd.str("condition"),
        hitCondition: cmd.str("hitCondition"),
        logMessage: cmd.str("logMessage"),
        enabled: cmd.flag("enabled", true),
    }
    if set {
        gSession.persisted.bps.push(cloneBp(bp))
    }
    persistBps()
    wsPush(cmd.bus, bpAckMsg(bp, set))
    sendPending(cmd.pendCh, "bpLive", 0, "", "setBreakpoints", buildBpArgsForPath(gSession.persisted.bps, path))
}

// The editor is the source of truth: an inline `config` object rides the run
// and is applied just before launch, no staging. A live session requires
// force:true (the client confirms with the user), which kills it and reruns
// with the new config after teardown.
fn cmdRun(cmd: &Cmd): void {
    var cfgRaw: string = ""
    if let Option.Some(v) = cmd.doc.get("config") {
        if v.isObject() {
            cfgRaw = v.rawStr()
        }
    }
    if gSession.proc.started {
        if !cmd.flag("force", false) || gSession.proc.dapIn.isNone() {
            wsPush(cmd.bus, configErrMsg("a debug session is already active — run with force:true to kill and relaunch"))
            return
        }
        var pcfg: Option<string> = Option.None
        if cfgRaw.len > 0 {
            pcfg = Option.Some(cfgRaw)
        }
        gSession.proc.pendingRun = Option.Some(PendingRun {
            config: pcfg, stopAtMain: cmd.flag("stopAtMain", gSession.target.spec.stopAtMain),
        }
        )
        logEvent("run killed", $"forced by {cmd.peerKind} peer — relaunching")
        sendPending(cmd.pendCh, "disc", 0, "", "disconnect", Json.obj().bool("terminateDebuggee", true).build())
        return
    }
    if cfgRaw.len > 0 {
        let err = applyConfig(cfgRaw, "")
        if err.len > 0 {
            wsPush(cmd.bus, configErrMsg(err))
            return
        }
        logEvent("target changed", $"{gSession.target.spec.binPath}  (by {cmd.peerKind} peer)")
        loadBps()
        pushHelloState(cmd.bus)
    }
    if gSession.target.spec.binPath.len == 0 && gSession.target.spec.request != "attach" {
        // Booted idle with no target: nudge to the config drawer instead
        // of spawning the adapter with an empty program path.
        wsPush(cmd.bus, configErrMsg("no program configured — set a debug target (⚙) before running"))
        return
    }
    // After applyConfig: the payload's flag falls back to the NEW config's default.
    gSession.target.stopAtMain = cmd.flag("stopAtMain", gSession.target.spec.stopAtMain)
    let _ok = startRun(cmd.bus, cmd.pendCh)
}

// continue, the three steps, and pause.
fn cmdStep(cmd: &Cmd): void {
    let pause = cmd.name == "pause"
    if !pause {
        gSession.stop.resume()
    }
    let Option.Some(dfd) = gSession.proc.dapIn else {
        return
    }
    let t = cmd.int("tid", 1 as i64)
    if pause && t < 0 {
        // Attach flow: Pause can arrive before any stop, so
        // there's no tid yet — ask for threads and pause the first.
        sendPending(cmd.pendCh, "thrPause", 0, "", "threads", "{}")
        return
    }
    var dapCmd = cmd.name.clone()
    if cmd.name == "stepOver" {
        dapCmd = "next"
    }
    var b = Json.obj().int("threadId", t)
    // instruction-granularity stepping from the asm pane.
    let gran = cmd.str("granularity")
    if gran.len > 0 {
        b = b.str("granularity", gran)
    }
    let seq = gSession.proc.nextSeq()
    sendReqFd(dfd, seq, dapCmd, b.build())
}

// Native restart: the adapter re-launches with the same launch config; the bps
// and the stop-at-main function bp persist. The UI gates this on
// supportsRestartRequest (kill+rerun is its fallback). A config change is a Run
// (force-kills), not a restart.
fn cmdRestart(cmd: &Cmd): void {
    gSession.stop.resume()
    sendPending(cmd.pendCh, "restartR", 0, "", "restart", "{}")
}

// End the session: the adapter tears down the debuggee and exits; the reader
// loop's terminated/EOF path re-arms `run`.
fn cmdKill(cmd: &Cmd): void {
    logEvent("kill requested", $"(by {cmd.peerKind} peer)")
    sendPending(cmd.pendCh, "disc", 0, "", "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    // The child session debugs the process; the PARENT is what spawned it.
    // Disconnecting only the child leaves the program running with nobody
    // attached, which reads in the UI as "killed" and is not.
    if let Option.Some(pfd) = gSession.proc.parentIn {
        sendReqFd(pfd, gSession.proc.oddSeq + 1, "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    }
}

fn cmdEvaluate(cmd: &Cmd): void {
    var b = Json.obj().str("expression", cmd.str("expr")).str("context", cmd.str("context"))
    let frameId = cmd.int("frameId", -1 as i64)
    if frameId >= 0 {
        b = b.int("frameId", frameId)
    }
    sendPending(cmd.pendCh, "eval", cmd.int("id", 0 as i64), "", "evaluate", b.build())
}

fn cmdExpand(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "expand", cmd.int("id", 0 as i64), "", "variables", Json.obj().int("variablesReference", cmd.int("ref", 0 as i64)).build())
}

// Stack for a clicked thread; the UI then drives frameScopes for its locals
// like any other frame selection.
fn cmdThreadStack(cmd: &Cmd): void {
    let t = cmd.int("tid", 1 as i64)
    sendPending(cmd.pendCh, "tst", cmd.int("id", 0 as i64), t.toString(), "stackTrace", Json.obj().int("threadId", t).int("startFrame", 0).int("levels", 20).build())
}

// Locals for a user-selected stack frame.
fn cmdFrameScopes(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "fsc", cmd.int("id", 0 as i64), "", "scopes", Json.obj().int("frameId", cmd.int("frameId", 0 as i64)).build())
}

// Selected exception filter ids. Kept on the target so session init applies
// them; live-applied when a session is running.
fn cmdSetExceptions(cmd: &Cmd): void {
    var arr = Json.arr()
    let f = cmd.doc.curField(cmd.doc.curRoot(), "filters")
    for i in 0..cmd.doc.curLen(f) {
        arr = arr.str(cmd.doc.curStr(cmd.doc.curChild(f, i)) ?? "")
    }
    gSession.target.excFilters = Option.Some(arr.build())
    sendPending(cmd.pendCh, "ebLive", 0, "", "setExceptionBreakpoints", excArgs())
}

// Debug-console completions.
fn cmdComplete(cmd: &Cmd): void {
    var b = Json.obj().str("text", cmd.str("text")).int("column", cmd.int("column", 1 as i64))
    let frameId = cmd.int("frameId", -1 as i64)
    if frameId >= 0 {
        b = b.int("frameId", frameId)
    }
    sendPending(cmd.pendCh, "cmpl", cmd.int("id", 0 as i64), "", "completions", b.build())
}

// Raw memory window. memoryReference is whatever the UI got from a
// value/ipRef; lldb-dap accepts plain hex addresses.
fn cmdReadMem(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "readmem", cmd.int("id", 0 as i64), "", "readMemory", Json.obj().str("memoryReference", cmd.str("memoryReference")).int("offset", cmd.int("offset", 0 as i64)).int("count", cmd.int("count", 256 as i64)).build())
}

// Edit a variable. ref = parent container (scope ref for top-level locals, the
// variable's own ref for expanded children).
fn cmdSetVar(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "setv", cmd.int("id", 0 as i64), "", "setVariable", Json.obj().int("variablesReference", cmd.int("ref", 0 as i64)).str("name", cmd.str("name")).str("value", cmd.str("value")).build())
}

// Window of instructions around a frame's pc (memoryReference = the frame's
// instructionPointerReference from stackTrace).
fn cmdDisassemble(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "disasm", cmd.int("id", 0 as i64), "", "disassemble", Json.obj().str("memoryReference", cmd.str("memoryReference")).int("instructionOffset", -16).int("instructionCount", 64).bool("resolveSymbols", true).build())
}

// Show the file a clicked frame lives in. sourceMsg itself handles unreadable
// pseudo-paths (dyld etc.) with a placeholder.
fn cmdOpenSource(cmd: &Cmd): void {
    let p = cmd.str("path")
    if p.len > 0 {
        wsPush(cmd.bus, sourceMsg(p))
    }
}

fn cmdStdin(cmd: &Cmd): void {
    let data = cmd.str("data")
    // writeOnce, not write: this runs on a peer's reader task, and parking
    // it until a debuggee that never reads stdin drains the pty would stall
    // every command that peer sends after it. A full pty drops input, as the
    // raw write here always did.
    if let Option.Some(p) = replace(gSession.proc.pty, Option.None) {
        let _n = p.writeOnce(data)
        gSession.proc.pty = Option.Some(p)
    } else {
        gSession.proc.stdinBuf = gSession.proc.stdinBuf + data
    }
}

fn cmdResize(cmd: &Cmd): void {
    let rows = cmd.int("rows", 0 as i64)
    let cols = cmd.int("cols", 0 as i64)
    // winsize fields are u16; anything outside is a bad payload, not a size.
    if rows <= 0 || cols <= 0 || rows >= 65536 || cols >= 65536 {
        return
    }
    gSession.proc.term = Option.Some(TermSize {
        rows: rows, cols: cols
    }
    )
    if let Option.Some(p) = replace(gSession.proc.pty, Option.None) {
        var pty = p
        let _r = pty.resize(rows as u16, cols as u16)
        gSession.proc.pty = Option.Some(pty)
    }
}

// config = a VS Code launch-configuration object (see applyConfig). The browser
// applies configs inline on Run; setConfig is the programmatic path (`dapweb
// api` callers). Idle-only: a live session must be force-run to change target
// (setConfig never kills a debuggee).
fn cmdSetConfig(cmd: &Cmd): void {
    if gSession.proc.started {
        wsPush(cmd.bus, configErrMsg("a debug session is active — stop it (or Run with force) to change the target"))
        return
    }
    let err = applyConfig(cmd.payload.clone(), "")
    if err.len > 0 {
        wsPush(cmd.bus, configErrMsg(err))
        return
    }
    logEvent("target changed", $"{gSession.target.spec.binPath}  (by {cmd.peerKind} peer)")
    loadBps()
    wsPush(cmd.bus, recordConfig())
    pushHelloState(cmd.bus)
}

// One-shot localStorage migration: fold the client's legacy entries into the
// server store, then the client stops sending (server is the sole writer
// thereafter). Idempotent: dedup collapses re-imports.
fn cmdImportHistory(cmd: &Cmd): void {
    if let Option.Some(e) = cmd.doc.get("entries") {
        if e.isArray() {
            gSession.persisted.history = histMergeMany(gSession.persisted.history, e.rawStr(), 10 as i64)
            persistHistory()
            wsPush(cmd.bus, historyChangedMsg())
        }
    }
}

// Deliberate fresh start (a reload reconnects to the live session by design):
// end any running debuggee via the kill path, drop bps and the late-join replay
// snapshots, mint a new id, and re-hello every peer; each resets its client
// state on the id change. Target config survives; the ⚙ drawer changes it.
fn cmdNewSession(cmd: &Cmd): void {
    sendPending(cmd.pendCh, "disc", 0, "", "disconnect", Json.obj().bool("terminateDebuggee", true).build())
    gSession.persisted.bps = []
    persistBps()
    gSession.stop.resume()
    gSession.output = []
    gSession.server.sessionId = newSessionName(sessionNameSeeds())
    journalHere()
    logEvent("session reset", $"new session {gSession.server.sessionId}")
    pushHelloState(cmd.bus)
}

// The refusal an unknown command gets. It names the vocabulary rather than just
// saying no, because the caller that sent a typo is usually a script that cannot
// go and read the source.
fn unknownCmdJson(c: &string): string {
    var what = c.clone()
    if what.len == 0 {
        what = "(missing \"cmd\")"
    }
    return Json.obj().bool("ok", false)
        .str("error", $"unknown command {what} — known commands: {cmdNames()}. Run `dapweb api spec` for what each one takes.")
        .build()
}

// Run one command and, when `awaitType` is set, block until a broadcast of that
// type arrives (or the deadline passes). Registering as a Sink first means no
// reply can slip through between dispatch and listening.
pub fn apiRunCmd(body: string, awaitType: string, timeoutMs: i64, who: string, bus: &Channel<string>, pendCh: &Channel<Pending>): string {
    // An agent driving the session IS activity: without this an --idle-ttl server
    // reaps the debuggee out from under a caller that has no WS peer holding it.
    gSession.peers.lastActivityMs = epochMillis()
    if awaitType.len == 0 {
        if let Option.Some(bad) = dispatchClientCmd(body, "api", who, bus, pendCh) {
            return unknownCmdJson(bad)
        }
        return Json.obj().bool("ok", true).build()
    }
    let ch = Channel<Shared>.new(256)!
    let clientId = gSession.peers.nextClient
    gSession.peers.nextClient = gSession.peers.nextClient + 1
    sinkRegister(clientId, ch)
    if let Option.Some(bad) = dispatchClientCmd(body, "api", who, bus, pendCh) {
        sinkUnregister(clientId)
        return unknownCmdJson(bad)
    }

    let deadline = epochMillis() + timeoutMs
    var out: string = ""
    while epochMillis() < deadline {
        match ch.tryRecv() {
            Option.Some(sm) => {
                let m = sharedWith(sm, (s: &Sealed): string => s.text(s.span()))
                let Result.Ok(d) = Json.parse(m) else {
                    continue
                }
                let mt = d.str("type") ?? ""
                if mt == awaitType {
                    out = m
                    break
                }
                // A rejected command never produces the awaited reply, so return
                // the refusal rather than burning the caller's whole timeout and
                // then reporting a useless {"error":"timeout"}.
                if mt == "configError" {
                    out = Json.obj().bool("ok", false).str("error", d.str("error") ?? "").build()
                    break
                }
            }
            Option.None => {
                sleepMs(10)
            }
        }
    }
    sinkUnregister(clientId)
    if out.len == 0 {
        return Json.obj().bool("ok", false).str("error", "timeout").str("awaited", awaitType).build()
    }
    return out
}

// ── R: the WS-reader task (entry point per debug WebSocket) ──

pub fn handleDebugWs(ws: WsConn, peerKind: string, bus: &Channel<string>, pendCh: &Channel<Pending>): void {
    var conn = ws

    let ch = Channel<Shared>.new(256)!
    let wfd = conn.fd
    // Channel handles are refcounted and @send: the writer task outlives this
    // frame, so it gets its own retained handle (as does the registry's Sink).
    let writerCh = ch.clone()
    let writer = Task.spawn(move(): void => {
        wsWriterLoop(wfd, writerCh)
    }
    )

    // join the shared session. Register with the broadcaster, then replay
    // current state directly onto our own sink — no yield point in between,
    // so the replay is ordered before any subsequent broadcast fanout.
    let clientId = gSession.peers.nextClient
    gSession.peers.nextClient = gSession.peers.nextClient + 1
    sinkRegister(clientId, ch)
    gSession.peers.count = gSession.peers.count + 1
    logEvent("peer connected", $"{peerKind}  {peerCountStr()}")

    for m in gSession.snapshot() {
        peerPush(ch, m.clone())
    }

    while true {
        var payload: string = ""
        match conn.recv() {
            Result.Ok(m) => {
                payload = m.payload
            }
            Result.Err(_e) => {
                break
            }
        }

        if let Option.Some(bad) = dispatchClientCmd(payload, peerKind.clone(), peerKind.clone(), bus, pendCh) {
            wsPush(bus, configErrMsg($"unknown command {bad}"))
        }
    }

    // Leave the shared session; sinkUnregister closes our channel, which ends
    // the writer. Wait for it to exit before `conn` drops and closes the socket.
    sinkUnregister(clientId)
    writer.join()
    gSession.peers.count = gSession.peers.count - 1
    gSession.peers.lastActivityMs = epochMillis()
    logEvent("peer disconnected", $"{peerKind}  {peerCountStr()}")
}
